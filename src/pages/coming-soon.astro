---
// src/pages/coming-soon.astro

import Layout from "../layouts/PublicLayout.astro";

import {
  CalendarDays,
  Clock3,
  TimerReset,
  Sparkles,
  MessageCircle,
} from "lucide-react";

import { FaInstagram } from "react-icons/fa";
---

<Layout
  title="AVYNA Saltillo | Próximamente"
  description="Nueva experiencia digital AVYNA próximamente."
  image="/images/seo/og-home.jpg"
  url="https://avynasaltillo.beauty/coming-soon"
>
  <main
    class="relative flex justify-center items-center bg-black min-h-screen overflow-hidden text-white"
  >
    <!-- BACKGROUND -->
    <div class="absolute inset-0 overflow-hidden">
      <!-- top glow -->
      <div
        class="top-[-18rem] left-1/2 absolute bg-white/[0.06] blur-3xl rounded-full w-[40rem] h-[40rem] -translate-x-1/2"
      >
      </div>

      <!-- left glow -->
      <div
        class="top-1/3 left-[-10rem] absolute bg-white/[0.03] blur-3xl rounded-full w-[26rem] h-[26rem]"
      >
      </div>

      <!-- right glow -->
      <div
        class="right-[-8rem] bottom-[-10rem] absolute bg-zinc-300/[0.03] blur-3xl rounded-full w-[24rem] h-[24rem]"
      >
      </div>

      <!-- noise -->
      <div
        class="absolute inset-0 bg-[url('/images/noise.png')] opacity-[0.018] mix-blend-screen"
      >
      </div>

      <!-- vignette -->
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_20%,rgba(0,0,0,.65))]"
      >
      </div>
    </div>

    <!-- CONTENT -->
    <section
      class="z-10 relative flex flex-col items-center mx-auto px-5 sm:px-6 py-6 sm:py-10 w-full max-w-7xl text-center"
    >
      <!-- LOGO -->
      <div class="flex justify-center items-center mb-8 sm:mb-10">
        <img
          src="/images/logo-avyna-white.png"
          alt="AVYNA"
          class="w-auto h-6 sm:h-8 md:h-10 object-contain"
        />
      </div>

      <!-- LABEL -->
      <div
        class="inline-flex items-center gap-2 bg-white/[0.03] backdrop-blur-xl px-3 sm:px-4 py-1.5 sm:py-2 border border-white/10 rounded-full"
      >
        <Sparkles size={13} className="text-white/55 shrink-0" />

        <p
          class="text-[10px] text-white/40 sm:text-[11px] uppercase tracking-[0.24em] sm:tracking-[0.38em]"
        >
          Nueva experiencia digital
        </p>
      </div>

      <!-- TITLE -->
      <h1
        class="mt-4 sm:mt-5 px-4 w-full max-w-[1700px] font-normal text-[3rem] lg:text-[5rem] sm:text-4xl md:text-5xl leading-[0.92] sm:leading-[0.88] tracking-[-0.095em]"
        style="
    font-family:
      'Clash Display',
      'Satoshi',
      sans-serif;
  "
      >
        La nueva era de AVYNA
        <br />
        está por comenzar
      </h1>

      <!-- TEXT -->
      <p
        class="mx-auto mt-7 sm:mt-8 max-w-2xl text-[0.98rem] text-white/58 sm:text-[1rem] md:text-[1.08rem] leading-[1.75] sm:leading-[1.9]"
        style="
          font-family:
            'Satoshi',
            'Plus Jakarta Sans',
            sans-serif;
        "
      >
        Estamos preparando una experiencia premium para clientes, salones y
        profesionales AVYNA en Saltillo.
      </p>

      <!-- COUNTDOWN -->
      <div
        class="gap-4 sm:gap-5 grid grid-cols-2 sm:grid-cols-4 mt-7 sm:mt-8 w-full max-w-4xl"
      >
        <!-- DAYS -->
        <div
          class="group relative bg-white/[0.03] hover:bg-white/[0.05] backdrop-blur-2xl p-4 sm:p-5 border border-white/10 hover:border-white/20 rounded-[1.8rem] overflow-hidden transition-all duration-500"
        >
          <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,.08),transparent_55%)] opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>

          <div class="z-10 relative">
            <CalendarDays
              size={17}
              className="mx-auto mb-3 sm:mb-4 text-white/45"
            />

            <div
              id="days"
              class="font-normal text-[3.2rem] sm:text-4xl md:text-5xl"
              style="
                font-family:
                  'Clash Display',
                  sans-serif;
              "
            >
              00
            </div>

            <p
              class="mt-2 text-[10px] text-white/35 sm:text-[11px] uppercase tracking-[0.24em] sm:tracking-[0.28em]"
            >
              Días
            </p>
          </div>
        </div>

        <!-- HOURS -->
        <div
          class="group relative bg-white/[0.03] hover:bg-white/[0.05] backdrop-blur-2xl p-4 sm:p-5 border border-white/10 hover:border-white/20 rounded-[1.8rem] overflow-hidden transition-all duration-500"
        >
          <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,.08),transparent_55%)] opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>

          <div class="z-10 relative">
            <Clock3 size={17} className="mx-auto mb-3 sm:mb-4 text-white/45" />

            <div
              id="hours"
              class="font-normal text-[3.2rem] sm:text-4xl md:text-5xl"
              style="
                font-family:
                  'Clash Display',
                  sans-serif;
              "
            >
              00
            </div>

            <p
              class="mt-2 text-[10px] text-white/35 sm:text-[11px] uppercase tracking-[0.24em] sm:tracking-[0.28em]"
            >
              Horas
            </p>
          </div>
        </div>

        <!-- MINUTES -->
        <div
          class="group relative bg-white/[0.03] hover:bg-white/[0.05] backdrop-blur-2xl p-4 sm:p-5 border border-white/10 hover:border-white/20 rounded-[1.8rem] overflow-hidden transition-all duration-500"
        >
          <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,.08),transparent_55%)] opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>

          <div class="z-10 relative">
            <TimerReset
              size={17}
              className="mx-auto mb-3 sm:mb-4 text-white/45"
            />

            <div
              id="minutes"
              class="font-normal text-[3.2rem] sm:text-4xl md:text-5xl"
              style="
                font-family:
                  'Clash Display',
                  sans-serif;
              "
            >
              00
            </div>

            <p
              class="mt-2 text-[10px] text-white/35 sm:text-[11px] uppercase tracking-[0.24em] sm:tracking-[0.28em]"
            >
              Minutos
            </p>
          </div>
        </div>

        <!-- SECONDS -->
        <div
          class="group relative bg-white/[0.03] hover:bg-white/[0.05] backdrop-blur-2xl p-4 sm:p-5 border border-white/10 hover:border-white/20 rounded-[1.8rem] overflow-hidden transition-all duration-500"
        >
          <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,.08),transparent_55%)] opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>

          <div class="z-10 relative">
            <Sparkles
              size={17}
              className="mx-auto mb-3 sm:mb-4 text-white/45"
            />

            <div
              id="seconds"
              class="font-normal text-[3.2rem] sm:text-4xl md:text-5xl"
              style="
                font-family:
                  'Clash Display',
                  sans-serif;
              "
            >
              00
            </div>

            <p
              class="mt-2 text-[10px] text-white/35 sm:text-[11px] uppercase tracking-[0.24em] sm:tracking-[0.28em]"
            >
              Segundos
            </p>
          </div>
        </div>
      </div>

      <!-- BUTTONS -->
      <div
        class="flex sm:flex-row flex-col gap-4 mt-5 sm:mt-7 w-full sm:w-auto"
      >
        <!-- WHATSAPP -->
        <button
          id="notifyBtn"
          type="button"
          class="inline-flex justify-center items-center gap-3 bg-white hover:bg-white/95 px-8 rounded-2xl h-13 sm:h-14 font-semibold text-black hover:scale-[1.03] active:scale-[0.98] transition-all duration-300"
        >
          <MessageCircle size={18} />

          Notificarme
        </button>

        <!-- INSTAGRAM -->
        <a
          href="https://instagram.com/avynasaltillo"
          target="_blank"
          class="inline-flex justify-center items-center gap-3 bg-white/[0.03] hover:bg-white/[0.06] backdrop-blur-xl px-8 border border-white/10 hover:border-white/20 rounded-2xl h-13 sm:h-14 font-medium text-white transition-all duration-300"
        >
          <FaInstagram size={18} />

          Instagram
        </a>
      </div>

      <!-- FOOT -->
      <div
        class="flex items-center gap-3 mt-5 sm:mt-8 text-[10px] text-white/28 sm:text-[12px] uppercase tracking-[0.22em] sm:tracking-[0.25em]"
      >
        <span class="bg-white/10 w-8 sm:w-10 h-[1px]"></span>

        Saltillo · México

        <span class="bg-white/10 w-8 sm:w-10 h-[1px]"></span>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  // =======================
  // WHATSAPP
  // =======================

  document.getElementById("notifyBtn")?.addEventListener("click", () => {
    const phone = "528445399548";

    const message =
      "Hola AVYNA, me gustaría recibir notificación cuando lancen la nueva experiencia digital.";

    const encoded = encodeURIComponent(message);

    const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);

    const url = isMobile
      ? `whatsapp://send?phone=${phone}&text=${encoded}`
      : `https://web.whatsapp.com/send?phone=${phone}&text=${encoded}`;

    window.open(url, "_blank");
  });

  // =======================
  // COUNTDOWN
  // =======================

  const targetDate = new Date("2026-06-01T09:00:00").getTime();

  function updateCountdown() {
    const now = new Date().getTime();

    const distance = targetDate - now;

    if (distance <= 0) {
      document.getElementById("days").textContent = "00";
      document.getElementById("hours").textContent = "00";
      document.getElementById("minutes").textContent = "00";
      document.getElementById("seconds").textContent = "00";

      return;
    }

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));

    const hours = Math.floor(
      (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
    );

    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));

    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    document.getElementById("days").textContent = String(days).padStart(2, "0");

    document.getElementById("hours").textContent = String(hours).padStart(
      2,
      "0",
    );

    document.getElementById("minutes").textContent = String(minutes).padStart(
      2,
      "0",
    );

    document.getElementById("seconds").textContent = String(seconds).padStart(
      2,
      "0",
    );
  }

  updateCountdown();

  setInterval(updateCountdown, 1000);
</script>
