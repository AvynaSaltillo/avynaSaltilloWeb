---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Semanas">

  <section class="space-y-8">

    <!-- HERO -->
    <section
      class="
        relative overflow-hidden

        rounded-4xl

        border border-white/10

        bg-gradient-to-br
        from-zinc-900
        via-black
        to-zinc-950

        p-8
      "
    >

      <div
        class="
          absolute -left-20 top-0

          h-72 w-72

          rounded-full

          bg-white/3

          blur-3xl
        "
      ></div>

      <div
        class="
          absolute right-0 top-0

          h-80 w-80

          rounded-full

          bg-white/2

          blur-3xl
        "
      ></div>

      <div
        class="
          relative z-10

          flex flex-col gap-6

          xl:flex-row
          xl:items-end
          xl:justify-between
        "
      >

        <div>

          <p
            class="
              text-xs

              uppercase

              tracking-[0.45em]

              text-white/30
            "
          >
            Pedidos agrupados
          </p>

          <h1
            class="
              mt-4

              text-4xl

              font-semibold

              tracking-tight

              sm:text-5xl
            "
          >
            Semanas
          </h1>

          <p
            class="
              mt-4

              max-w-2xl

              text-sm

              text-white/55
            "
          >
            Visualiza pedidos organizados por semana.
          </p>

        </div>

      </div>

    </section>

    <!-- WEEKS -->
    <section class="space-y-6">

      <!-- TOP BAR -->
      <div
        class="
          flex flex-col gap-4

          lg:flex-row
          lg:items-center
          lg:justify-between
        "
      >

        <!-- SEARCH -->
        <div class="relative w-full max-w-md">

          <input
            id="searchCycles"
            type="text"
            placeholder="Buscar semana..."
            class="
              h-14 w-full

              rounded-2xl

              border border-white/10

              bg-white/4

              pl-5 pr-5

              text-sm text-white

              outline-none

              transition

              focus:border-white/20
            "
          />

        </div>

        <!-- PER PAGE -->
        <div class="flex items-center gap-3">

          <select
            id="perPage"
            class="
              h-14

              rounded-2xl

              border border-white/10

              bg-white/4

              px-5

              text-sm text-white
            "
          >

            <option value="4">
              4
            </option>

            <option value="8">
              8
            </option>

            <option value="12">
              12
            </option>

            <option value="16">
              16
            </option>

            <option value="20">
              20
            </option>

            <option value="30">
              30
            </option>

          </select>

        </div>

      </div>

      <!-- GRID -->
      <div
        id="cyclesTable"
        class="
          grid gap-5

          md:grid-cols-2
          xl:grid-cols-4
        "
      >

        <div
          class="
            rounded-4xl

            border border-white/10

            bg-white/4

            p-6
          "
        >
          Cargando semanas...
        </div>

      </div>

      <!-- PAGINATION -->
      <div
        id="pagination"
        class="
          flex items-center justify-center gap-2
        "
      ></div>

    </section>

  </section>

  <script src="/src/scripts/admin-cycles.ts"></script>

</AdminLayout>