---
// src/pages/admin/order/[week].astro

import AdminLayout from "../../../layouts/AdminLayout.astro";

import {
  RiArrowLeftLine,
  RiWhatsappLine,
  RiMoneyDollarCircleLine,
  RiTruckLine,
  RiCheckLine,
  RiCloseCircleLine,
  RiTimeLine,
  RiShoppingBag3Line,
  RiBox3Line,
  RiRoadMapLine
} from "react-icons/ri";

const { id } = Astro.params;
---

<AdminLayout title="Detalle pedido">

<section class="space-y-6">

  <!-- HERO -->
  <section class="relative overflow-hidden rounded-[2.5rem] border border-white/10 bg-gradient-to-br from-zinc-900 via-black to-zinc-950 p-6 sm:p-8">

    <!-- GLOWS -->
    <div class="absolute -left-20 top-0 h-72 w-72 rounded-full bg-white/[0.03] blur-3xl"></div>

    <div class="absolute right-0 top-0 h-80 w-80 rounded-full bg-white/[0.02] blur-3xl"></div>

    <div class="relative z-10 flex flex-col gap-7 2xl:flex-row 2xl:items-end 2xl:justify-between">

      <!-- LEFT -->
      <div class="min-w-0">

        <a
          href="/admin/orders"
          class="inline-flex items-center gap-2 text-sm text-white/45 transition hover:text-white"
        >

          <RiArrowLeftLine size={18}/>

          Volver

        </a>

        <p class="mt-5 text-[11px] uppercase tracking-[0.38em] text-white/25">
          Order Detail
        </p>

        <h1
          id="orderTitle"
          class="mt-4 break-all text-3xl font-semibold tracking-tight sm:text-5xl"
        >
          #...
        </h1>

        <p
          id="orderDate"
          class="mt-4 text-sm text-white/45"
        >
          —
        </p>

      </div>

<!-- MOBILE STATUS -->
<div class="block xl:hidden">

  <button
    id="mobileStatusTrigger"
    class="
      flex h-14 w-full items-center justify-between gap-4

      rounded-2xl

      border border-white/10

      bg-white/[0.04]

      px-5

      backdrop-blur-xl
    "
  >

    <div class="flex items-center gap-3">

      <div
        id="mobileStatusDot"
        class="h-3 w-3 rounded-full bg-cyan-400"
      ></div>

      <span
        id="mobileStatusLabel"
        class="text-sm font-medium text-white"
      >
        Esperando proveedor
      </span>

    </div>

    <svg
      id="mobileStatusArrow"
      xmlns="http://www.w3.org/2000/svg"
      class="h-5 w-5 text-white/45 transition"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 9l-7 7-7-7"
      />
    </svg>

  </button>

  <div
    id="mobileStatusDropdown"
    class="
      mt-3 hidden

      space-y-2

      rounded-[1.75rem]

      border border-white/10

      bg-zinc-950/95

      p-3

      backdrop-blur-2xl
    "
  >

<button
  data-status="waiting_supplier"
  class="
    status-btn
    mobile-status-btn
  "
>

      <RiTimeLine size={18}/>

      Esperando proveedor

    </button>

    <button
      data-status="ordered_supplier"
      class="status-btn mobile-status-btn"
    >

      <RiShoppingBag3Line size={18}/>

      Pedido realizado

    </button>

    <button
      data-status="ready_delivery"
      class="status-btn mobile-status-btn"
    >

      <RiBox3Line size={18}/>

      Pedido listo

    </button>

    <button
      data-status="on_route"
      class="status-btn mobile-status-btn"
    >

      <RiTruckLine size={18}/>

      En ruta

    </button>

    <button
      data-status="delivered"
      class="status-btn mobile-status-btn"
    >

      <RiCheckLine size={18}/>

      Entregado

    </button>

    <button
      data-status="cancelled"
      class="
        status-btn
        mobile-status-btn
      "
    >

      <RiCloseCircleLine size={18}/>

      Cancelado

    </button>

  </div>

</div>

<!-- DESKTOP ACTIONS -->
<div
  id="statusActions"
  class="
    hidden flex-wrap gap-3

    xl:flex
  "
>

<button
  data-status="waiting_supplier"
  class="status-btn"
>

    <RiTimeLine size={18}/>

    Esperando proveedor

  </button>

  <button
    data-status="ordered_supplier"
    class="status-btn"
  >

    <RiShoppingBag3Line size={18}/>

    Pedido realizado

  </button>

  <button
    data-status="ready_delivery"
    class="status-btn"
  >

    <RiBox3Line size={18}/>

    Pedido listo

  </button>

  <button
    data-status="on_route"
    class="status-btn"
  >

    <RiTruckLine size={18}/>

    En ruta

  </button>

  <button
    data-status="delivered"
    class="status-btn"
  >

    <RiCheckLine size={18}/>

    Entregado

  </button>

  <button
    data-status="cancelled"
    class="status-btn"
  >

    <RiCloseCircleLine size={18}/>

    Cancelado

  </button>

  <button
    id="registerPayment"
    class="
      inline-flex h-12 items-center justify-center gap-2

      rounded-2xl

      bg-white

      px-5

      text-sm font-semibold text-black

      transition hover:scale-[1.02]
    "
  >

    <RiMoneyDollarCircleLine size={18}/>

    Registrar pago

  </button>

</div>

    </div>

  </section>

  <!-- GRID -->
  <section
  class="
    grid gap-6

    xl:grid-cols-[minmax(0,1fr)_420px]
  "
>

    <!-- LEFT -->
    <div class="space-y-6">

      <!-- CLIENT -->
      <section class="rounded-[2rem] border border-white/10 bg-white/[0.04] p-6 sm:p-7">

        <div class="flex items-start justify-between gap-4">

          <div>

            <p class="text-[11px] uppercase tracking-[0.35em] text-white/35">
              Cliente
            </p>

            <h2
              id="clientName"
              class="mt-4 text-2xl font-semibold"
            >
              —
            </h2>

            <p
              id="businessName"
              class="mt-2 text-sm text-white/45"
            >
              —
            </p>

          </div>

          <a
            id="whatsappBtn"
            target="_blank"
            class="inline-flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.03] text-white/70 transition hover:bg-white/[0.08] hover:text-white"
          >

            <RiWhatsappLine size={22}/>

          </a>

        </div>

        <!-- GRID -->
        <div class="mt-8 grid gap-5 sm:grid-cols-2">

          <div class="rounded-2xl border border-white/10 bg-black/30 p-5">

            <p class="text-xs text-white/40">
              Tipo pago
            </p>

            <p
              id="paymentType"
              class="mt-2 text-lg font-semibold"
            >
              —
            </p>

          </div>

          <div class="rounded-2xl border border-white/10 bg-black/30 p-5">

            <p class="text-xs text-white/40">
              Estado pago
            </p>

            <div
              id="paymentStatus"
              class="mt-2"
            >
              —
            </div>

          </div>

        </div>

      </section>

      <!-- ITEMS -->
      <section class="overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.04]">

        <div class="border-b border-white/10 px-6 py-5">

          <div class="flex items-center justify-between gap-4">

            <div>

              <p class="text-[11px] uppercase tracking-[0.35em] text-white/35">
                Productos
              </p>

              <p class="mt-2 text-sm text-white/40">
                Productos incluidos en el pedido
              </p>

            </div>

            <div
              id="itemsCount"
              class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs text-white/55"
            >
              0 items
            </div>

          </div>

        </div>

        <div
          id="itemsContainer"
          class="divide-y divide-white/5"
        >

          <div class="p-8 text-sm text-white/45">
            Cargando productos...
          </div>

        </div>

      </section>

<!-- TIMELINE -->
<section
  class="
    overflow-hidden

    rounded-[2rem]

    border border-white/10

    bg-white/[0.04]
  "
>

  <!-- HEADER -->
  <div
    class="
      flex items-center justify-between

      border-b border-white/10

      px-6 py-5
    "
  >

    <div>

      <p class="text-[11px] uppercase tracking-[0.35em] text-white/35">
        Timeline
      </p>

      <p class="mt-2 text-sm text-white/40">
        Últimos movimientos del pedido
      </p>

    </div>

  </div>

  <!-- BODY -->
  <div
    id="timelineContainer"
    class="
      max-h-[340px]

      space-y-5

      overflow-y-auto

      p-6
    "
  >

    <div class="text-sm text-white/45">
      Cargando timeline...
    </div>

  </div>

</section>

    </div>

    <!-- RIGHT -->
    <div class="space-y-6">

      <!-- TOTALS -->
      <section class="rounded-[2rem] border border-white/10 bg-white/[0.04] p-7">

        <p class="text-[11px] uppercase tracking-[0.35em] text-white/35">
          Totales
        </p>

        <div class="mt-7 space-y-5">

          <div class="flex items-center justify-between text-sm text-white/45">

            <span>
              Subtotal
            </span>

            <span id="subtotal">
              —
            </span>

          </div>

          <div class="flex items-center justify-between text-sm text-white/45">

            <span>
              Pagado
            </span>

            <span
              id="amountPaid"
              class="text-emerald-300"
            >
              —
            </span>

          </div>

          <div class="flex items-center justify-between text-sm text-white/45">

            <span>
              Pendiente
            </span>

            <span
              id="amountDue"
              class="text-yellow-300"
            >
              —
            </span>

          </div>

          <div class="border-t border-white/10 pt-5">

            <div class="flex items-end justify-between gap-4">

              <div>

                <p class="text-xs text-white/40">
                  Total pedido
                </p>

                <p
                  id="orderTotal"
                  class="mt-2 text-4xl font-semibold tracking-tight"
                >
                  —
                </p>

              </div>

              <div
                id="deliveryStatus"
              >
                —
              </div>

            </div>

          </div>

        </div>

      </section>

      <!-- ADDRESS -->
      <section class="rounded-[2rem] border border-white/10 bg-white/[0.04] p-7">

        <p class="text-[11px] uppercase tracking-[0.35em] text-white/35">
          Dirección
        </p>

        <div class="mt-7 space-y-4 text-sm text-white/75">

          <p id="addressLine">
            —
          </p>

          <p id="colony">
            —
          </p>

          <p id="cityState">
            —
          </p>

        </div>

      </section>

<!-- PAYMENTS -->
<section
  class="
    overflow-hidden

    rounded-[2rem]

    border border-white/10

    bg-white/[0.04]
  "
>

  <!-- HEADER -->
  <div
    class="
      flex items-center justify-between gap-4

      border-b border-white/10

      px-6 py-5
    "
  >

    <div>

      <p class="text-[11px] uppercase tracking-[0.35em] text-white/35">
        Pagos registrados
      </p>

      <p class="mt-2 text-sm text-white/40">
        Historial financiero del pedido
      </p>

    </div>

    <button
      id="registerPaymentCard"
      class="
        hidden h-11 items-center justify-center gap-2

        rounded-2xl

        bg-white

        px-5

        text-sm font-semibold text-black

        transition hover:scale-[1.02]

        sm:inline-flex
      "
    >

      <RiMoneyDollarCircleLine size={18}/>

      Registrar

    </button>

  </div>

  <!-- BODY -->
  <div
    id="paymentsContainer"
    class="
      max-h-[420px]

      overflow-y-auto

      p-4
    "
  >

    <div class="text-sm text-white/45">
      Cargando pagos...
    </div>

  </div>

</section>

      <!-- NOTES -->
      <section class="rounded-[2rem] border border-white/10 bg-white/[0.04] p-7">

        <div class="flex items-center justify-between gap-4">

          <div>

            <p class="text-[11px] uppercase tracking-[0.35em] text-white/35">
              Notas internas
            </p>

            <p class="mt-2 text-sm text-white/40">
              Solo visible para admins
            </p>

          </div>

        </div>

        <textarea
          id="adminNotes"
          rows="6"
          placeholder="Agregar notas internas..."
          class="mt-6 w-full rounded-2xl border border-white/10 bg-black/30 p-4 text-sm outline-none transition focus:border-white/20"
        ></textarea>

        <button
          id="saveNotes"
          class="relative z-10 mt-4 inline-flex h-11 items-center justify-center rounded-2xl bg-white px-5 text-sm font-semibold text-black transition hover:scale-[1.02]"
        >
          Guardar notas
        </button>

      </section>

    </div>

  </section>

</section>

<script define:vars={{ id }}>
  window.__ORDER_ID__ = id;
</script>

<script
  src="/src/scripts/admin-order-detail.ts"
></script>

</AdminLayout>

<!-- PAYMENT MODAL -->
<div
  id="paymentModal"
  class="
  pointer-events-none

  fixed inset-0 z-[9999]

  hidden
"
>

  <!-- OVERLAY -->
  <div
    id="paymentOverlay"
    class="absolute inset-0 bg-black/70 backdrop-blur-md"
  ></div>

  <!-- WRAPPER -->
  <div
    class="
      relative z-10

      flex min-h-screen

      items-end justify-center

      overflow-y-auto

      p-0

      sm:items-center
      sm:p-4
    "
  >

    <!-- CARD -->
    <div
      id="paymentCard"
      class="
        w-full

        max-h-[92vh]
        overflow-y-auto

        rounded-t-[2.5rem]

        border border-white/10

        bg-zinc-950

        p-6

        shadow-[0_0_80px_rgba(0,0,0,0.8)]

        sm:max-w-lg
        sm:rounded-[2rem]
      "
    >

      <!-- HEADER -->
      <div class="flex items-start justify-between gap-4">

        <div>

          <p class="text-[11px] uppercase tracking-[0.35em] text-white/35">
            Registrar pago
          </p>

          <h3 class="mt-3 text-2xl font-semibold">
            Nuevo pago
          </h3>

        </div>

        <button
          id="closePaymentModal"
          class="
            h-11 w-11 rounded-2xl

            border border-white/10

            text-white/60

            transition

            hover:bg-white/10
            hover:text-white
          "
        >
          ✕
        </button>

      </div>

      <!-- FORM -->
      <div class="mt-8 space-y-5 pb-24">

        <!-- AMOUNT -->
        <div>

          <label class="mb-2 block text-sm text-white/55">
            Monto
          </label>

          <input
            id="paymentAmount"
            type="number"
            placeholder="Saldo pendiente"
            class="
              h-14 w-full rounded-2xl

              border border-white/10

              bg-black/40

              px-4

              text-sm

              outline-none

              transition

              focus:border-white/20
            "
          />

        </div>

        <!-- METHOD -->
        <div>

          <label class="mb-2 block text-sm text-white/55">
            Método
          </label>

          <select
            id="paymentMethod"
            class="
              h-14 w-full rounded-2xl

              border border-white/10

              bg-black/40

              px-4

              text-sm

              outline-none

              transition

              focus:border-white/20
            "
          >

            <option value="transfer">
              Transferencia
            </option>

            <option value="cash">
              Efectivo
            </option>

            <option value="card">
              Tarjeta
            </option>

          </select>

        </div>

        <!-- REFERENCE -->
        <div>

          <label class="mb-2 block text-sm text-white/55">
            Referencia
          </label>

          <input
            id="paymentReference"
            type="text"
            placeholder="Folio / referencia"
            class="
              h-14 w-full rounded-2xl

              border border-white/10

              bg-black/40

              px-4

              text-sm

              outline-none

              transition

              focus:border-white/20
            "
          />

        </div>

        <!-- NOTES -->
        <div>

          <label class="mb-2 block text-sm text-white/55">
            Notas
          </label>

          <textarea
            id="paymentNotes"
            rows="4"
            placeholder="Notas internas..."
            class="
              w-full rounded-2xl

              border border-white/10

              bg-black/40

              p-4

              text-sm

              outline-none

              transition

              focus:border-white/20
            "
          ></textarea>

        </div>

      </div>

      <!-- ACTIONS -->
      <div
        class="
          sticky bottom-0

          -mx-6
          mt-2

          flex gap-3

          border-t border-white/10

          bg-gradient-to-t
          from-zinc-950
          via-zinc-950
          to-transparent

          px-6
          pt-5
          pb-1
        "
      >

        <button
          id="cancelPaymentBtn"
          class="
            h-12 flex-1 rounded-2xl

            border border-white/10

            text-sm text-white/70

            transition

            hover:bg-white/10
            hover:text-white
          "
        >
          Cancelar
        </button>

        <button
          id="submitPaymentBtn"
          class="
            h-12 flex-1 rounded-2xl

            bg-white

            text-sm font-semibold text-black

            transition

            hover:scale-[1.02]
          "
        >
          Registrar pago
        </button>

      </div>

    </div>

  </div>

</div>

<!-- STATUS MODAL -->
<div
  id="statusModal"
  class="fixed inset-0 z-[99999] hidden"
>

  <!-- OVERLAY -->
  <div
    id="statusOverlay"
    class="absolute inset-0 bg-black/70 backdrop-blur-md"
  ></div>

  <!-- CARD -->
  <div class="relative z-10 flex min-h-screen items-center justify-center p-4">

    <div
      class="
        w-full max-w-md

        rounded-[2rem]

        border border-white/10

        bg-zinc-950

        p-7
      "
    >

      <p class="text-[11px] uppercase tracking-[0.35em] text-white/35">
        Confirmar cambio
      </p>

      <h3
        id="statusModalTitle"
        class="mt-4 text-2xl font-semibold"
      >
        —
      </h3>

      <p class="mt-3 text-sm text-white/45">
        Esto actualizará el flujo operativo del pedido.
      </p>

      <div class="mt-8 flex gap-3">

        <button
          id="cancelStatusBtn"
          class="
            flex-1 h-12 rounded-2xl

            border border-white/10

            text-sm text-white/70

            transition hover:bg-white/10
          "
        >
          Cancelar
        </button>

        <button
          id="confirmStatusBtn"
          class="
            flex-1 h-12 rounded-2xl

            bg-white

            text-sm font-semibold text-black

            transition hover:scale-[1.02]
          "
        >
          Confirmar
        </button>

      </div>

    </div>

  </div>

</div>

<style is:global>

#statusActions{

  width:100%;

  overflow-x:auto;

  padding-bottom:4px;

  scrollbar-width:none;

}

#statusActions::-webkit-scrollbar{
  display:none;
}

.status-btn{

  position:relative;

  overflow:hidden;

  display:inline-flex;
  align-items:center;
  justify-content:center;

  flex-shrink:0;

  height:48px;

  padding:0 20px;

  border-radius:18px;

  border:1px solid rgba(255,255,255,.08);

  background:rgba(255,255,255,.03);

  backdrop-filter:blur(20px);

  color:rgba(255,255,255,.72);

  font-size:14px;
  font-weight:500;

  white-space:nowrap;

  transition:
    background .25s ease,
    border-color .25s ease,
    color .25s ease,
    transform .25s ease,
    opacity .25s ease,
    box-shadow .25s ease;

    gap:10px;

}

.status-btn::before{

  content:"";

  position:absolute;

  inset:0;

  background:
    radial-gradient(
      circle at top,
      rgba(255,255,255,.12),
      transparent 70%
    );

  opacity:0;

  transition:.25s ease;

}

.status-btn:hover{

  border-color:rgba(255,255,255,.14);

  background:rgba(255,255,255,.06);

  color:white;

  transform:translateY(-1px);

}

.status-btn:hover::before{
  opacity:1;
}

/* =========================================
   ACTIVE CURRENT STATUS
========================================= */

.status-btn.active{

  border-color:rgba(34,211,238,.30);

  background:
    linear-gradient(
      180deg,
      rgba(34,211,238,.16),
      rgba(34,211,238,.08)
    );

  color:#67e8f9;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.05),
    0 0 30px rgba(34,211,238,.08);

  pointer-events: none;

}

/* =========================================
   DELIVERED
========================================= */

.status-btn.completed{

  border-color:rgba(16,185,129,.34) !important;

  background:
    linear-gradient(
      180deg,
      rgba(16,185,129,.22),
      rgba(16,185,129,.10)
    ) !important;

  color:#6ee7b7 !important;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.05),
    0 0 40px rgba(16,185,129,.14);

}

/* =========================================
   CANCELLED
========================================= */

.status-btn.cancelled{

  border-color:rgba(239,68,68,.24);

  background:
    linear-gradient(
      180deg,
      rgba(239,68,68,.16),
      rgba(239,68,68,.07)
    );

  color:#fca5a5;

}

/* =========================================
   DISABLED
========================================= */

.status-btn:disabled{

  cursor:not-allowed;

  pointer-events:none;

}

/* =========================================
   DISABLED NORMAL
========================================= */

.status-btn:disabled:not(.completed):not(.cancelled){

  opacity:.22 !important;

  filter:saturate(.5);

}

/* =========================================
   DELIVERED ACTIVE
========================================= */

.status-btn.completed{

  opacity:1 !important;

  pointer-events:none;

  border-color:rgba(16,185,129,.55) !important;

  background:
    linear-gradient(
      180deg,
      rgba(16,185,129,.30),
      rgba(16,185,129,.14)
    ) !important;

  color:#6ee7b7 !important;

  box-shadow:
    0 0 30px rgba(16,185,129,.18),
    inset 0 1px 0 rgba(255,255,255,.05);

}

/* =========================================
   CANCELLED ACTIVE
========================================= */

.status-btn.cancelled{

  opacity:1 !important;

  border-color:rgba(239,68,68,.35);

  background:
    linear-gradient(
      180deg,
      rgba(239,68,68,.20),
