---
// src/pages/index.astro

import Layout from "../layouts/PublicLayout.astro";

/* SHARED */
import Navbar from "../components/shared/Navbar.astro";
import Footer from "../components/shared/Footer.astro";

/* PUBLIC */
import Hero from "../components/public/Hero.astro";
import Benefits from "../components/public/Benefits.astro";
import DiagnosticTeaser from "../components/public/DiagnosticTeaser.astro";
import SalonMap from "../components/public/SalonMap.astro";
import FAQ from "../components/public/FAQ.astro";
import PublicBanner from "../components/public/PublicBanner.astro";

import PromoPopup from "../components/shared/PromoPopup.astro";

import { ArrowRight, Sparkles, Store } from "lucide-react";

const promoItems = [

  {
    title: "Prueba la  línea GOJI",
    subtitle:
      "Protección de color, brillo intenso y antioxidantes premium.",
    image:
      "/images/products/goji/goji-banner.jpg",
    buttonText: "Ver línea",
    buttonHref: "/catalogo"
  },

{
  title: "POZIONE DUO",
  subtitle:
    "El dúo profesional de reparación intensiva para cabello sensibilizado, elástico o procesado químicamente.",
  image:
    "/images/products/tratamientos/pozione-duo-banner.webp",
  buttonText: "Ver tratamiento",
  buttonHref: "/catalogo"
},

{
  title: "Tus clientas ya buscan AVYNA",
  subtitle:
    "Genera más ingresos ofreciendo productos profesionales que aumentan recompra, recomendación y fidelización.",
  image:
    "/images/grow/avyna-salon-5.jpg",
  buttonText: "Convertirme en socio",
  buttonHref: "/grow/login"
},

  {
    title: "Top ventas Argán",
    subtitle:
      "La línea favorita para reparación y brillo profesional.",
    image:
      "/images/products/argan/argan-banner.jpg",
    buttonText: "Descubrir",
    buttonHref: "/catalogo"
  },

  {
    title: "Diagnóstico inteligente AVYNA",
    subtitle:
      "Descubre la rutina ideal según las necesidades reales de tu cabello.",
    image:
      "/images/avyna/avyna-banner-2.jpg",
    buttonText: "Comenzar",
    buttonHref: "/diagnostico"
  },

  {
    title: "Club Profesional AVYNA",
    subtitle:
      "Beneficios exclusivos para salones y profesionales afiliados.",
    image:
      "/images/grow/avyna-salon-3.jpg",
    buttonText: "Conocer más",
    buttonHref: "/grow/login"
  }

];

const randomPromo =
  promoItems[
    Math.floor(
      Math.random() *
      promoItems.length
    )
  ];
---

<Layout
  title="AVYNA Saltillo | Productos Profesionales de Belleza y Cuidado Capilar"
  description="Descubre productos profesionales AVYNA, diagnóstico capilar, catálogo premium y salones autorizados."
>

  <!-- NAVBAR -->
  <Navbar />

  <!-- PAGE -->
  <main class="overflow-hidden bg-black text-white">

    <!-- HERO -->
    <Hero />

    <!-- BENEFITS -->
    <section id="beneficios" class="relative reveal">
      <Benefits />
    </section>

    <PublicBanner
  image="/images/avyna/avyna-banner.gif"
  title="Cabello brillante, suave y lleno de vida."
  subtitle="Rutinas profesionales diseñadas para transformar la apariencia del cabello."
/>

    <!-- DIAGNÓSTICO -->
    <section id="diagnostico" class="relative reveal">
      <DiagnosticTeaser />
    </section>

    <!-- MAPA -->
    <section id="salones" class="relative reveal">
      <SalonMap />
    </section>

    <!-- FAQ -->
    <section id="faq" class="relative reveal">
      <FAQ />
    </section>

    <!-- GROW CARD -->
    <section id="grow" class="relative px-6 pb-10">

      <div class="mx-auto max-w-6xl">

        <div class="reveal relative overflow-hidden rounded-[2.5rem] border border-white/10 bg-white/3 p-8 backdrop-blur-2xl md:p-12">

          <!-- glow -->
          <div class="absolute inset-0 -z-10">
            <div class="absolute right-0 top-0 h-60 w-60 rounded-full bg-white/5 blur-3xl"></div>
          </div>

          <div class="grid items-center gap-10 lg:grid-cols-2">

            <!-- LEFT -->
            <div>

              <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-5 py-2 text-sm text-white/75">
                <Store size={15} />
                Grow AVYNA
              </div>

              <h2 class="mt-6 text-4xl font-bold leading-tight tracking-tight md:text-5xl">
                ¿Tienes salón o negocio?
                <span class="block text-zinc-400">
                  Vende AVYNA con nosotros
                </span>
              </h2>

              <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/60">
                Obtén acceso a precios especiales, productos premium y atención personalizada
                para impulsar tus ventas en Saltillo.
              </p>

              <div class="mt-8 flex flex-col gap-4 sm:flex-row">

                <a
                  href="/grow/login"
                  class="press inline-flex h-14 items-center justify-center gap-2 rounded-full bg-white px-8 font-semibold text-black transition duration-300 hover:scale-105"
                >
                  Quiero vender AVYNA
                  <ArrowRight size={18} />
                </a>

              </div>

            </div>

            <!-- RIGHT -->
            <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">

              <div class="rounded-3xl border border-white/10 bg-white/3 px-6 py-5">
                <p class="text-2xl font-bold">Más ganancias</p>
                <p class="mt-1 text-sm text-white/45">
                  Mejores márgenes por venta
                </p>
              </div>

              <div class="rounded-3xl border border-white/10 bg-white/3 px-6 py-5">
                <p class="text-2xl font-bold">Alta demanda</p>
                <p class="mt-1 text-sm text-white/45">
                  Productos que tus clientas buscan
                </p>
              </div>

              <div class="rounded-3xl border border-white/10 bg-white/3 px-6 py-5">
                <p class="text-2xl font-bold">Atención cercana</p>
                <p class="mt-1 text-sm text-white/45">
                  Acompañamiento personalizado
                </p>
              </div>

            </div>

          </div>

        </div>

      </div>

    </section>

  </main>

  <!-- FOOTER -->
  <Footer />

<PromoPopup
  items={promoItems}
  delay={7000}
  autoClose={10000}
  interval={45000}
/>

</Layout>