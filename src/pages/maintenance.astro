---
// src/pages/maintenance.astro

import Layout from "../layouts/PublicLayout.astro";

import {
  Wrench,
  Activity,
  Clock3,
  RefreshCw,
  MessageCircleWarning,
} from "lucide-react";
---

<Layout
  title="AVYNA Saltillo | Mantenimiento"
  description="Estamos realizando mejoras para ofrecer una mejor experiencia AVYNA."
  image="/images/seo/og-home.jpg"
  url="https://avynasaltillo.beauty/maintenance"
>
  <main
    class="relative flex justify-center items-center bg-black h-screen overflow-hidden text-white"
  >
    <!-- BACKGROUND -->
    <div class="absolute inset-0 overflow-hidden">
      <!-- top glow -->
      <div
        class="top-[-18rem] left-1/2 absolute bg-white/[0.05] blur-3xl rounded-full w-[40rem] h-[40rem] -translate-x-1/2"
      >
      </div>

      <!-- left glow -->
      <div
        class="top-1/3 left-[-10rem] absolute bg-white/[0.03] blur-3xl rounded-full w-[24rem] h-[24rem]"
      >
      </div>

      <!-- right glow -->
      <div
        class="right-[-6rem] bottom-[-8rem] absolute bg-zinc-300/[0.03] blur-3xl rounded-full w-[22rem] h-[22rem]"
      >
      </div>

      <!-- noise -->
      <div
        class="absolute inset-0 bg-[url('/images/noise.png')] opacity-[0.018] mix-blend-screen"
      >
      </div>

      <!-- vignette -->
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_20%,rgba(0,0,0,.65))]"
      >
      </div>
    </div>

    <!-- CONTENT -->
    <section
      class="z-10 relative flex flex-col items-center mx-auto px-5 sm:px-6 py-6 sm:py-10 w-full max-w-6xl text-center"
    >
      <!-- LOGO -->
      <div class="flex justify-center items-center mb-8 sm:mb-10">
        <img
          src="/images/logo-avyna-white.png"
          alt="AVYNA"
          class="w-auto h-6 sm:h-8 md:h-10 object-contain"
        />
      </div>

      <!-- LABEL -->
      <div
        class="inline-flex items-center gap-2 bg-white/[0.03] backdrop-blur-xl px-3 sm:px-4 py-1.5 sm:py-2 border border-white/10 rounded-full"
      >
        <Wrench size={13} className="text-white/55 shrink-0" />

        <p
          class="text-[10px] text-white/40 sm:text-[11px] uppercase tracking-[0.24em] sm:tracking-[0.38em]"
        >
          Actualización en progreso
        </p>
      </div>

      <!-- TITLE -->
      <h1
        class="mt-5 px-4 w-full max-w-[1500px] font-normal text-[3.3rem] lg:text-[6.3rem] sm:text-5xl md:text-7xl leading-[0.92] sm:leading-[0.88] tracking-[-0.095em]"
        style="
          font-family:
            'Clash Display',
            'Satoshi',
            sans-serif;
        "
      >
        Estamos realizando
        <br />
        mejoras para ti
      </h1>

      <!-- TEXT -->
      <p
        class="mx-auto mt-6 max-w-2xl text-[0.98rem] text-white/58 sm:text-[1rem] md:text-[1.08rem] leading-[1.75] sm:leading-[1.9]"
        style="
          font-family:
            'Satoshi',
            'Plus Jakarta Sans',
            sans-serif;
        "
      >
        Estamos optimizando la experiencia AVYNA para ofrecer una plataforma más
        rápida, elegante y estable para clientes y profesionales.
      </p>

      <!-- STATUS -->
      <div class="mt-8 sm:mt-10">
        <div
          class="inline-flex items-center gap-3 bg-white/[0.03] backdrop-blur-2xl px-5 py-4 border border-white/10 rounded-2xl"
        >
          <!-- dot -->
          <span
            class="bg-amber-300 shadow-[0_0_14px_rgba(252,211,77,.8)] rounded-full w-2.5 h-2.5"
          ></span>

          <!-- text -->
          <p
            class="text-[11px] text-white/48 sm:text-[12px] uppercase tracking-[0.24em]"
          >
            Estamos trabajando en mejoras
          </p>
        </div>
      </div>

      <!-- BUTTONS -->
      <div
        class="flex sm:flex-row flex-col gap-4 mt-7 sm:mt-8 w-full sm:w-auto"
      >
        <!-- SUPPORT -->
        <button
          id="supportBtn"
          type="button"
          class="inline-flex justify-center items-center gap-3 bg-white hover:bg-white/95 px-8 rounded-2xl h-13 sm:h-14 font-semibold text-black hover:scale-[1.03] active:scale-[0.98] transition-all duration-300"
        >
          <MessageCircleWarning size={18} />

          Contactar soporte
        </button>

        <!-- REFRESH -->
        <button
          onclick="window.location.reload()"
          class="inline-flex justify-center items-center gap-3 bg-white/[0.03] hover:bg-white/[0.06] backdrop-blur-xl px-8 border border-white/10 hover:border-white/20 rounded-2xl h-13 sm:h-14 font-medium text-white transition-all duration-300"
        >
          <RefreshCw size={17} />

          Reintentar
        </button>
      </div>

      <!-- FOOT -->
      <div
        class="flex items-center gap-3 mt-10 sm:mt-12 text-[10px] text-white/28 sm:text-[12px] uppercase tracking-[0.22em] sm:tracking-[0.25em]"
      >
        <span class="bg-white/10 w-8 sm:w-10 h-[1px]"></span>

        AVYNA Saltillo

        <span class="bg-white/10 w-8 sm:w-10 h-[1px]"></span>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  document.getElementById("supportBtn")?.addEventListener("click", () => {
    const phone = "528445399548";

    const message =
      "Hola AVYNA, veo que el sitio está en mantenimiento y necesito ayuda.";

    const encoded = encodeURIComponent(message);

    const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);

    const url = isMobile
      ? `whatsapp://send?phone=${phone}&text=${encoded}`
      : `https://web.whatsapp.com/send?phone=${phone}&text=${encoded}`;

    window.open(url, "_blank");
  });
</script>
