---
// src/pages/grow/index.astro

import Layout from "../../layouts/GrowLayout.astro";

import Navbar from "../../components/shared/Navbar.astro";
import Hero from "../../components/grow/GrowHero.astro";
import About from "../../components/grow/GrowAbout.astro";
import CreditInfo from "../../components/grow/GrowCredit.astro";
import ClubPreferred from "../../components/grow/GrowClubPreferred.astro";
import Experiences from "../../components/grow/GrowExperiences.astro";
import Footer from "../../components/shared/Footer.astro";
import GrowOnBoarding from "../../components/grow/GrowOnBoarding.astro";
import GrowTestimonials from "../../components/grow/GrowTestimonials.astro";

import {
  Sparkles,
  CreditCard,
  Package,
  MessageCircle,
  ShieldCheck,
} from "lucide-react";
---

<Layout
  title="AVYNA Saltillo | Conviértete en socio AVYNA"
  description="Beneficios exclusivos para socios, salones y profesionales afiliados."
>
  <meta name="robots" content="noindex,nofollow" />

  <!-- LOADER SIEMPRE -->
  <div
    id="gateLoader"
    class="z-9999 fixed inset-0 flex justify-center items-center bg-black text-white"
  >
    <div class="text-center">
      <div
        class="flex justify-center items-center backdrop-blur-xl mx-auto mb-1 p-4 rounded-3xl w-90 h-25"
      >
        <img
          src="/images/logo-avyna-white.png"
          alt="AVYNA"
          class="w-auto h-50 object-contain"
        />
      </div>

      <div
        class="mx-auto border-2 border-white/10 border-t-white rounded-full w-12 h-12 animate-spin"
      >
      </div>

      <p id="loaderText" class="mt-5 text-white/55 text-sm">
        Validando acceso...
      </p>
    </div>
  </div>

  <!-- PAGE -->
  <div id="protectedPage" class="opacity-0 pointer-events-none">
    <Navbar />

    <main class="bg-black overflow-hidden text-white">
      <!-- HERO -->
      <Hero />

      <GrowOnBoarding />

      <!-- CONTENT -->
      <About />

      <GrowTestimonials />
      <CreditInfo />
      <ClubPreferred />

      <Experiences />
    </main>

    <Footer />
  </div>

  <script is:inline>
    const KEY = "avyna_grow_access";
    const EXP = "avyna_grow_expire";

    const loader = document.getElementById("gateLoader");
    const loaderText = document.getElementById("loaderText");
    const page = document.getElementById("protectedPage");

    function redirectLogin() {
      localStorage.removeItem(KEY);
      localStorage.removeItem(EXP);

      loaderText.textContent = "Redirigiendo...";

      setTimeout(() => {
        window.location.pathname = "/grow/login";
      }, 900);
    }

    function showPage() {
      loaderText.textContent = "Acceso válido";

      setTimeout(() => {
        loader.style.opacity = "0";
        loader.style.transition = "opacity .35s ease";

        page.classList.remove("opacity-0");
        page.classList.remove("pointer-events-none");
        page.classList.add("opacity-100");

        setTimeout(() => {
          loader.style.display = "none";
        }, 350);
      }, 700);
    }

    /* VALIDAR */
    const access = localStorage.getItem(KEY);
    const expire = Number(localStorage.getItem(EXP) || 0);

    setTimeout(() => {
      if (access !== "true" || Date.now() > expire) {
        redirectLogin();
      } else {
        showPage();
      }
    }, 900);
  </script>
</Layout>
