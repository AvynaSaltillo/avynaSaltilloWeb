---
// src/pages/grow/login.astro
import Layout from "../../layouts/GrowLayout.astro";
import {
  ShieldCheck,
  ArrowRight,
  Eye,
  MessageCircle,
  Lock,
  X,
  BadgeCheck,
  Sparkles,
  BriefcaseBusiness,
  Crown,
} from "lucide-react";

import { BsArrowUpLeftSquareFill } from "react-icons/bs";
---

<Layout title="AVYNA Saltillo | Oportunidad Comercial En Saltillo">
  <meta name="robots" content="noindex,nofollow" />

  <!-- SECTION PRINCIPAL -->
  <section class="relative bg-black min-h-dvh overflow-x-hidden text-white">
    <!-- BG -->
    <div class="absolute inset-0">
      <div
        class="top-0 -left-32 absolute bg-white/5 blur-3xl rounded-full w-96 h-96"
      >
      </div>
      <div
        class="-right-32 bottom-0 absolute bg-white/5 blur-3xl rounded-full w-96 h-96"
      >
      </div>
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,.08),transparent_40%)]"
      >
      </div>
    </div>

    <!-- CONTENT -->
    <div
      class="z-10 relative flex flex-col justify-center mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-10 w-full max-w-md sm:max-w-lg md:max-w-xl lg:max-w-xl min-h-dvh"
    >
      <a
        href="/"
        class="inline-flex items-center gap-2 bg-white/2 hover:bg-white/10 backdrop-blur-xl mb-12 px-4 border border-white/7 hover:border-white/20 rounded-full w-fit h-11 font-medium text-white/75 hover:text-white text-sm transition duration-300"
      >
        <BsArrowUpLeftSquareFill size={22} opacity={0.9} />
        Volver al sitio
      </a>

      <!-- TOP -->
      <div class="mb-10 lg:mb-10 text-center">
        <p
          class="text-[11px] text-white/35 sm:text-xs uppercase tracking-[0.42em]"
        >
          Acceso Comercial
        </p>

        <div
          class="flex justify-center items-center mx-auto mb-3 w-full h-16 sm:h-20"
        >
          <img
            src="/images/logo-avyna-white.png"
            alt="AVYNA"
            class="w-auto h-8 sm:h-9 lg:h-10 object-contain"
          />
        </div>

        <p
          class="mx-auto mt-3 max-w-md text-white/55 text-sm sm:text-base leading-relaxed"
        >
          Accede al catálogo profesional AVYNA, precios comerciales y beneficios
          para salones autorizados en Saltillo.
        </p>
      </div>

      <!-- CARD -->
      <div
        class="bg-white/4 shadow-2xl backdrop-blur-2xl p-5 sm:p-8 lg:p-8 border border-white/15 rounded-4xl"
      >
        <label class="flex items-center gap-2 text-white/65 text-sm">
          <Lock size={14} />
          Clave de acceso AVYNA
        </label>

        <!-- INPUT -->
        <div class="relative mt-3">
          <input
            id="pass"
            type="password"
            placeholder="Ingresa la clave"
            class="bg-black/55 px-5 pr-14 border border-white/15 focus:border-white/40 rounded-2xl outline-none w-full h-14 text-[16px] transition"
          />

          <button
            id="togglePass"
            type="button"
            class="top-1/2 right-4 absolute text-white/55 hover:text-white transition -translate-y-1/2"
          >
            <Eye size={18} />
          </button>
        </div>

        <!-- ERROR -->
        <p
          id="errorMsg"
          class="hidden bg-red-500/10 mt-4 px-4 py-3 border border-red-500/20 rounded-2xl text-red-300 text-sm"
        >
          Clave inválida. Solicita acceso con un distribuidor autorizado.
        </p>

        <!-- BTN LOGIN -->
        <button
          id="loginBtn"
          class="flex justify-center items-center gap-2 bg-white/90 mt-5 rounded-2xl w-full h-14 font-bold text-black hover:scale-[1.01] transition"
        >
          Ingresar con clave
          <ArrowRight size={18} />
        </button>

        <!-- DIVIDER -->
        <div class="my-5 border-white/10 border-t"></div>

        <!-- BTN MODAL -->
        <button
          id="openModal"
          class="flex justify-center items-center gap-2 bg-white/5 hover:bg-white border border-white/10 rounded-2xl w-full h-14 font-semibold text-white hover:text-black transition"
        >
          <MessageCircle size={18} />
          Hablar con asesor AVYNA
        </button>

        <!-- FOOT -->
        <div
          class="mt-3 sm:mt-4 text-white/40 text-xs text-center leading-relaxed"
        >
          Acceso temporal de 8 horas · Selección previa requerida
        </div>
      </div>
    </div>

    <!-- MODAL -->
    <div
      id="advisorModal"
      class="hidden z-9999 fixed inset-0 bg-black/75 backdrop-blur-md px-6 py-8 overflow-y-auto"
    >
      <div
        class="bg-zinc-950 shadow-2xl mx-auto my-auto p-6 border border-white/10 rounded-4xl w-full max-w-lg"
      >
        <!-- HEAD -->
        <div class="flex justify-between items-center">
          <div>
            <p class="text-white/45 text-sm">Atención personalizada</p>

            <h3 class="mt-1 font-semibold text-2xl">Elige tu asesor AVYNA</h3>
          </div>

          <button
            id="closeModal"
            class="flex justify-center items-center hover:bg-white border border-white/10 rounded-xl w-10 h-10 text-white/60 hover:text-black"
          >
            <X size={18} />
          </button>
        </div>

        <p class="mt-4 text-white/50 text-sm leading-relaxed">
          Selecciona con quién deseas atenderte para solicitar acceso y recibir
          seguimiento personalizado.
        </p>

        <!-- OPTIONS -->
        <div class="gap-3 grid mt-6">
          <!-- ANGELES -->
          <button
            class="group relative bg-white/[0.03] hover:bg-white/[0.05] p-4 border border-white/10 hover:border-white/20 rounded-[1.7rem] overflow-hidden text-left active:scale-[0.985] transition-all hover:-translate-y-[2px] duration-300 hover:cursor-pointer repBtn"
            data-phone="524521174729"
            data-name="Ángeles"
          >
            <!-- glow -->
            <div
              class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,.12),transparent_52%)] opacity-0 group-hover:opacity-100 blur-xl transition-opacity duration-500"
            >
            </div>

            <div class="z-10 relative flex items-center gap-4">
              <!-- PHOTO -->
              <div class="relative shrink-0">
                <img
                  src="/images/advisors/angeles-pp.png"
                  alt="Ángeles Encinas"
                  class="rounded-full ring-3 ring-white/15 w-20 h-20 object-cover"
                />

                <!-- online -->
                <span
                  class="-right-0.5 -bottom-0.5 absolute bg-emerald-400 shadow-[0_0_14px_rgba(74,222,128,.95)] border-2 border-zinc-950 rounded-full w-4 h-4"
                ></span>
              </div>

              <!-- INFO -->
              <div class="flex-1 ml-2 min-w-0">
                <h4
                  class="flex items-center gap-2 font-normal text-[1.2rem] text-white"
                >
                  Ángeles Encinas López

                  <BadgeCheck size={16} className="text-sky-300/90 shrink-0" />
                </h4>

                <div class="flex items-center gap-2 mt-2 text-white/45 text-sm">
                  <Crown size={14} className="text-white/90 shrink-0" />

                  <span> Atención personalizada AVYNA </span>
                </div>
              </div>
            </div>
          </button>

          <!-- MICHELLE -->
          <button
            class="group relative bg-white/[0.03] hover:bg-white/[0.05] p-4 border border-white/10 hover:border-white/20 rounded-[1.7rem] overflow-hidden text-left active:scale-[0.985] transition-all hover:-translate-y-[2px] duration-300 hover:cursor-pointer repBtn"
            data-phone="528445069238"
            data-name="Michelle"
          >
            <!-- glow -->
            <div
              class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,.12),transparent_52%)] opacity-0 group-hover:opacity-100 blur-xl transition-opacity duration-500"
            >
            </div>

            <div class="z-10 relative flex items-center gap-4">
              <!-- PHOTO -->
              <div class="relative shrink-0">
                <img
                  src="/images/advisors/airam-pp.png"
                  alt="Michelle Navarrete"
                  class="rounded-full ring-3 ring-white/15 w-20 h-20 object-cover"
                />

                <!-- online -->
                <span
                  class="-right-0.5 -bottom-0.5 absolute bg-emerald-400 shadow-[0_0_14px_rgba(74,222,128,.95)] border-2 border-zinc-950 rounded-full w-4 h-4"
                ></span>
              </div>

              <!-- INFO -->
              <div class="flex-1 ml-2 min-w-0">
                <h4
                  class="flex items-center gap-2 font-normal text-[1.2rem] text-white leading-tight"
                >
                  Michelle Navarrete Zúñiga

                  <BadgeCheck size={16} className="text-sky-300/90 shrink-0" />
                </h4>

                <div class="flex items-center gap-2 mt-2 text-white/45 text-sm">
                  <MessageCircle size={14} className="text-white/55 shrink-0" />

                  <span> Atención personalizada AVYNA </span>
                </div>
              </div>
            </div>
          </button>

          <!-- BLANCA -->
          <button
            class="group relative bg-white/[0.03] hover:bg-white/[0.05] p-4 border border-white/10 hover:border-white/20 rounded-[1.7rem] overflow-hidden text-left active:scale-[0.985] transition-all hover:-translate-y-[2px] duration-300 hover:cursor-pointer repBtn"
            data-phone="528446620304"
            data-name="Blanca"
          >
            <!-- glow -->
            <div
              class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,.12),transparent_52%)] opacity-0 group-hover:opacity-100 blur-xl transition-opacity duration-500"
            >
            </div>

            <div class="z-10 relative flex items-center gap-4">
              <!-- PHOTO -->
              <div class="relative shrink-0">
                <img
                  src="/images/advisors/blanca-pp.png"
                  alt="Blanca Mejía"
                  class="rounded-full ring-3 ring-white/15 w-20 h-20 object-cover"
                />

                <!-- online -->
                <span
                  class="-right-0.5 -bottom-0.5 absolute bg-emerald-400 shadow-[0_0_14px_rgba(74,222,128,.95)] border-2 border-zinc-950 rounded-full w-4 h-4"
                ></span>
              </div>

              <!-- INFO -->
              <div class="flex-1 ml-2 min-w-0">
                <h4
                  class="flex items-center gap-2 font-normal text-[1.2rem] text-white leading-tight"
                >
                  Blanca Mejía Torres

                  <BadgeCheck size={16} className="text-sky-300/90 shrink-0" />
                </h4>

                <div class="flex items-center gap-2 mt-2 text-white/45 text-sm">
                  <MessageCircle size={14} className="text-white/55 shrink-0" />

                  <span> Atención personalizada AVYNA </span>
                </div>
              </div>
            </div>
          </button>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const KEY = "avyna_grow_access";
    const EXP = "avyna_grow_expire";
    const PASS = "Avyna#2026";

    const input = document.getElementById("pass");
    const btn = document.getElementById("loginBtn");
    const err = document.getElementById("errorMsg");
    const toggle = document.getElementById("togglePass");

    /* modal */
    const modal = document.getElementById("advisorModal");
    const openModal = document.getElementById("openModal");
    const closeModal = document.getElementById("closeModal");

    input.focus();

    /* sesión activa */
    const access = localStorage.getItem(KEY);
    const expire = Number(localStorage.getItem(EXP) || 0);

    if (access === "true" && Date.now() < expire) {
      window.location.pathname = "/grow";
    }

    /* login */
    function login() {
      err.classList.add("hidden");

      if (input.value.trim() !== PASS) {
        err.classList.remove("hidden");

        input.animate(
          [
            { transform: "translateX(-5px)" },
            { transform: "translateX(5px)" },
            { transform: "translateX(0)" },
          ],
          { duration: 180 },
        );

        return;
      }

      btn.disabled = true;
      btn.innerHTML = "Entrando...";

      const newExpire = Date.now() + 1000 * 60 * 60 * 8;

      localStorage.setItem(KEY, "true");
      localStorage.setItem(EXP, newExpire.toString());

      window.location.pathname = "/grow";
    }

    btn.onclick = login;

    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") login();
    });

    /* toggle */
    let visible = false;

    toggle.onclick = () => {
      visible = !visible;
      input.type = visible ? "text" : "password";
    };

    /* modal open/close */
    openModal.onclick = () => {
      modal.classList.remove("hidden");
      modal.classList.add("flex");
    };

    closeModal.onclick = closeMyModal;

    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeMyModal();
    });

    function closeMyModal() {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }

    /* reps */
    document.querySelectorAll(".repBtn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const phone = btn.dataset.phone;
        const name = btn.dataset.name;

        const msg = `Hola ${name}, me interesa formar parte de AVYNA en Saltillo. ¿Podrías compartirme información para acceder y conocer beneficios comerciales?`;

        const encoded = encodeURIComponent(msg);

        const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);

        const url = isMobile
          ? `whatsapp://send?phone=${phone}&text=${encoded}`
          : `https://web.whatsapp.com/send?phone=${phone}&text=${encoded}`;

        window.open(url, "_blank");

        closeMyModal();
      });
    });
  </script>
</Layout>
