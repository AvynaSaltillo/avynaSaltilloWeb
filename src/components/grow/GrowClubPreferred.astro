---
// src/components/partners/ClubPreferred.astro
import {
  Star,
  ShieldCheck,
  Crown,
  Gem,
  ArrowUpRight,
  Sparkles,
} from "lucide-react";
---

<section
  id="clubPreferred"
  class="relative bg-black px-6 py-15 overflow-hidden text-white"
>
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="top-0 left-0 absolute bg-white/5 blur-3xl rounded-full w-96 h-96"
    >
    </div>
    <div
      class="right-0 bottom-0 absolute bg-white/5 blur-3xl rounded-full w-96 h-96"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl">
    <!-- HEADER -->
    <div class="mx-auto mb-18 max-w-4xl text-center">
      <div
        class="inline-flex items-center gap-2 bg-white/5 backdrop-blur-xl mb-5 px-4 py-2 border border-white/10 rounded-full text-sm"
      >
        <Sparkles size={15} />
        Club Preferred AVYNA
      </div>

      <h2 class="font-medium text-4xl md:text-6xl tracking-tight">
        Sube de Nivel
      </h2>

      <p class="mt-6 text-white/65 text-lg leading-relaxed">
        Programa diseñado para reconocer la constancia de compra, impulsar
        recomendaciones de mantenimiento en casa y premiar el crecimiento
        profesional de cada salón.
      </p>
    </div>

    <!-- LEVELS -->
    <div class="gap-8 grid">
      <!-- LEVEL 1 -->
      <div
        class="group bg-white shadow-2xl p-8 border border-white/10 rounded-[2.5rem] text-black transition hover:-translate-y-1 duration-300"
      >
        <div class="gap-8 grid lg:grid-cols-[110px_1fr]">
          <div
            class="flex justify-center items-center bg-zinc-200 shadow-inner rounded-3xl w-24 h-24"
          >
            <Star size={32} />
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-3 mb-6">
              <h3 class="font-bold text-3xl">Nivel 1 · Salón Preferred</h3>

              <span
                class="bg-zinc-200 px-3 py-1 rounded-full font-medium text-sm"
              >
                Entrada
              </span>
            </div>

            <div class="gap-8 grid md:grid-cols-2 text-zinc-700">
              <div class="bg-zinc-100 p-5 rounded-3xl">
                <p class="mb-2 font-semibold">¿Cómo obtenerlo?</p>
                <p>1 compra desde <strong>$2,000 MXN</strong>.</p>

                <p class="mt-5 mb-2 font-semibold">¿Cómo mantenerlo?</p>
                <p>1 compra mensual mínima de <strong>$2,000 MXN</strong>.</p>
              </div>

              <div class="bg-zinc-100 p-5 rounded-3xl">
                <p class="mb-3 font-semibold">Beneficios</p>
                <ul class="space-y-2">
                  <li>• Inscripción al club</li>
                  <li>• Precio salón</li>
                  <li>• Atención prioritaria</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- LEVEL 2 -->
      <div
        class="group bg-red-600 shadow-2xl p-8 rounded-[2.5rem] text-white transition hover:-translate-y-1 duration-300"
      >
        <div class="gap-8 grid lg:grid-cols-[110px_1fr]">
          <div
            class="flex justify-center items-center bg-white shadow-xl rounded-3xl w-24 h-24 text-red-600"
          >
            <ShieldCheck size={32} />
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-3 mb-6">
              <h3 class="font-bold text-3xl">Nivel 2 · Salón Red</h3>

              <span
                class="bg-red-500 px-3 py-1 rounded-full font-medium text-sm"
              >
                Crecimiento
              </span>
            </div>

            <div class="gap-8 grid md:grid-cols-2 text-white/90">
              <div class="bg-red-500 backdrop-blur-xl p-5 rounded-3xl">
                <p class="mb-2 font-semibold">¿Cómo obtenerlo?</p>
                <p>
                  1 compra de <strong>$15,000</strong> o 2 compras de <strong
                    >$10,000</strong
                  >.
                </p>

                <p class="mt-5 mb-2 font-semibold">¿Cómo mantenerlo?</p>
                <p>1 compra mensual mínima de <strong>$5,000</strong>.</p>
              </div>

              <div class="bg-red-500 backdrop-blur-xl p-5 rounded-3xl">
                <p class="mb-3 font-semibold">Beneficios</p>
                <ul class="space-y-2">
                  <li>• Pase preparación Punto AVYNA</li>
                  <li>• Activaciones AVYNA</li>
                  <li>• Exhibidor comercial</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- LEVEL 3 -->
      <div
        class="group bg-white/5 hover:bg-white/8 shadow-2xl backdrop-blur-xl p-8 border border-white/10 rounded-[2.5rem] transition hover:-translate-y-1 duration-300"
      >
        <div class="gap-8 grid lg:grid-cols-[110px_1fr]">
          <div
            class="flex justify-center items-center bg-white shadow-xl rounded-3xl w-24 h-24 text-black"
          >
            <Crown size={32} />
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-3 mb-6">
              <h3 class="font-bold text-3xl">Nivel 3 · Salón Black</h3>

              <span
                class="bg-white/10 px-3 py-1 rounded-full font-medium text-sm"
              >
                Premium
              </span>
            </div>

            <div class="gap-8 grid md:grid-cols-2 text-white/85">
              <div class="bg-white/5 p-5 border border-white/10 rounded-3xl">
                <p class="mb-2 font-semibold">¿Cómo obtenerlo?</p>
                <p>
                  1 compra de <strong>$30,000</strong> o 2 compras de <strong
                    >$20,000</strong
                  >.
                </p>

                <p class="mt-5 mb-2 font-semibold">¿Cómo mantenerlo?</p>
                <p>1 compra mensual mínima de <strong>$15,000</strong>.</p>
              </div>

              <div class="bg-white/5 p-5 border border-white/10 rounded-3xl">
                <p class="mb-3 font-semibold">Beneficios</p>
                <ul class="space-y-2">
                  <li>• Publicación como salón Black</li>
                  <li>• Activaciones AVYNA</li>
                  <li>• Exhibidores en salón</li>
                  <li>• Punto AVYNA</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- LEVEL 4 -->
      <div
        class="group bg-zinc-300 shadow-2xl p-8 rounded-[2.5rem] text-black transition hover:-translate-y-1 duration-300"
      >
        <div class="gap-8 grid lg:grid-cols-[110px_1fr]">
          <div
            class="flex justify-center items-center bg-white shadow-xl rounded-3xl w-24 h-24"
          >
            <Gem size={32} />
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-3 mb-6">
              <h3 class="font-bold text-3xl">Nivel 4 · Salón Silver</h3>

              <span
                class="bg-white shadow px-3 py-1 rounded-full font-medium text-sm"
              >
                Elite
              </span>
            </div>

            <div class="gap-8 grid md:grid-cols-2 text-zinc-700">
              <div class="bg-white p-5 rounded-3xl">
                <p class="mb-2 font-semibold">¿Cómo obtenerlo?</p>
                <p>Por invitación anual AVYNA y mantener requisitos Black.</p>

                <p class="mt-5 mb-2 font-semibold">¿Cómo mantenerlo?</p>
                <p>
                  Compra mínima mensual de <strong>$15,000</strong> + 20 tubos de
                  tinte al mes.
                </p>
              </div>

              <div class="bg-white p-5 rounded-3xl">
                <p class="mb-3 font-semibold">Beneficios</p>
                <ul class="space-y-2">
                  <li>• Publicación Silver exclusiva</li>
                  <li>• Activaciones premium</li>
                  <li>• Exhibidores comerciales</li>
                  <li>• Punto AVYNA</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
