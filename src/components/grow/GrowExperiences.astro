---
// src/components/partners/Experiences.astro
import {
  Plane,
  Sparkles,
  Heart,
  GraduationCap,
  MapPin,
  CalendarDays,
  Star,
} from "lucide-react";
---

<section
  id="experiences"
  class="relative bg-black px-6 py-15 overflow-hidden text-white"
>
  <!-- BG -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="top-0 right-0 absolute bg-white/5 blur-3xl rounded-full w-96 h-96"
    >
    </div>
    <div
      class="bottom-0 left-0 absolute bg-white/5 blur-3xl rounded-full w-80 h-80"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl">
    <!-- HEADER -->
    <div class="mx-auto mb-16 max-w-4xl text-center">
      <div
        class="inline-flex items-center gap-2 bg-white/5 backdrop-blur-xl mb-5 px-4 py-2 border border-white/10 rounded-full text-sm"
      >
        <Sparkles size={15} />
        Experiencias AVYNA
      </div>

      <h2 class="font-medium text-4xl md:text-6xl tracking-tight">
        Eventos, viajes y crecimiento profesional
      </h2>

      <p class="mt-6 text-white/65 text-lg leading-relaxed">
        Más que productos: formamos comunidad, reconocemos resultados y creamos
        experiencias únicas para nuestros clientes.
      </p>
    </div>

    <!-- GRID -->
    <div class="gap-7 grid md:grid-cols-2 xl:grid-cols-3">
      <!-- PLAYA -->
      <article
        class="bg-white/5 hover:bg-white/10 hover:shadow-2xl backdrop-blur-xl p-8 border border-white/10 rounded-[2.5rem] transition hover:-translate-y-1 duration-300"
      >
        <div
          class="flex justify-center items-center bg-white shadow-xl mb-6 rounded-2xl w-14 h-14 text-black"
        >
          <Plane size={22} />
        </div>

        <h3 class="mb-3 font-medium text-2xl">Viajes a la Playa</h3>

        <p class="mb-5 text-white/65 leading-relaxed">
          Incentivos exclusivos para clientes destacados con experiencias
          inolvidables en destinos premium.
        </p>

        <div class="space-y-2 text-white/70 text-sm">
          <p>• Cancún</p>
          <p>• Punta de Mita</p>
          <p>• Puerto Vallarta</p>
          <p>• Próximos destinos sorpresa</p>
        </div>
      </article>

      <!-- TOTAL LOOK -->
      <article
        class="bg-white shadow-2xl hover:shadow-[0_25px_60px_rgba(255,255,255,.08)] p-8 rounded-[2.5rem] text-black transition hover:-translate-y-1 duration-300"
      >
        <div
          class="flex justify-center items-center bg-black shadow-xl mb-6 rounded-2xl w-14 h-14 text-white"
        >
          <Sparkles size={22} />
        </div>

        <h3 class="mb-3 font-medium text-2xl">Total Look</h3>

        <p class="mb-5 text-zinc-600 leading-relaxed">
          Eventos de imagen, tendencias y transformación profesional en ciudades
          clave del país.
        </p>

        <div class="space-y-2 text-zinc-700 text-sm">
          <p>• Guadalajara</p>
          <p>• Monterrey</p>
          <p>• Lanzamientos y tendencias</p>
          <p>• Networking profesional</p>
        </div>
      </article>

      <!-- LOCALES -->
      <article
        class="bg-white/5 hover:bg-white/10 hover:shadow-2xl backdrop-blur-xl p-8 border border-white/10 rounded-[2.5rem] transition hover:-translate-y-1 duration-300"
      >
        <div
          class="flex justify-center items-center bg-white shadow-xl mb-6 rounded-2xl w-14 h-14 text-black"
        >
          <Heart size={22} />
        </div>

        <h3 class="mb-3 font-medium text-2xl">Eventos Locales</h3>

        <p class="mb-5 text-white/65 leading-relaxed">
          Convivencias y experiencias especiales pensadas para nuestra
          comunidad.
        </p>

        <div class="space-y-2 text-white/70 text-sm">
          <p>• Posada AVYNA</p>
          <p>• 14 de Febrero</p>
          <p>• Una Noche Para Ti AVYNA</p>
          <p>• Dinámicas exclusivas</p>
        </div>
      </article>

      <!-- ONLINE -->
      <article
        class="bg-white/5 hover:bg-white/10 hover:shadow-2xl backdrop-blur-xl p-8 border border-white/10 rounded-[2.5rem] transition hover:-translate-y-1 duration-300"
      >
        <div
          class="flex justify-center items-center bg-white shadow-xl mb-6 rounded-2xl w-14 h-14 text-black"
        >
          <GraduationCap size={22} />
        </div>

        <h3 class="mb-3 font-medium text-2xl">Capacitaciones Online</h3>

        <p class="mb-5 text-white/65 leading-relaxed">
          Aprende desde cualquier lugar con sesiones digitales enfocadas en
          ventas, técnica y producto.
        </p>

        <div class="space-y-2 text-white/70 text-sm">
          <p>• Zoom / Streaming</p>
          <p>• Técnicas actuales</p>
          <p>• Ventas inteligentes</p>
          <p>• Tendencias</p>
        </div>
      </article>

      <!-- PRESENCIAL -->
      <article
        class="bg-white/5 hover:bg-white/10 hover:shadow-2xl backdrop-blur-xl p-8 border border-white/10 rounded-[2.5rem] transition hover:-translate-y-1 duration-300"
      >
        <div
          class="flex justify-center items-center bg-white shadow-xl mb-6 rounded-2xl w-14 h-14 text-black"
        >
          <MapPin size={22} />
        </div>

        <h3 class="mb-3 font-medium text-2xl">Capacitaciones Presenciales</h3>

        <p class="mb-5 text-white/65 leading-relaxed">
          Formación práctica con demostraciones reales y atención personalizada.
        </p>

        <div class="space-y-2 text-white/70 text-sm">
          <p>• Saltillo</p>
          <p>• Monterrey</p>
          <p>• Técnicas en vivo</p>
          <p>• Resolución de dudas</p>
        </div>
      </article>

      <!-- VIP -->
      <article
        class="bg-linear-to-br from-white/10 to-white/5 shadow-2xl hover:shadow-[0_25px_60px_rgba(255,255,255,.06)] backdrop-blur-xl p-8 border border-white/10 rounded-[2.5rem] transition hover:-translate-y-1 duration-300"
      >
        <div
          class="flex justify-center items-center bg-white shadow-xl mb-6 rounded-2xl w-14 h-14 text-black"
        >
          <Star size={22} />
        </div>

        <h3 class="mb-3 font-medium text-2xl">Próximos Eventos VIP</h3>

        <p class="mb-6 text-white/65 leading-relaxed">
          Mantente cerca de AVYNA para enterarte primero de experiencias,
          lanzamientos y oportunidades exclusivas.
        </p>
      </article>
    </div>
  </div>
</section>
