---
import { products } from "../../data/products";
import {
  Search,
  ChevronDown,
  ChevronUp,
  Package2,
  Leaf,
  Gem,
  Droplets,
  Sprout,
  Flower2,
  Palette,
  Scissors,
  ScanFace,
  Briefcase,
  BadgeCheck,
  Sparkles,
  Shield,
  Star,
  Wand2,
  Download
} from "lucide-react";

const grouped = products.reduce((acc: Record<string, any[]>, item) => {
  if (!acc[item.family]) acc[item.family] = [];
  acc[item.family].push(item);
  return acc;
}, {});

const families = Object.keys(grouped);

const familyIcons: Record<string, typeof Package2> = {
  Argan: Leaf,
  Goji: Sparkles,
  Platino: Gem,
  Ialuronico: Droplets,
  Abbondanza: Sprout,
  Agave: Flower2,
  Profesional: BadgeCheck,
  Color: Palette,
  Xtyling: Scissors,
  Skin: ScanFace,
  Makeup: Wand2,
  Accessories: Briefcase,
  Especiales: Star,
  Solidos: Shield
};

const familyColors: Record<string, string> = {
  Argan: "#8C5827",
  Goji: "#D94C37",
  Ialuronico: "#EF5A9D",
  Agave: "#006F7B",
  Especiales: "#BB2332",
  Platino: "#9FA0A0",
  Abbondanza: "#388A41",
  Xtyling: "#6BA236",
  Profesional: "#4075BB"
};
---

<section class="bg-black px-4 sm:px-6 py-28 text-white">

  <div class="mx-auto max-w-7xl">

    <!-- TOP -->
    <div class="mb-10">

      <h1 class="font-medium text-4xl sm:text-6xl tracking-tight">
        Catálogo Profesional AVYNA
      </h1>

      <p class="mt-4 max-w-2xl text-white/60 text-lg">
        Explora líneas profesionales, maquillaje, skin care y productos
        premium AVYNA.
      </p>

      <div class="inline-flex flex-wrap items-center gap-3 mt-6">

  <div class="bg-emerald-400/20 px-4 py-2 border border-emerald-400/20 rounded-full font-semibold text-emerald-200 text-sm">
    Ganancia estimada del 30%
  </div>

  <p class="text-white/45 text-sm">
    Calculada sobre precio público sugerido.*
  </p>

</div>

    </div>

<!-- SEARCH -->
<div class="top-18 z-30 sticky mb-5">

  <div class="bg-black/80 backdrop-blur-2xl p-3 border border-white/10 rounded-3xl">

    <div class="gap-3 grid md:grid-cols-[1fr_auto]">

      <!-- INPUT -->
      <div class="relative">

  <Search
    size={18}
    className="top-1/2 left-5 absolute text-white/35 -translate-y-1/2 pointer-events-none"
  />

  <input
    id="searchInput"
    type="text"
    placeholder="Buscar producto..."
    class="bg-white/5 pr-14 pl-14 border border-white/10 focus:border-white/30 rounded-2xl outline-none w-full h-14 transition"
  />

  <!-- BOTÓN LIMPIAR -->
  <button
    id="clearSearch"
    type="button"
    class="hidden top-1/2 right-3 absolute justify-center items-center bg-white/5 hover:bg-white rounded-xl w-9 h-9 text-white/50 hover:text-black transition -translate-y-1/2"
    aria-label="Limpiar búsqueda"
  >
    ✕
  </button>

</div>

      <!-- DOWNLOAD BUTTON -->
      <a
        href="/catalogos/catalogo_avyna_2025.pdf"
        download
        class="inline-flex justify-center items-center gap-2 bg-white px-6 rounded-2xl h-14 font-semibold text-black hover:scale-[1.02] transition"
      >
        <Download size={18} />
        Descargar catálogo
      </a>

    </div>

  </div>

</div>

        <!-- DEBAJO DEL BLOQUE DEL BUSCADOR -->
<div class="flex flex-wrap items-center gap-3 mt-4 mb-6 px-1">

  <div
    id="searchResults"
    class="font-medium text-[16px] text-white/55 tracking-wide transition-all duration-300"
  >
    Mostrando catálogo completo
  </div>

  <div
    id="searchFamilies"
    class="bg-white/5 px-4 py-1.5 border border-white/10 rounded-full font-semibold text-white/40 text-xs uppercase tracking-[0.22em]"
  >
    Todas las líneas
  </div>

</div>

    <!-- FAMILIES -->
    <div class="space-y-6">

      {families.map((family, i) => {
        const Icon = familyIcons[family] || Package2;
        const items = grouped[family];
        const color = familyColors[family] || "#ffffff";

        return (
          <div
  class="border rounded-4xl overflow-hidden"
  style={`border-color:${color}30;background:linear-gradient(180deg,${color}08,rgba(255,255,255,.02));`}
>

            <!-- HEADER -->
            <button
              class={`family-toggle flex w-full items-center justify-between px-6 py-5 text-left transition hover:bg-white/5 ${
                i === 0 ? "active" : ""
              }`}
              data-target={`family-${i}`}
            >

              <div class="flex items-center gap-4">

                <div
  class="flex justify-center items-center shadow-xl rounded-2xl w-12 h-12 text-black"
  style={`background:${color};`}
>
  <Icon size={20} />
</div>

                <div>
                  <h2
  class="font-semibold text-xl sm:text-2xl"
  style={`color:${color};`}
>
  {family}
</h2>

                  <p class="text-white/45 text-sm">
                    {items.length} productos disponibles
                  </p>
                </div>

              </div>

              <div class="text-white/55 toggle-icon">
                {i === 0 ? <ChevronUp size={22} /> : <ChevronDown size={22} />}
              </div>

            </button>

            <!-- PRODUCTS -->
            <div
              id={`family-${i}`}
              class={`${i === 0 ? "block" : "hidden"} px-4 pb-5 sm:px-6`}
            >

              <div class="gap-3 sm:gap-6 grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 pt-2">

                {items.map((item) => (
                  <article
  class="group flex flex-col hover:shadow-2xl border rounded-3xl h-full overflow-hidden transition hover:-translate-y-1 duration-300 cursor-pointer product-card"
  style={`border-color:${color}25;background:linear-gradient(145deg,rgba(255,255,255,.04),${color}10);`}
  data-name={item.name}
  data-family={item.family}
  data-type={item.type}
  data-description={item.description}
  data-extra={item.extra || ""}
  data-image={item.image}
  data-public={item.pricePublic || 0}
  data-salon={item.priceSalon || 0}
  data-saving={item.saving || 0}
>

  <!-- IMG -->
  <div class="relative bg-linear-to-br from-zinc-900 via-black to-zinc-900 aspect-square overflow-hidden">

    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.08),transparent_55%)]"></div>

    <img
      src={item.image}
      alt={item.name}
      loading="lazy"
      class="z-10 relative drop-shadow-[0_30px_35px_rgba(0,0,0,.6)] mx-auto mt-6 w-auto h-[72%] object-contain group-hover:scale-110 transition group-hover:-translate-y-2 duration-700"
    />

    {item.tag && (
      <span class="top-3 left-3 absolute bg-white shadow-xl px-3 py-1 rounded-full font-semibold text-[10px] text-black sm:text-xs">
        {item.tag}
      </span>
    )}

  </div>

  <!-- BODY -->

<div class="flex flex-col flex-1 p-4 sm:p-6">

  <p class="mb-2 text-[10px] text-white/30 sm:text-[11px] uppercase tracking-[0.25em]">
    {item.type}
  </p>

  <h3 class="min-h-12 sm:min-h-14 font-medium text-sm sm:text-xl line-clamp-2 leading-snug">
    {item.name}
  </h3>

<div
  class="p-3 border rounded-2xl"
  style={`border-color:${color}25;background:${color}10;`}
>

  {item.pricePublic > 0 ? (
    <p class="text-white/40 text-xs line-through">
      Precio Público ${item.pricePublic}
    </p>
  ) : (
    <p class="text-white/30 text-xs">
      Uso Profesional
    </p>
  )}

  <p class="mt-1 font-bold text-xl">
    ${item.priceSalon || 0}
  </p>

  <p class="text-[11px] text-white/40 uppercase">
    Precio Salón
  </p>

  <p
    class="mt-2 font-medium text-xs"
    style={`color:${color};`}
  >
    Ganancia ${item.saving || 0}
  </p>

</div>

  <!-- EMPUJA BOTÓN HASTA ABAJO -->
  <div class="mt-auto pt-4">

    <button
  class="rounded-2xl w-full h-11 font-semibold text-black hover:scale-[1.02] transition"
  style={`background:${color};`}
>
  Ver detalles
</button>

  </div>

</div>

</article>
                ))}

              </div>

            </div>

          </div>
        );
      })}

    </div>

  </div>

<div
  id="productModal"
  class="hidden z-999 fixed inset-0 justify-center items-center bg-black/80 backdrop-blur-md p-3"
>

  <div
    class="relative bg-black shadow-2xl my-auto border border-white/10 rounded-4xl w-full max-w-xl overflow-hidden text-white"
  >

    <button
      id="closeModal"
      class="top-4 right-4 z-20 absolute flex justify-center items-center bg-white/10 hover:bg-white rounded-full w-11 h-11 hover:text-black text-xl transition"
    >
      ✕
    </button>

    <div class="bg-zinc-900">
      <img
        id="modalImage"
        src=""
        alt=""
        class="w-full h-72 object-contain"
      />
    </div>

    <div class="p-6">

      <p
        id="modalFamily"
        class="text-white/35 text-xs uppercase tracking-[0.25em]"
      ></p>

      <h3
        id="modalTitle"
        class="mt-2 font-semibold text-3xl"
      ></h3>

      <p
        id="modalType"
        class="mt-2 text-white/60"
      ></p>

      <p
        id="modalDesc"
        class="mt-5 text-white/75 text-sm leading-relaxed"
      ></p>

      <p
        id="modalExtra"
        class="mt-3 text-white/45 text-sm leading-relaxed"
      ></p>

      <div class="gap-3 grid grid-cols-3 mt-6">

<div class="bg-white/5 p-3 border border-white/10 rounded-2xl text-center">
  <p class="text-white/40 text-xs">Público</p>

  <p id="pricePublic" class="mt-1 font-semibold"></p>

  <p
    id="noPublicPrice"
    class="hidden mt-1 text-white/35 text-xs"
  >
    Profesional
  </p>
</div>

        <div class="bg-white/5 p-3 border border-white/10 rounded-2xl text-center">
          <p class="text-white/40 text-xs">Salón</p>
          <p id="priceSalon" class="mt-1 font-semibold text-emerald-400"></p>
        </div>

        <div class="bg-white/5 p-3 border border-white/10 rounded-2xl text-center">
          <p class="text-white/40 text-xs">Ganancia</p>
          <p id="priceSaving" class="mt-1 font-semibold"></p>
        </div>

      </div>

    </div>

  </div>

</div>


</section>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {

  const toggles = document.querySelectorAll(".family-toggle");
  const wrappers = document.querySelectorAll('[id^="family-"]');
  const input = document.getElementById("searchInput");

  const clearSearch = document.getElementById("clearSearch");

  const results = document.getElementById("searchResults");
  const families = document.getElementById("searchFamilies");

  const modal = document.getElementById("productModal");
  const closeModal = document.getElementById("closeModal");

  /* =========================
     TOGGLE FAMILIES
  ========================= */

  function closeAll() {
    wrappers.forEach((wrap) => wrap.classList.add("hidden"));

    document.querySelectorAll(".toggle-icon").forEach((icon) => {
      icon.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m6 9 6 6 6-6"/>
        </svg>
      `;
    });
  }

  function openFamilyById(id) {
    const wrap = document.getElementById(id);
    if (!wrap) return;

    wrap.classList.remove("hidden");

    const btn = document.querySelector(`[data-target="${id}"]`);
    const icon = btn?.querySelector(".toggle-icon");

    if (icon) {
      icon.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m18 15-6-6-6 6"/>
        </svg>
      `;
    }
  }

  function updateDefaultState() {
    results.textContent = "Mostrando catálogo completo";
    families.textContent = "Todas las líneas";
  }

  toggles.forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.target;
      const wrap = document.getElementById(id);
      const isOpen = !wrap.classList.contains("hidden");

      closeAll();

      if (!isOpen) openFamilyById(id);
    });
  });

  /* =========================
     PRODUCT MODAL
  ========================= */

  document.querySelectorAll(".product-card").forEach((card) => {

    card.addEventListener("click", () => {

      document.getElementById("modalImage").src = card.dataset.image || "";
      document.getElementById("modalTitle").textContent = card.dataset.name || "";
      document.getElementById("modalFamily").textContent = card.dataset.family || "";
      document.getElementById("modalType").textContent = card.dataset.type || "";
      document.getElementById("modalDesc").textContent = card.dataset.description || "";
      document.getElementById("modalExtra").textContent = card.dataset.extra || "";

      const publicPrice = Number(card.dataset.public || 0);

if (publicPrice > 0) {
  document.getElementById("pricePublic").textContent = "$" + publicPrice;
  document.getElementById("pricePublic").classList.remove("hidden");
  document.getElementById("noPublicPrice").classList.add("hidden");
} else {
  document.getElementById("pricePublic").classList.add("hidden");
  document.getElementById("noPublicPrice").classList.remove("hidden");
}

document.getElementById("priceSalon").textContent =
  "$" + (card.dataset.salon || 0);

document.getElementById("priceSaving").textContent =
  "$" + (card.dataset.saving || 0);
      modal.classList.remove("hidden");
      modal.classList.add("flex");

      document.body.style.overflow = "hidden";

    });

  });

  closeModal?.addEventListener("click", closeModalFn);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModalFn();
  });

  function closeModalFn() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
  }

/* =========================
   SEARCH
========================= */

input?.addEventListener("input", () => {

  const term = input.value.toLowerCase().trim();

  /* botón limpiar */
  if (term.length > 0) {
    clearSearch?.classList.remove("hidden");
    clearSearch?.classList.add("flex");
  } else {
    clearSearch?.classList.add("hidden");
    clearSearch?.classList.remove("flex");
  }

  /* sin texto = reset */
  if (!term) {

    closeAll();
    openFamilyById("family-0");

    document.querySelectorAll(".product-card").forEach((card) => {
      card.style.display = "flex";
    });

    updateDefaultState();
    return;
  }

  closeAll();

  let totalResults = 0;
  let matchedFamilies = [];

  wrappers.forEach((familyWrap) => {

    const cards = familyWrap.querySelectorAll(".product-card");
    let hasMatch = false;

    cards.forEach((card) => {

      const text = card.innerText.toLowerCase();
      const match = text.includes(term);

      card.style.display = match ? "flex" : "none";

      if (match) {
        hasMatch = true;
        totalResults++;
      }

    });

    if (hasMatch) {

      openFamilyById(familyWrap.id);

      const title = document.querySelector(
        `[data-target="${familyWrap.id}"] h2`
      );

      if (title) matchedFamilies.push(title.textContent.trim());

    }

  });

  if (totalResults === 0) {
    results.textContent = "Sin coincidencias";
    families.textContent = "0 líneas";
    return;
  }

  results.textContent =
    totalResults === 1
      ? "1 producto encontrado"
      : `${totalResults} productos encontrados`;

  families.textContent =
    matchedFamilies.length === 1
      ? matchedFamilies[0]
      : `${matchedFamilies.length} líneas`;

});


/* =========================
   CLEAR SEARCH
========================= */

clearSearch?.addEventListener("click", () => {

  input.value = "";
  input.dispatchEvent(new Event("input"));
  input.focus();

});

  updateDefaultState();

});
</script>