---
// src/components/partners/CreditInfo.astro
import {
  CreditCard,
  CalendarClock,
  Wallet,
  BadgePercent,
  CircleDollarSign,
  ShieldCheck,
  Sparkles,
} from "lucide-react";
---

<section id="credito" class="bg-black px-6 py-15 text-white">
  <div class="mx-auto max-w-7xl">
    <!-- HEADER -->
    <div class="items-center gap-14 grid lg:grid-cols-2 mb-16">
      <!-- LEFT -->
      <div>
        <div
          class="inline-flex items-center gap-2 bg-white/5 backdrop-blur-xl mb-6 px-4 py-2 border border-white/10 rounded-full text-sm"
        >
          <CreditCard size={16} className="shrink-0" />
          Crédito de Compra
        </div>

        <h2 class="max-w-3xl font-medium text-4xl md:text-6xl tracking-tight">
          Compra hoy, liquidez para crecer mañana
        </h2>
      </div>

      <!-- RIGHT -->
      <div>
        <p class="text-white/65 text-lg leading-relaxed">
          Nuestro esquema comercial está diseñado para salones y negocios
          profesionales que buscan surtirse sin descapitalizarse.
        </p>

        <p class="mt-5 text-white/65 text-lg leading-relaxed">
          Facilitamos compras recurrentes, mejor flujo de efectivo y crecimiento
          ordenado con atención personalizada.
        </p>

        <p class="mt-5 text-white/45 text-lg leading-relaxed">
          Crédito sujeto a continuidad comercial y buen cumplimiento.
        </p>
      </div>
    </div>

    <!-- GRID -->
    <div class="gap-8 grid lg:grid-cols-3">
      <!-- MAIN -->
      <div
        class="lg:col-span-2 bg-white/5 shadow-2xl backdrop-blur-2xl p-10 border border-white/10 rounded-[2.5rem]"
      >
        <p class="mb-4 text-white/45 text-sm uppercase tracking-[0.25em]">
          Esquema Principal
        </p>

        <h3 class="mb-8 font- text-3xl md:text-5xl">
          50% entrega + 50% a 15 días
        </h3>

        <div class="gap-6 grid md:grid-cols-2">
          <!-- CARD -->
          <div
            class="group relative bg-white shadow-xl hover:shadow-2xl p-6 border border-white/10 rounded-4xl overflow-hidden text-black transition-all hover:-translate-y-1 duration-300"
          >
            <!-- glow -->
            <div
              class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(0,0,0,.06),transparent_52%)] opacity-0 group-hover:opacity-100 blur-xl transition-opacity duration-500"
            >
            </div>

            <!-- content -->
            <div class="z-10 relative">
              <!-- icon -->
              <div
                class="flex justify-center items-center bg-black mb-4 rounded-2xl w-12 h-12 text-white"
              >
                <Wallet size={20} />
              </div>

              <!-- title -->
              <h4 class="mb-2 font-semibold text-lg">
                50% Inicial
              </h4>

              <!-- description -->
              <p class="text-zinc-600 leading-relaxed">
                Se abona al momento de entrega para confirmar la operación.
              </p>
            </div>
          </div>

          <!-- CARD -->
          <div
            class="group relative bg-white/5 hover:bg-white p-6 border border-white/10 hover:border-white/20 rounded-4xl overflow-hidden hover:text-black transition-all hover:-translate-y-1 duration-300"
          >
            <!-- glow -->
            <div
              class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,.12),transparent_52%)] opacity-0 group-hover:opacity-100 blur-xl transition-opacity duration-500"
            >
            </div>

            <!-- content -->
            <div class="z-10 relative">
              <!-- icon -->
              <div
                class="flex justify-center items-center bg-white group-hover:bg-black mb-4 rounded-2xl w-12 h-12 text-black group-hover:text-white transition-all duration-300"
              >
                <CalendarClock size={20} />
              </div>

              <!-- title -->
              <h4
                class="mb-2 font-semibold text-lg transition-colors duration-300"
              >
                15 Días Crédito
              </h4>

              <!-- description -->
              <p
                class="text-white/65 group-hover:text-black/70 leading-relaxed transition-colors duration-300"
              >
                El
                <strong
                  class="text-white group-hover:text-black transition-colors duration-300"
                >
                  50% restante
                </strong>

                se cubre 15 días después de recibir el pedido.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- SIDE -->
      <div class="gap-6 grid">
        <!-- CARD -->
        <div
          class="group relative bg-white/5 hover:bg-white p-7 border border-white/10 hover:border-white/20 rounded-4xl overflow-hidden hover:text-black transition-all hover:-translate-y-1 duration-300"
        >
          <!-- glow -->
          <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,.12),transparent_52%)] opacity-0 group-hover:opacity-100 blur-xl transition-opacity duration-500"
          >
          </div>

          <!-- content -->
          <div class="z-10 relative">
            <!-- icon -->
            <div
              class="flex justify-center items-center bg-white group-hover:bg-black mb-4 rounded-2xl w-12 h-12 text-black group-hover:text-white transition-all duration-300"
            >
              <CircleDollarSign size={20} />
            </div>

            <!-- title -->
            <h4
              class="mb-2 font-semibold text-lg transition-colors duration-300"
            >
              Pedido mínimo
            </h4>

            <!-- description -->
            <p
              class="text-white/65 group-hover:text-black/70 leading-relaxed transition-colors duration-300"
            >
              Desde
              <strong
                class="text-white group-hover:text-black transition-colors duration-300"
              >
                $1,500 MXN
              </strong>

              por solicitud.
            </p>
          </div>
        </div>

        <!-- CARD -->
        <div
          class="group relative bg-white/5 hover:bg-white p-7 border border-white/10 hover:border-white/20 rounded-4xl overflow-hidden hover:text-black transition-all hover:-translate-y-1 duration-300"
        >
          <!-- glow -->
          <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,.12),transparent_52%)] opacity-0 group-hover:opacity-100 blur-xl transition-opacity duration-500"
          >
          </div>

          <!-- content -->
          <div class="z-10 relative">
            <!-- icon -->
            <div
              class="flex justify-center items-center bg-white group-hover:bg-black mb-4 rounded-2xl w-12 h-12 text-black group-hover:text-white transition-all duration-300"
            >
              <BadgePercent size={20} />
            </div>

            <!-- title -->
            <h4
              class="mb-2 font-semibold text-lg transition-colors duration-300"
            >
              Beneficios Plus
            </h4>

            <!-- description -->
            <p
              class="text-white/65 group-hover:text-black/70 leading-relaxed transition-colors duration-300"
            >
              Ventajas comerciales desde compras de

              <strong
                class="text-white group-hover:text-black transition-colors duration-300"
              >
                $10,000 MXN
              </strong>.
            </p>
          </div>
        </div>

        <!-- CARD -->
        <div
          class="group relative hover:bg-white bg-linear-to-br from-white/10 to-white/5 p-7 border border-white/10 hover:border-white/20 rounded-4xl overflow-hidden hover:text-black transition-all hover:-translate-y-1 duration-300"
        >
          <!-- glow -->
          <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,.12),transparent_52%)] opacity-0 group-hover:opacity-100 blur-xl transition-opacity duration-500"
          >
          </div>

          <!-- content -->
          <div class="z-10 relative">
            <!-- icon -->
            <div
              class="flex justify-center items-center bg-white group-hover:bg-black mb-4 rounded-2xl w-12 h-12 text-black group-hover:text-white transition-all duration-300"
            >
              <ShieldCheck size={20} />
            </div>

            <!-- title -->
            <h4
              class="mb-2 font-semibold text-lg transition-colors duration-300"
            >
              Confianza Mutua
            </h4>

            <!-- description -->
            <p
              class="text-white/65 group-hover:text-black/70 leading-relaxed transition-colors duration-300"
            >
              Relación basada en cumplimiento, frecuencia y crecimiento
              conjunto.
            </p>

            <!-- footer -->
            <div
              class="inline-flex items-center gap-2 mt-5 text-white/45 group-hover:text-black/60 text-sm transition-colors duration-300"
            >
              <Sparkles size={15} />
              Atención personalizada
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
