---
// src/components/grow/GrowOnBoarding.astro

import {
  CalendarCheck,
  Sparkles,
  UserPlus,
  PackageCheck,
  ArrowRight
} from "lucide-react";

const steps = [
  {
    icon: CalendarCheck,
    step: "01",
    title: "Agenda una cita",
    text:
      "Conocemos tu salón, necesidades y objetivos para validar el perfil comercial AVYNA."
  },
  {
    icon: Sparkles,
    step: "02",
    title: "Descubre beneficios",
    text:
      "Te mostramos catálogo profesional, precios salón, beneficios y condiciones comerciales."
  },
  {
    icon: UserPlus,
    step: "03",
    title: "Activa tu acceso",
    text:
      "Registramos tu salón dentro del Portal AVYNA para comenzar a trabajar contigo."
  },
  {
    icon: PackageCheck,
    step: "04",
    title: "Realiza tu pedido",
    text:
      "Comienza a comprar productos AVYNA y recibe atención cercana con entregas rápidas."
  }
];
---

<section
  id="como-funciona"
  class="relative bg-black px-6 py-15 overflow-hidden text-white"
>

  <!-- BG -->
  <div class="absolute inset-0 pointer-events-none">

    <div class="top-0 left-0 absolute bg-white/5 blur-3xl rounded-full w-96 h-96"></div>

    <div class="right-0 bottom-0 absolute bg-white/5 blur-3xl rounded-full w-96 h-96"></div>

    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,.05),transparent_35%)]"></div>

  </div>

  <div class="z-10 relative mx-auto max-w-7xl">

    <!-- HEADER -->
    <div class="mx-auto max-w-4xl text-center">

      <div class="inline-flex items-center gap-2 bg-white/5 backdrop-blur-xl px-5 py-2 border border-white/10 rounded-full font-semibold text-sm">
        <Sparkles size={15} />
        Cómo comenzar
      </div>

      <h2 class="mt-6 font-medium text-4xl md:text-6xl">
        Empieza a trabajar
        <span class="block text-zinc-400">
          con AVYNA Grow
        </span>
      </h2>

      <p class="mx-auto mt-3 max-w-2xl text-white/60 text-lg leading-relaxed">
        Un proceso cercano, profesional y diseñado para ayudarte
        a crecer con estructura real.
      </p>

    </div>

    <!-- STEPS -->
    <div class="relative gap-6 grid lg:grid-cols-4 mt-13">

      {steps.map((item, i) => {

        const Icon = item.icon;

        return (

          <div class="relative">

            {/* line desktop */}
            {i !== steps.length - 1 && (
              <div class="hidden lg:block top-16 left-[calc(100%-1rem)] absolute bg-white/10 w-[calc(100%-2rem)] h-px"></div>
            )}

            <article class="group relative bg-white/5 hover:bg-white/8 backdrop-blur-2xl p-7 border border-white/10 hover:border-white/20 rounded-[2.5rem] h-full overflow-hidden transition hover:-translate-y-1 duration-300">

              <!-- glow -->
              <div class="top-0 right-0 absolute bg-white/5 opacity-0 group-hover:opacity-100 blur-3xl rounded-full w-40 h-40 transition duration-500"></div>

              <!-- step -->
              <div class="flex justify-between items-center mb-6">

                <div class="flex justify-center items-center bg-white shadow-xl rounded-2xl w-14 h-14 text-black">
                  <Icon size={22} />
                </div>

                <span class="font-semibold text-white/30 text-sm tracking-[0.25em]">
                  {item.step}
                </span>

              </div>

              <h3 class="font-normal text-2xl">
                {item.title}
              </h3>

              <p class="mt-2 text-white/60 leading-relaxed">
                {item.text}
              </p>

            </article>

          </div>

        );
      })}

    </div>

  </div>

</section>