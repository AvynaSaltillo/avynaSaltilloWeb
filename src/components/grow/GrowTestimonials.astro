---
// src/components/grow/GrowCommunity.astro

import {
  Sparkles,
  BadgeCheck
} from "lucide-react";

const gallery = [
  {
    image: "/images/grow/avyna-salon.jpg",
    title: "Más producto, más ventas",
    subtitle:
      "AVYNA Grow impulsa espacios profesionales con productos premium y recompra constante.",
    featured: true
  },

  {
    image: "/images/grow/avyna-salon-2.jpg",
    title: "Exhibidores Premium",
    subtitle:
      "Presentación profesional para elevar la experiencia del salón."
  },

  {
    image: "/images/grow/avyna-salon-3.jpg",
    title: "Distribución activa",
    subtitle:
      "Pedidos, inventario y movimiento comercial real."
  },

  {
    image: "/images/grow/avyna-salon-4.jpg",
    title: "Comunidad AVYNA",
    subtitle:
      "Negocios creciendo con productos profesionales."
  },

  {
    image: "/images/grow/avyna-salon-5.jpg",
    title: "Salones reales",
    subtitle:
      "Espacios profesionales trabajando junto a AVYNA."
  },

  {
    image: "/images/grow/avyna-salon-6.jpg",
    title: "Presencia real",
    subtitle:
      "Espacios diseñados para impulsar recompra y fidelización."
  },

  {
  image: "/images/grow/avyna-salon-7.jpg",
  title: "Negocios en crecimiento",
  subtitle:
    "Salones impulsando ventas y recompra con productos profesionales AVYNA."
}
];
---

<section
  id="comunidad"
  class="relative bg-black px-4 sm:px-6 py-15 md:py-15 overflow-hidden text-white"
>

  <!-- BG -->
  <div class="absolute inset-0 pointer-events-none">

    <div class="top-0 left-0 absolute bg-white/5 blur-3xl rounded-full w-72 md:w-96 h-72 md:h-96"></div>

    <div class="right-0 bottom-0 absolute bg-white/5 blur-3xl rounded-full w-72 md:w-96 h-72 md:h-96"></div>

    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,.04),transparent_35%)]"></div>

  </div>

  <div class="z-10 relative mx-auto max-w-7xl">

    <!-- HEADER -->
    <div class="mx-auto max-w-4xl text-center">

      <div class="inline-flex items-center gap-2 bg-white/5 backdrop-blur-xl px-4 sm:px-5 py-2 border border-white/10 rounded-full text-xs sm:text-sm">
        <Sparkles size={14} />
        Comunidad AVYNA
      </div>

      <h2 class="mt-6 font-semibold text-3xl sm:text-5xl md:text-6xl tracking-tight">
        Espacios reales
        <span class="block text-zinc-400">
          trabajando con AVYNA
        </span>
      </h2>

      <p class="mx-auto mt-5 max-w-2xl text-white/60 text-base sm:text-lg leading-relaxed">
        Salones, exhibidores y negocios profesionales
        impulsando crecimiento junto a AVYNA Grow.
      </p>

    </div>

    <!-- FEATURED -->
    <div class="mt-5 md:mt-10">

      <article class="group relative bg-white/5 border border-white/10 rounded-4xl sm:rounded-[3rem] overflow-hidden">

        <div class="relative aspect-[4/5] sm:aspect-[16/8] overflow-hidden">

          <img
            src={gallery[0].image}
            alt={gallery[0].title}
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-105 transition duration-700"
          />

          <!-- overlay -->
          <div class="absolute inset-0 bg-linear-to-t from-black via-black/50 to-black/10"></div>

          <!-- badge -->
          <div class="inline-flex top-4 sm:top-6 left-4 sm:left-6 absolute items-center gap-2 bg-black/40 backdrop-blur-xl px-3 sm:px-4 py-2 border border-white/10 rounded-full text-[11px] sm:text-xs">
            <BadgeCheck size={13} />
            AVYNA Grow
          </div>

          <!-- content -->
          <div class="right-0 bottom-0 left-0 absolute p-5 sm:p-8 md:p-12">

            <h3 class="max-w-3xl font-semibold text-2xl sm:text-4xl md:text-5xl leading-tight">
              {gallery[0].title}
            </h3>

            <p class="mt-2 max-w-2xl text-white/70 text-sm sm:text-base md:text-lg leading-relaxed">
              {gallery[0].subtitle}
            </p>

          </div>

        </div>

      </article>

    </div>

    <!-- GRID -->
    <div class="gap-5 grid sm:grid-cols-2 xl:grid-cols-3 mt-6 sm:mt-8">

      {gallery.slice(1).map((item) => (

        <article class="group relative bg-white/5 border border-white/10 hover:border-white/20 rounded-4xl sm:rounded-[2.5rem] overflow-hidden transition hover:-translate-y-1 duration-500">

          <div class="relative aspect-[4/5] sm:aspect-[4/3] overflow-hidden">

            <img
              src={item.image}
              alt={item.title}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-700"
            />

            <!-- overlay -->
            <div class="absolute inset-0 bg-linear-to-t from-black via-black/25 to-transparent"></div>

            <!-- content -->
            <div class="right-0 bottom-0 left-0 absolute p-5 sm:p-6">

              <h3 class="font-semibold text-xl sm:text-2xl">
                {item.title}
              </h3>

              <p class="mt-1 max-w-md text-white/70 text-sm sm:text-base leading-relaxed">
                {item.subtitle}
              </p>

            </div>

          </div>

        </article>

      ))}

    </div>

  </div>

</section>