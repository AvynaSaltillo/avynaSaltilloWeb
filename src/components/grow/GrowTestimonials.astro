---
// src/components/grow/GrowCommunity.astro

import {
  Sparkles,
  BadgeCheck
} from "lucide-react";

const gallery = [
  {
    image: "/images/grow/avyna-salon.jpg",
    title: "Más producto, más ventas",
    subtitle:
      "AVYNA Grow impulsa espacios profesionales con productos premium y recompra constante.",
    featured: true
  },

  {
    image: "/images/grow/avyna-salon-2.jpg",
    title: "Exhibidores Premium",
    subtitle:
      "Presentación profesional para elevar la experiencia del salón."
  },

  {
    image: "/images/grow/avyna-salon-3.jpg",
    title: "Distribución activa",
    subtitle:
      "Pedidos, inventario y movimiento comercial real."
  },

  {
    image: "/images/grow/avyna-salon-4.jpg",
    title: "Comunidad AVYNA",
    subtitle:
      "Negocios creciendo con productos profesionales."
  },

  {
    image: "/images/grow/avyna-salon-5.jpg",
    title: "Salones reales",
    subtitle:
      "Espacios profesionales trabajando junto a AVYNA."
  },

  {
    image: "/images/grow/avyna-salon-6.jpg",
    title: "Presencia real",
    subtitle:
      "Espacios diseñados para impulsar recompra y fidelización."
  },

  {
  image: "/images/grow/avyna-salon-7.jpg",
  title: "Negocios en crecimiento",
  subtitle:
    "Salones impulsando ventas y recompra con productos profesionales AVYNA."
}
];
---

<section
  id="comunidad"
  class="relative overflow-hidden bg-black px-4 py-20 text-white sm:px-6 md:py-24"
>

  <!-- BG -->
  <div class="pointer-events-none absolute inset-0">

    <div class="absolute left-0 top-0 h-72 w-72 rounded-full bg-white/5 blur-3xl md:h-96 md:w-96"></div>

    <div class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-white/5 blur-3xl md:h-96 md:w-96"></div>

    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,.04),transparent_35%)]"></div>

  </div>

  <div class="relative z-10 mx-auto max-w-7xl">

    <!-- HEADER -->
    <div class="mx-auto max-w-4xl text-center">

      <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs backdrop-blur-xl sm:px-5 sm:text-sm">
        <Sparkles size={14} />
        Comunidad AVYNA
      </div>

      <h2 class="mt-6 text-3xl font-bold leading-tight tracking-tight sm:text-5xl md:text-6xl">
        Espacios reales
        <span class="block text-zinc-400">
          trabajando con AVYNA
        </span>
      </h2>

      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-white/60 sm:text-lg">
        Salones, exhibidores y negocios profesionales
        impulsando crecimiento junto a AVYNA Grow.
      </p>

    </div>

    <!-- FEATURED -->
    <div class="mt-14 md:mt-18">

      <article class="group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/5 sm:rounded-[3rem]">

        <div class="relative aspect-[4/5] overflow-hidden sm:aspect-[16/8]">

          <img
            src={gallery[0].image}
            alt={gallery[0].title}
            loading="lazy"
            class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
          />

          <!-- overlay -->
          <div class="absolute inset-0 bg-linear-to-t from-black via-black/50 to-black/10"></div>

          <!-- badge -->
          <div class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-black/40 px-3 py-2 text-[11px] backdrop-blur-xl sm:left-6 sm:top-6 sm:px-4 sm:text-xs">
            <BadgeCheck size={13} />
            AVYNA Grow
          </div>

          <!-- content -->
          <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-8 md:p-12">

            <h3 class="max-w-3xl text-2xl font-bold leading-tight sm:text-4xl md:text-5xl">
              {gallery[0].title}
            </h3>

            <p class="mt-4 max-w-2xl text-sm leading-relaxed text-white/70 sm:text-base md:text-lg">
              {gallery[0].subtitle}
            </p>

          </div>

        </div>

      </article>

    </div>

    <!-- GRID -->
    <div class="mt-6 grid gap-5 sm:mt-8 sm:grid-cols-2 xl:grid-cols-3">

      {gallery.slice(1).map((item) => (

        <article class="group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/5 transition duration-500 hover:-translate-y-1 hover:border-white/20 sm:rounded-[2.5rem]">

          <div class="relative aspect-[4/5] overflow-hidden sm:aspect-[4/3]">

            <img
              src={item.image}
              alt={item.title}
              loading="lazy"
              class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
            />

            <!-- overlay -->
            <div class="absolute inset-0 bg-linear-to-t from-black via-black/25 to-transparent"></div>

            <!-- content -->
            <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6">

              <h3 class="text-xl font-bold sm:text-2xl">
                {item.title}
              </h3>

              <p class="mt-3 max-w-md text-sm leading-relaxed text-white/70 sm:text-base">
                {item.subtitle}
              </p>

            </div>

          </div>

        </article>

      ))}

    </div>

  </div>

</section>