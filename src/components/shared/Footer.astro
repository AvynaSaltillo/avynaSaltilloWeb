---
// src/components/shared/Footer.astro
import {
  Phone,
  Mail,
  MapPin,
  MessageCircle,
  ArrowUpRight,
  Store
} from "lucide-react";

import { FaInstagram } from "react-icons/fa";

import { TbLayoutDashboard } from "react-icons/tb";


const path = Astro.url.pathname;

const isGrow =
  path === "/grow" ||
  path === "/grow/" ||
  path.startsWith("/grow/");

const isCatalog =
  path === "/catalogo" ||
  path === "/catalogo/";

const isDiagnostico =
  path === "/diagnostico" ||
  path === "/diagnostico/";

const isInnerPage = isCatalog || isDiagnostico;

const linkTo = (id: string) => {
  if (isGrow) return `/grow#${id}`;
  if (isInnerPage) return `/#${id}`;
  return `#${id}`;
};

const navItems = isGrow
  ? [
      { label: "Nosotros", href: linkTo("nosotros") },
      { label: "Crédito", href: linkTo("credito") },
      { label: "Club Preferred", href: linkTo("clubPreferred") },
      { label: "Catálogo", href: "/grow/catalogo" },
    ]
  : [
      { label: "Marca", href: linkTo("nosotros") },
      { label: "Beneficios", href: linkTo("beneficios") },
      { label: "Catálogo", href: "/catalogo" },
      { label: "Diagnóstico", href: "/diagnostico" },
      { label: "Salones", href: linkTo("salones") },
      { label: "FAQ", href: linkTo("faq") },
    ];
---

<footer class="relative overflow-hidden border-t border-white/[0.08] bg-black px-4 pb-8 pt-10 text-white sm:px-6 md:pt-15">

  <!-- BG -->
  <div class="pointer-events-none absolute inset-0">

    <div class="absolute left-0 top-0 h-96 w-96 rounded-full bg-white/[0.03] blur-3xl"></div>

    <div class="absolute bottom-0 right-0 h-96 w-96 rounded-full bg-white/[0.03] blur-3xl"></div>

  </div>

  <div class="relative z-10 mx-auto max-w-7xl">

    <!-- TOP -->
    <div class="grid gap-16 lg:grid-cols-[1.4fr_.7fr_.7fr]">

      <!-- BRAND -->
      <div>

        <img
          src="/images/logo-avyna-white.png"
          alt="AVYNA"
          class="h-5 w-auto object-contain sm:h-10"
        />

        <p class="mt-8 max-w-xl text-base leading-relaxed text-white/60 md:text-lg">

          {
            isGrow
              ? "Acceso exclusivo para salones y profesionales que desean crecer junto a AVYNA."
              : "Distribución profesional de productos premium para salones, estilistas y amantes del cuidado capilar."
          }

        </p>

        {
          !isGrow && (
            <a
              href="/grow/login"
              class="mt-8 inline-flex h-13 items-center justify-center rounded-full border border-white/[0.08] bg-white/[0.03] px-7 text-sm font-medium text-white transition duration-300 hover:scale-[1.02]"
            >
              Quiero vender AVYNA
            </a>
          )
        }

      </div>

      <!-- NAV -->
      <div>

        <p class="mb-6 text-sm uppercase tracking-[0.3em] text-white/30">
          Navegación
        </p>

        <ul class="space-y-4 text-white/60">

          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="transition duration-300 hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }

        </ul>

      </div>

      <!-- CONTACT -->
      <div>

        <p class="mb-6 text-sm uppercase tracking-[0.3em] text-white/30">
          Contacto
        </p>

        <ul class="space-y-5 text-white/60">

          <li class="flex items-center gap-3">
            <MapPin size={18} className="shrink-0" />
            Saltillo, Coahuila
          </li>

          <li>
            <a
              href="https://instagram.com/avyna_distribucionsaltillo"
              target="_blank"
              class="flex items-center gap-3 transition duration-300 hover:text-white"
            >
              <FaInstagram size={18} className="shrink-0" />
              @avyna_distribucionsaltillo
            </a>
          </li>

          <li>
            <a
              href="mailto:avyna.saltillo@gmail.com"
              class="flex items-center gap-3 break-all transition duration-300 hover:text-white"
            >
              <Mail size={18} className="shrink-0" />
              avyna.saltillo@gmail.com
            </a>
          </li>

          <li>
            <a
              href="/auth/login"
              class="inline-flex items-center gap-2 rounded-full border border-white/[0.08] px-4 py-2 text-sm transition duration-300 hover:bg-white hover:text-black"
            >
              <TbLayoutDashboard size={16} />
              Portal clientes
            </a>
          </li>

        </ul>

      </div>

    </div>

    <!-- BOTTOM -->
    <div class="mt-16 flex flex-col gap-4 border-t border-white/[0.08] pt-8 text-sm text-white/35 md:flex-row md:items-center md:justify-between">

      <p>
        © 2026 AVYNA Saltillo. Todos los derechos reservados.
      </p>

      <div class="flex flex-wrap items-center gap-5">

        <a
          href="/privacy"
          class="transition duration-300 hover:text-white"
        >
          Privacy Policy
        </a>

        <a
          href="/terms"
          class="transition duration-300 hover:text-white"
        >
          Terms & Conditions
        </a>

      </div>

    </div>

  </div>

</footer>