---
// src/components/shared/Navbar.astro

import { Menu, X } from "lucide-react";
import { BiSolidBadgeDollar } from "react-icons/bi";

const path = Astro.url.pathname;

const isGrow =
  path === "/grow" ||
  path === "/grow/" ||
  path.startsWith("/grow/");

const isCatalog =
  path === "/catalogo" ||
  path === "/catalogo/";

const isDiagnostico =
  path === "/diagnostico" ||
  path === "/diagnostico/";

const isInnerPage =
  isCatalog || isDiagnostico;

const linkTo = (id: string) => {

  if (isGrow) return `/grow#${id}`;

  if (isInnerPage) return `/#${id}`;

  return `#${id}`;
};

const navItems = isGrow
  ? [
      { label: "Nosotros", href: linkTo("nosotros") },
      { label: "Crédito", href: linkTo("credito") },
      { label: "Club Preferred", href: linkTo("clubPreferred") },
      { label: "Catálogo", href: "/grow/catalogo" },
    ]
  : [
      { label: "Marca", href: linkTo("nosotros") },
      { label: "Beneficios", href: linkTo("beneficios") },
      { label: "Catálogo", href: "/catalogo" },
      { label: "Diagnóstico", href: "/diagnostico" },
      { label: "Salones", href: linkTo("salones") },
      { label: "FAQ", href: linkTo("faq") },
    ];
---

<header
  class="
    fixed
    top-0
    inset-x-0
    z-50
    border-b
    border-white/10
    bg-black/80
    backdrop-blur-xl
  "
>

  <div
    class="
      mx-auto
      flex
      h-20
      max-w-7xl
      items-center
      justify-between
      px-4
      md:px-6
    "
  >

    <!-- LOGO -->
    <a
      href={isGrow ? "/grow" : "/"}
      class="flex items-center"
    >

      <div>

        <img
          src="/images/logo-avyna-white.png"
          alt="AVYNA"
          class="h-4 md:h-5 w-auto"
        />

        <p
          class="
            mt-1
            hidden
            text-xs
            text-white/50
            md:block
          "
        >
          {isGrow ? "Crece con AVYNA" : "Saltillo, Coahuila"}
        </p>

      </div>

    </a>

    <!-- DESKTOP NAV -->
    <nav
      class="
        hidden
        items-center
        gap-8
        text-sm
        font-medium
        text-white/75
        lg:flex
      "
    >

      {
        navItems.map(item => (
          <a
            href={item.href}
            class="transition hover:text-white"
          >
            {item.label}
          </a>
        ))
      }

    </nav>

    <!-- RIGHT -->
    <div class="flex items-center gap-3">

      {
        !isGrow && (
          <a
            href="/grow/login"
            class="
              hidden
              md:inline-flex
              h-12
              items-center
              gap-2
              rounded-full
              border
              border-white/10
              bg-white/5
              px-6
              text-sm
              font-semibold
              text-white
              transition
              hover:bg-white
              hover:text-black
            "
          >
            <BiSolidBadgeDollar size={18} />
            Quiero vender AVYNA
          </a>
        )
      }

      <!-- MOBILE BTN -->
      <button
        id="menuBtn"
        class="
          flex
          h-11
          w-11
          items-center
          justify-center
          rounded-2xl
          border
          border-white/10
          bg-white/5
          text-white
          lg:hidden
        "
      >

        <Menu
          id="menuOpen"
          size={18}
        />

        <X
          id="menuClose"
          size={18}
          className="hidden"
        />

      </button>

    </div>

  </div>

</header>

<!-- MOBILE MENU -->
<div
  id="mobileMenu"
  class="
    fixed
    inset-0
    z-40
    overflow-y-auto
    bg-black/95
    backdrop-blur-2xl
    pt-24
    opacity-0
    pointer-events-none
    translate-y-2
    transition-all
    duration-300
    lg:hidden
  "
>

  <div
    id="mobileMenuContent"
    class="
      px-6
      pb-10
      transition-all
      duration-500
      translate-y-6
      opacity-0
    "
  >

    <nav class="flex flex-col">

      {
        navItems.map((item, index) => (
          <a
            href={item.href}
            class="
              mobile-link
              border-b
              border-white/5
              py-5
              text-4xl
              font-bold
              text-white
              opacity-0
              translate-y-4
            "
            style={`transition:
              opacity .45s ease,
              transform .45s ease;
              transition-delay:${index * 80}ms;
            `}
          >
            {item.label}
          </a>
        ))
      }

    </nav>

    {
      !isGrow && (

        <a
          href="/grow/login"
          id="mobileCTA"
          class="
            mt-8
            flex
            h-14
            items-center
            justify-center
            gap-2
            rounded-2xl
            bg-white
            text-sm
            font-semibold
            text-black
            opacity-0
            translate-y-4
            transition-all
            duration-500
          "
        >
          <BiSolidBadgeDollar size={18} />
          Quiero vender AVYNA
        </a>

      )
    }

  </div>

</div>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {

  const btn =
    document.getElementById("menuBtn");

  const menu =
    document.getElementById("mobileMenu");

  const content =
    document.getElementById("mobileMenuContent");

  const links =
    document.querySelectorAll(".mobile-link");

  const cta =
    document.getElementById("mobileCTA");

  const openIcon =
    document.getElementById("menuOpen");

  const closeIcon =
    document.getElementById("menuClose");

  if(
    !btn ||
    !menu ||
    !openIcon ||
    !closeIcon ||
    !content
  ) return;

  let open = false;

  function openMenu(){

    open = true;

    document.body.style.overflow =
      "hidden";

    menu.classList.remove(
      "opacity-0",
      "pointer-events-none",
      "translate-y-2"
    );

    menu.classList.add(
      "opacity-100",
      "pointer-events-auto",
      "translate-y-0"
    );

    setTimeout(()=>{

      content.classList.remove(
        "opacity-0",
        "translate-y-6"
      );

      content.classList.add(
        "opacity-100",
        "translate-y-0"
      );

      links.forEach(link => {

        link.classList.remove(
          "opacity-0",
          "translate-y-4"
        );

        link.classList.add(
          "opacity-100",
          "translate-y-0"
        );

      });

      if(cta){

        cta.classList.remove(
          "opacity-0",
          "translate-y-4"
        );

        cta.classList.add(
          "opacity-100",
          "translate-y-0"
        );

      }

    }, 50);

    openIcon.classList.add("hidden");

    closeIcon.classList.remove("hidden");
  }

  function closeMenu(){

    open = false;

    document.body.style.overflow =
      "";

    content.classList.add(
      "opacity-0",
      "translate-y-6"
    );

    links.forEach(link => {

      link.classList.add(
        "opacity-0",
        "translate-y-4"
      );

      link.classList.remove(
        "opacity-100",
        "translate-y-0"
      );

    });

    if(cta){

      cta.classList.add(
        "opacity-0",
        "translate-y-4"
      );

      cta.classList.remove(
        "opacity-100",
        "translate-y-0"
      );

    }

    setTimeout(()=>{

      menu.classList.add(
        "opacity-0",
        "pointer-events-none",
        "translate-y-2"
      );

      menu.classList.remove(
        "opacity-100",
        "pointer-events-auto",
        "translate-y-0"
      );

    }, 150);

    closeIcon.classList.add("hidden");

    openIcon.classList.remove("hidden");
  }

  btn.addEventListener("click", () => {

    if(open){

      closeMenu();

    }else{

      openMenu();

    }

  });

  links.forEach(link => {

    link.addEventListener(
      "click",
      closeMenu
    );

  });

});
</script>