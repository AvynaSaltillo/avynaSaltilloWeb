---
// src/components/shared/Navbar.astro

import { Menu, X } from "lucide-react";
import { BiSolidBadgeDollar } from "react-icons/bi";

const path = Astro.url.pathname;

const isGrow =
  path === "/grow" ||
  path === "/grow/" ||
  path.startsWith("/grow/");

const isCatalog =
  path === "/catalogo" ||
  path === "/catalogo/";

const isDiagnostico =
  path === "/diagnostico" ||
  path === "/diagnostico/";

const isInnerPage =
  isCatalog || isDiagnostico;

const linkTo = (id: string) => {

  if (isGrow) return `/grow#${id}`;

  if (isInnerPage) return `/#${id}`;

  return `#${id}`;
};

const navItems = isGrow
  ? [
      { label: "Nosotros", href: linkTo("nosotros") },
      { label: "Crédito", href: linkTo("credito") },
      { label: "Club Preferred", href: linkTo("clubPreferred") },
      { label: "Catálogo", href: "/grow/catalogo" },
    ]
  : [
      { label: "Marca", href: linkTo("nosotros") },
      { label: "Beneficios", href: linkTo("beneficios") },
      { label: "Catálogo", href: "/catalogo" },
      { label: "Diagnóstico", href: "/diagnostico" },
      { label: "Salones", href: linkTo("salones") },
      { label: "FAQ", href: linkTo("faq") },
    ];
---

<header
  class="top-0 z-50 fixed inset-x-0 bg-black/80 backdrop-blur-xl border-white/10 border-b"
>

  <div
    class="flex justify-between items-center mx-auto px-4 md:px-6 max-w-7xl h-20"
  >

    <!-- LOGO -->
    <a
      href={isGrow ? "/grow" : "/"}
      class="flex items-center"
    >

      <div>

        <img
          src="/images/logo-avyna-white.png"
          alt="AVYNA"
          class="w-auto h-4 md:h-5"
        />

        <p
          class="hidden md:block mt-1 text-[16px] text-white/50"
        >
          {isGrow ? "Crece con AVYNA" : "Saltillo, Coahuila"}
        </p>

      </div>

    </a>

    <!-- DESKTOP NAV -->
    <nav
      class="hidden lg:flex items-center gap-8 font-medium text-white/75 text-sm"
    >

      {
        navItems.map(item => (
          <a
            href={item.href}
            class="hover:text-white transition"
          >
            {item.label}
          </a>
        ))
      }

    </nav>

<!-- RIGHT -->
<div class="flex items-center gap-3">

  {
    isGrow ? (

      <button
        id="logoutBtn"
        class="hidden md:inline-flex justify-center items-center bg-white/5 hover:bg-white px-6 border border-white/10 rounded-full h-12 font-semibold text-white hover:text-black text-sm transition"
      >
        Cerrar sesión
      </button>

    ) : (

      <a
        href="/grow/login"
        class="hidden md:inline-flex items-center gap-2 bg-white/5 hover:bg-white px-6 border border-white/10 rounded-full h-12 font-semibold text-white hover:text-black text-sm transition"
      >
        <BiSolidBadgeDollar size={18} />
        Quiero vender AVYNA
      </a>

    )
  }

  <!-- MOBILE BTN -->
  <button
    id="menuBtn"
    class="lg:hidden flex justify-center items-center bg-white/5 border border-white/10 rounded-2xl w-11 h-11 text-white"
  >

    <Menu
      id="menuOpen"
      size={18}
    />

    <X
      id="menuClose"
      size={18}
      className="hidden"
    />

  </button>

</div>

  </div>

</header>

<!-- MOBILE MENU -->
<div
  id="mobileMenu"
  class="lg:hidden z-40 fixed inset-0 bg-black/95 opacity-0 backdrop-blur-2xl pt-24 overflow-y-auto transition-all translate-y-2 duration-300 pointer-events-none"
>

  <div
    id="mobileMenuContent"
    class="opacity-0 px-6 pb-10 transition-all translate-y-6 duration-500"
  >

    <nav class="flex flex-col">

      {
        navItems.map((item, index) => (
          <a
            href={item.href}
            class="opacity-0 py-3 border-white/5 border-b font-bold text-white text-xl translate-y-4 mobile-link"
            style={`transition:
              opacity .45s ease,
              transform .45s ease;
              transition-delay:${index * 80}ms;
            `}
          >
            {item.label}
          </a>
        ))
      }

    </nav>

    {
      !isGrow && (

        <a
          href="/grow/login"
          id="mobileCTA"
          class="flex justify-center items-center gap-2 bg-white opacity-0 mt-8 rounded-2xl h-14 font-semibold text-black text-sm transition-all translate-y-4 duration-500"
        >
          <BiSolidBadgeDollar size={18} />
          Quiero vender AVYNA
        </a>

      )
    }

  </div>

</div>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {

  const btn =
    document.getElementById("menuBtn");

  const menu =
    document.getElementById("mobileMenu");

  const content =
    document.getElementById("mobileMenuContent");

  const links =
    document.querySelectorAll(".mobile-link");

  const cta =
    document.getElementById("mobileCTA");

  const openIcon =
    document.getElementById("menuOpen");

  const closeIcon =
    document.getElementById("menuClose");

  if(
    !btn ||
    !menu ||
    !openIcon ||
    !closeIcon ||
    !content
  ) return;

  let open = false;

  function openMenu(){

    open = true;

    document.body.style.overflow =
      "hidden";

    menu.classList.remove(
      "opacity-0",
      "pointer-events-none",
      "translate-y-2"
    );

    menu.classList.add(
      "opacity-100",
      "pointer-events-auto",
      "translate-y-0"
    );

    setTimeout(()=>{

      content.classList.remove(
        "opacity-0",
        "translate-y-6"
      );

      content.classList.add(
        "opacity-100",
        "translate-y-0"
      );

      links.forEach(link => {

        link.classList.remove(
          "opacity-0",
          "translate-y-4"
        );

        link.classList.add(
          "opacity-100",
          "translate-y-0"
        );

      });

      if(cta){

        cta.classList.remove(
          "opacity-0",
          "translate-y-4"
        );

        cta.classList.add(
          "opacity-100",
          "translate-y-0"
        );

      }

    }, 50);

    openIcon.classList.add("hidden");

    closeIcon.classList.remove("hidden");
  }

  function closeMenu(){

    open = false;

    document.body.style.overflow =
      "";

    content.classList.add(
      "opacity-0",
      "translate-y-6"
    );

    links.forEach(link => {

      link.classList.add(
        "opacity-0",
        "translate-y-4"
      );

      link.classList.remove(
        "opacity-100",
        "translate-y-0"
      );

    });

    if(cta){

      cta.classList.add(
        "opacity-0",
        "translate-y-4"
      );

      cta.classList.remove(
        "opacity-100",
        "translate-y-0"
      );

    }

    setTimeout(()=>{

      menu.classList.add(
        "opacity-0",
        "pointer-events-none",
        "translate-y-2"
      );

      menu.classList.remove(
        "opacity-100",
        "pointer-events-auto",
        "translate-y-0"
      );

    }, 150);

    closeIcon.classList.add("hidden");

    openIcon.classList.remove("hidden");
  }

  btn.addEventListener("click", () => {

    if(open){

      closeMenu();

    }else{

      openMenu();

    }

  });

  links.forEach(link => {

    link.addEventListener(
      "click",
      closeMenu
    );

  });

});

const logoutBtn =
  document.getElementById("logoutBtn");

function logout(){

  localStorage.removeItem(
    "avyna_grow_access"
  );

  localStorage.removeItem(
    "avyna_grow_expire"
  );

  window.location.pathname =
    "/grow/login";

}

logoutBtn?.addEventListener(
  "click",
  logout
);
</script>