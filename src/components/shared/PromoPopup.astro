---
// src/components/shared/PromoPopup.astro

interface PromoItem {
  title: string;
  subtitle: string;
  image: string;
  buttonText?: string;
  buttonHref?: string;

  badge?: string;
  status?: string;
}

interface Props {
  items: PromoItem[];
  delay?: number;
  autoClose?: number;
  interval?: number;
}

const {
  items = [],
  delay = 7000,
  autoClose = 10000,
  interval = 45000,
} = Astro.props;
---

<div
  id="promoPopup"
  class="right-5 lg:right-7 bottom-5 lg:bottom-7 z-[999999] fixed opacity-0 w-[92vw] sm:w-full max-w-[340px] transition-all translate-y-6 duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] pointer-events-none"
>
  <!-- STACK BACK -->
  <div
    class="absolute inset-0 bg-white/[0.025] opacity-40 blur-sm rounded-[2rem] translate-x-3 translate-y-3"
  >
  </div>

  <div
    class="absolute inset-0 bg-white/[0.02] border border-white/5 rounded-[2rem] translate-x-[6px] translate-y-[6px]"
  >
  </div>

  <!-- MAIN CARD -->
  <div
    class="group relative bg-black/85 hover:bg-black/90 shadow-[0_30px_100px_rgba(0,0,0,.65)] backdrop-blur-3xl border border-white/10 hover:border-white/15 rounded-[2.2rem] overflow-hidden transition-all duration-500"
  >
    <!-- IMAGE -->
    <div class="relative h-[360px] overflow-hidden">
      <img
        id="promoImage"
        src={items[0]?.image}
        alt=""
        class="w-full h-full object-cover group-hover:scale-[1.025] transition-transform duration-700 ease-out"
      />

      <!-- DARK OVERLAY -->
      <div
        class="absolute inset-0 bg-[linear-gradient(to_top,rgba(0,0,0,.96),rgba(0,0,0,.62),rgba(0,0,0,.18))]"
      >
      </div>

      <!-- TOP LEFT DARK -->
      <div
        class="z-10 absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(0,0,0,.78),transparent_55%)]"
      >
      </div>

      <!-- CINEMATIC GLOW -->
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_bottom,rgba(177,45,11,.18),transparent_60%)] blur-2xl"
      >
      </div>

      <!-- TOP FADE -->
      <div
        class="top-0 absolute inset-x-0 bg-gradient-to-b from-black/75 to-transparent h-32"
      >
      </div>
    </div>

    <!-- CLOSE -->
    <button
      id="promoClose"
      type="button"
      aria-label="Cerrar popup"
      class="top-4 right-4 z-50 absolute flex justify-center items-center bg-black/55 hover:bg-white backdrop-blur-xl border border-white/10 hover:border-white/20 rounded-full w-11 h-11 text-white/80 hover:text-black transition-all duration-300"
    >
      ✕
    </button>

    <!-- CONTENT -->
    <div class="z-20 absolute inset-0 flex flex-col justify-between p-5">
      <!-- TOP -->
      <div class="flex items-center gap-3">
        <!-- BADGE -->
        <div
          id="promoBadge"
          class="inline-flex items-center gap-2 bg-black/35 backdrop-blur-xl px-2.5 py-1 border border-white/10 rounded-full font-semibold text-[10px] text-white/60 uppercase tracking-[0.16em]"
        >
          AVYNA FEATURED
        </div>

        <!-- STATUS -->
        <div
          id="promoStatus"
          class="hidden sm:flex items-center gap-1.5 text-[10px] text-white/38 uppercase tracking-[0.14em]"
        >
          <span
            class="bg-[#B12D0B] shadow-[0_0_12px_rgba(177,45,11,.9)] rounded-full w-1.5 h-1.5"
          ></span>

          Trending
        </div>
      </div>

      <!-- BOTTOM -->
      <div>
        <!-- TITLE -->
        <h3
          id="promoTitle"
          class="mt-16 max-w-[92%] text-[1.55rem] text-white sm:text-[2.2rem] leading-[0.9] tracking-[-0.07em]"
          style="
          font-family:
            'Clash Display',
            'Satoshi',
            sans-serif;
        "
        >
          {items[0]?.title}
        </h3>

        <!-- ACCENT -->
        <div class="bg-[#B12D0B] mt-3 rounded-full w-12 h-[2px]"></div>

        <!-- SUBTITLE -->
        <p
          id="promoSubtitle"
          class="mt-2 max-w-[92%] text-[1rem] text-white/58 leading-[1.15]"
          style="
          font-family:
            'Satoshi',
            'Plus Jakarta Sans',
            sans-serif;
        "
        >
          {items[0]?.subtitle}
        </p>

        <!-- CTA -->
        <a
          id="promoButton"
          href={items[0]?.buttonHref}
          class="group/button relative flex justify-between items-center bg-white/[0.03] hover:bg-white/[0.05] shadow-[inset_0_1px_0_rgba(255,255,255,.04)] backdrop-blur-xl mt-3 px-5 border border-white/10 hover:border-white/20 rounded-[1.4rem] h-14 overflow-hidden font-medium text-white text-sm transition-all duration-300"
        >
          <!-- SHINE -->
          <div
            class="absolute inset-0 bg-[linear-gradient(120deg,transparent,rgba(255,255,255,.05),transparent)] opacity-0 group-hover/button:opacity-100 transition-opacity duration-500"
          >
          </div>

          <span class="z-10 relative">
            {items[0]?.buttonText}
          </span>

          <span
            class="z-10 relative transition-transform group-hover/button:translate-x-1 duration-300"
          >
            →
          </span>
        </a>
      </div>
    </div>
  </div>
</div>

<script
  is:inline
  define:vars={{
    items,
    delay,
    autoClose,
    interval,
  }}
>
  const popup = document.getElementById("promoPopup");

  const closeBtn = document.getElementById("promoClose");

  const image = document.getElementById("promoImage");

  const title = document.getElementById("promoTitle");

  const subtitle = document.getElementById("promoSubtitle");

  const button = document.getElementById("promoButton");

  const badge = document.getElementById("promoBadge");

  const status = document.getElementById("promoStatus");

  let current = 0;

  let autoCloseTimeout;
  let intervalInstance;

  let isVisible = false;
  let isAnimating = false;

  function setPromo(index) {
    const item = items[index];

    if (!item) return;

    image.src = item.image;

    title.textContent = item.title;

    subtitle.textContent = item.subtitle;

    button.href = item.buttonHref || "#";

    button.querySelector("span").textContent = item.buttonText || "Ver más";

    badge.textContent = item.badge || "AVYNA FEATURED";

    status.innerHTML = `
    <span
      class="bg-[#B12D0B] shadow-[0_0_12px_rgba(177,45,11,.9)] rounded-full w-1.5 h-1.5"
    ></span>

    ${item.status || "Trending"}
  `;
  }

  function showPopup() {
    if (!popup || isVisible || isAnimating) return;

    isAnimating = true;

    popup.classList.remove("opacity-0", "translate-y-6", "pointer-events-none");

    popup.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");

    setTimeout(() => {
      isVisible = true;
      isAnimating = false;
    }, 700);
  }

  function hidePopup() {
    if (!popup || !isVisible || isAnimating) return;

    isAnimating = true;

    popup.classList.add("opacity-0", "translate-y-6", "pointer-events-none");

    popup.classList.remove(
      "opacity-100",
      "translate-y-0",
      "pointer-events-auto",
    );

    setTimeout(() => {
      isVisible = false;
      isAnimating = false;
    }, 700);
  }

  function cyclePromo() {
    clearTimeout(autoCloseTimeout);

    current = Math.floor(Math.random() * items.length);

    setPromo(current);

    showPopup();

    autoCloseTimeout = setTimeout(() => {
      hidePopup();
    }, autoClose);
  }

  if (popup && items.length) {
    setTimeout(() => {
      cyclePromo();

      intervalInstance = setInterval(() => {
        if (!isVisible && !isAnimating) {
          cyclePromo();
        }
      }, interval);
    }, delay);
  }

  closeBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    e.stopPropagation();

    clearTimeout(autoCloseTimeout);

    hidePopup();
  });
</script>
