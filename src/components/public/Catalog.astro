---
// src/components/public/Catalog.astro

import { products } from "../../data/products";

import {
  Search,
  ArrowUpRight,
  Sparkles,
  Download,
  X,
  Package,
  Layers3,
  ShieldCheck,
  Star
} from "lucide-react";

const families = [
  "Todos",
  ...new Set(products.map((item) => item.family))
];
---

<section
  id="catalogo"
  class="bg-black px-4 sm:px-6 pt-30 md:pt-36 pb-24 min-h-screen overflow-hidden text-white"
>

  <div class="mx-auto max-w-7xl">

    <!-- HERO -->
    <div class="items-center gap-14 lg:gap-24 grid lg:grid-cols-2 mb-14">

      <!-- LEFT -->
      <div>

        <div class="inline-flex items-center gap-2 bg-white/4 backdrop-blur-xl mb-7 px-5 py-2 border border-white/10 rounded-full text-sm">
          <Sparkles size={15} className="shrink-0" />
          Catálogo Profesional
        </div>

        <h1 class="max-w-3xl font-medium text-4xl sm:text-5xl md:text-6xl leading-[0.88] tracking-[-0.04em]">
          Línea completa
          <span class="block text-zinc-500">
            AVYNA
          </span>
        </h1>

        <p class="mt-7 max-w-xl text-white/60 text-base md:text-lg leading-relaxed">
          Productos italianos profesionales para salón,
          tratamientos premium y líneas especializadas
          para transformar la apariencia del cabello.
        </p>

      </div>

      <!-- RIGHT -->
      <div class="space-y-5">

        <!-- SEARCH -->
        <div class="relative">

          <input
            id="searchInput"
            type="text"
            placeholder="Buscar producto..."
            class="bg-white/3 pr-6 pl-14 border border-white/[0.08] focus:border-white/20 rounded-full outline-none w-full h-16 placeholder:text-white/30 transition"
          />

          <Search
            size={18}
            className="top-1/2 left-5 absolute text-white/35 -translate-y-1/2 pointer-events-none"
          />

        </div>

        <!-- PDF -->
        <a
          href="/catalogos/catalogo_avyna_2025.pdf"
          download
          class="flex justify-center items-center gap-2 bg-white/3 hover:bg-white border border-white/[0.08] rounded-full h-14 font-medium hover:text-black transition"
        >
          <Download size={16} />
          Descargar catálogo PDF
        </a>

      </div>

    </div>

    <!-- FILTERS -->
    <div class="top-18 z-20 sticky mb-12">

      <div class="bg-white/3 backdrop-blur-xl p-3 border border-white/[0.08] rounded-full overflow-x-auto no-scrollbar">

        <div class="flex gap-3 min-w-max">

          {families.map((family, i) => (
            <button
              data-family={family}
              class={`family-btn h-11 whitespace-nowrap rounded-full px-6 text-sm font-medium transition ${
                i === 0
                  ? "bg-white text-black"
                  : "border border-white/[0.08] bg-white/3 hover:bg-white hover:text-black"
              }`}
            >
              {family}
            </button>
          ))}

        </div>

      </div>

    </div>

    <!-- GRID -->
    <div
      id="catalogGrid"
      class="gap-4 sm:gap-8 grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
    >

      {products.map((item) => (

        <article
          class="group relative bg-white/[0.025] hover:bg-white/[0.045] border border-white/[0.06] hover:border-white/12 rounded-4xl overflow-hidden transition hover:-translate-y-1 duration-500 cursor-pointer product-card"
          data-family={item.family}
          data-name={item.name.toLowerCase()}
          data-product={JSON.stringify(item)}
        >

          <!-- IMAGE -->
          <div class="relative bg-linear-to-br from-[#111111] via-black to-black aspect-square overflow-hidden">

            <!-- soft glow -->
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.06),transparent_55%)]"></div>

            <div class="top-[46%] left-1/2 absolute bg-white/6 blur-3xl rounded-full w-32 sm:w-48 h-32 sm:h-48 -translate-x-1/2 -translate-y-1/2"></div>

            <div class="bottom-5 left-1/2 absolute bg-black/70 blur-xl rounded-full w-24 sm:w-32 h-5 -translate-x-1/2"></div>

            <img
              src={item.image}
              alt={item.name}
              loading="lazy"
              class="z-10 relative drop-shadow-[0_30px_35px_rgba(0,0,0,.55)] mx-auto mt-6 w-auto h-[78%] object-contain group-hover:scale-105 transition group-hover:-translate-y-1 duration-700"
            />

            {item.tag && (
              <span class="top-3 left-3 z-20 absolute bg-white shadow-xl px-3 py-1 rounded-full font-semibold text-[10px] text-black sm:text-xs">
                {item.tag}
              </span>
            )}

          </div>

          <!-- CONTENT -->
          <div class="p-4 sm:p-6">

            <p class="mb-2 text-[10px] text-white/30 sm:text-[11px] uppercase tracking-[0.25em]">
              {item.family}
            </p>

            <h3 class="font-medium text-sm sm:text-xl line-clamp-2 leading-tight">
              {item.name}
            </h3>

            <p class="mt-1 text-white/45 text-xs sm:text-sm line-clamp-1">
              {item.type}
            </p>

            <button
              class="flex justify-center items-center gap-2 bg-white mt-5 sm:mt-6 rounded-full w-full h-10 sm:h-11 font-medium text-black text-sm hover:scale-[1.02] transition"
            >
              Ver producto
              <ArrowUpRight size={15} />
            </button>

          </div>

        </article>

      ))}

    </div>

  </div>

  <!-- MODAL -->
  <div
    id="productModal"
    class="hidden z-999 fixed inset-0 justify-center items-end md:items-center bg-black/75 backdrop-blur-md p-2 sm:p-4 overflow-y-auto"
  >

    <div
      id="modalBox"
      class="relative flex flex-col bg-black shadow-2xl border border-white/[0.08] rounded-[2.5rem] w-full max-w-md max-h-[92vh] overflow-hidden text-white"
    >

      <div class="overflow-y-auto">

        <!-- IMAGE -->
        <div class="relative bg-[#0b0b0b] overflow-hidden">

          <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.06),transparent_55%)]"></div>

          <img
            id="modalImage"
            src=""
            alt=""
            class="z-10 relative w-full h-56 sm:h-72 object-contain"
          />

        </div>

        <!-- CONTENT -->
        <div class="relative p-5 sm:p-8">

          <button
            id="closeModal"
            class="top-4 right-4 absolute flex justify-center items-center bg-white/[0.05] hover:bg-white rounded-full w-10 h-10 hover:text-black transition"
          >
            <X size={18} />
          </button>

          <p
            id="modalFamily"
            class="mb-3 text-white/30 text-xs uppercase tracking-[0.35em]"
          ></p>

          <h3
            id="modalTitle"
            class="font-medium text-3xl sm:text-3xl leading-tight"
          ></h3>

          <div class="inline-flex items-center gap-2 bg-white/3 mt-4 px-4 py-2 border border-white/[0.08] rounded-full text-white/70 text-sm">
            <Layers3 size={15} />
            <span id="modalType"></span>
          </div>

          <!-- DESC -->
          <div class="bg-white/3 mt-6 p-5 border border-white/[0.08] rounded-4xl">

            <div class="flex items-center gap-2 mb-3 font-semibold text-sm">
              <Package size={16} />
              Descripción
            </div>

            <p
              id="modalDesc"
              class="text-white/70 text-sm leading-relaxed"
            ></p>

          </div>

          <!-- EXTRA -->
          <div
            id="extraWrap"
            class="hidden bg-white/3 mt-4 p-5 border border-white/[0.08] rounded-4xl"
          >

            <div class="flex items-center gap-2 mb-3 font-semibold text-sm">
              <ShieldCheck size={16} />
              Información Extra
            </div>

            <p
              id="modalExtra"
              class="text-white/70 text-sm leading-relaxed"
            ></p>

          </div>

          <!-- BENEFITS -->
          <div class="gap-3 grid grid-cols-2 mt-4">

            <div class="bg-white/3 p-4 border border-white/[0.08] rounded-[1.5rem] text-sm">

              <div class="flex items-center gap-2 mb-2 font-semibold">
                <Star size={15} />
                Calidad
              </div>

              Profesional

            </div>

            <div class="bg-white/3 p-4 border border-white/[0.08] rounded-[1.5rem] text-sm">

              <div class="flex items-center gap-2 mb-2 font-semibold">
                <Sparkles size={15} />
                Línea
              </div>

              Premium

            </div>

          </div>

          <!-- CLOSE -->
          <div class="mt-6">

            <button
              id="closeBottom"
              class="hover:bg-white border border-white/[0.08] rounded-full w-full h-12 hover:text-black transition"
            >
              Cerrar
            </button>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {

  const buttons = document.querySelectorAll(".family-btn");
  const cards = document.querySelectorAll(".product-card");
  const input = document.getElementById("searchInput");
  const modal = document.getElementById("productModal");

  let currentFamily = "Todos";

  function filterProducts() {

    const term =
      input?.value.toLowerCase().trim() || "";

    cards.forEach((card) => {

      const family =
        (card.dataset.family || "").toLowerCase();

      const name =
        (card.dataset.name || "").toLowerCase();

      const raw = card.dataset.product;

      let desc = "";
      let type = "";
      let extra = "";

      if (raw) {

        const data = JSON.parse(raw);

        desc =
          (data.description || "").toLowerCase();

        type =
          (data.type || "").toLowerCase();

        extra =
          (data.extra || "").toLowerCase();

      }

      const familyMatch =
        currentFamily === "Todos" ||
        card.dataset.family === currentFamily;

      const searchMatch =
        name.includes(term) ||
        family.includes(term) ||
        desc.includes(term) ||
        type.includes(term) ||
        extra.includes(term);

      card.style.display =
        familyMatch && searchMatch
          ? "block"
          : "none";

    });

  }

  buttons.forEach((btn) => {

    btn.addEventListener("click", () => {

      currentFamily =
        btn.dataset.family || "Todos";

      buttons.forEach((b) =>
        b.classList.remove(
          "bg-white",
          "text-black"
        )
      );

      btn.classList.add(
        "bg-white",
        "text-black"
      );

      filterProducts();

    });

  });

  input?.addEventListener(
    "input",
    filterProducts
  );

  const title =
    document.getElementById("modalTitle");

  const familyText =
    document.getElementById("modalFamily");

  const type =
    document.getElementById("modalType");

  const desc =
    document.getElementById("modalDesc");

  const extra =
    document.getElementById("modalExtra");

  const extraWrap =
    document.getElementById("extraWrap");

  const image =
    document.getElementById("modalImage");

  cards.forEach((card) => {

    card.addEventListener("click", () => {

      const raw = card.dataset.product;

      if (!raw) return;

      const data = JSON.parse(raw);

      title.textContent =
        data.name || "";

      familyText.textContent =
        data.family || "";

      type.textContent =
        data.type || "";

      desc.textContent =
        data.description || "";

      if (data.extra?.trim()) {

        extra.textContent =
          data.extra;

        extraWrap.classList.remove("hidden");

      } else {

        extraWrap.classList.add("hidden");

      }

      image.src =
        data.image || "";

      image.alt =
        data.name || "";

      modal.classList.remove("hidden");
      modal.classList.add("flex");

      document.body.style.overflow =
        "hidden";

    });

  });

  function closeModal() {

    modal.classList.add("hidden");

    modal.classList.remove("flex");

    document.body.style.overflow = "";

  }

  document.getElementById("closeModal")
    ?.addEventListener("click", closeModal);

  document.getElementById("closeBottom")
    ?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (e) => {

    if (e.target === modal)
      closeModal();

  });

  document.addEventListener("keydown", (e) => {

    if (e.key === "Escape")
      closeModal();

  });

});
</script>