---
// src/components/public/Catalog.astro

import { products } from "../../data/products";

import {
  Search,
  ArrowUpRight,
  Sparkles,
  Download,
  X,
  Package,
  Layers3,
  ShieldCheck,
  Star
} from "lucide-react";

const families = [
  "Todos",
  ...new Set(products.map((item) => item.family))
];
---

<section
  id="catalogo"
  class="min-h-screen overflow-hidden bg-black px-4 pb-24 pt-30 text-white sm:px-6 md:pt-36"
>

  <div class="mx-auto max-w-7xl">

    <!-- HERO -->
    <div class="mb-14 grid items-center gap-14 lg:grid-cols-2 lg:gap-24">

      <!-- LEFT -->
      <div>

        <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/4 px-5 py-2 text-sm backdrop-blur-xl">
          <Sparkles size={15} className="shrink-0" />
          Catálogo Profesional
        </div>

        <h1 class="max-w-3xl text-5xl font-bold leading-[0.88] tracking-[-0.04em] sm:text-6xl md:text-8xl">
          Línea completa
          <span class="block text-zinc-500">
            AVYNA
          </span>
        </h1>

        <p class="mt-7 max-w-xl text-base leading-relaxed text-white/60 md:text-lg">
          Productos italianos profesionales para salón,
          tratamientos premium y líneas especializadas
          para transformar la apariencia del cabello.
        </p>

      </div>

      <!-- RIGHT -->
      <div class="space-y-5">

        <!-- SEARCH -->
        <div class="relative">

          <input
            id="searchInput"
            type="text"
            placeholder="Buscar producto..."
            class="h-16 w-full rounded-full border border-white/[0.08] bg-white/3 pl-14 pr-6 outline-none transition placeholder:text-white/30 focus:border-white/20"
          />

          <Search
            size={18}
            className="pointer-events-none absolute left-5 top-1/2 -translate-y-1/2 text-white/35"
          />

        </div>

        <!-- PDF -->
        <a
          href="/catalogos/catalogo_avyna_2025.pdf"
          download
          class="flex h-14 items-center justify-center gap-2 rounded-full border border-white/[0.08] bg-white/3 font-medium transition hover:bg-white hover:text-black"
        >
          <Download size={16} />
          Descargar catálogo PDF
        </a>

      </div>

    </div>

    <!-- FILTERS -->
    <div class="sticky top-18 z-20 mb-12">

      <div class="overflow-x-auto rounded-full border border-white/[0.08] bg-white/3 p-3 backdrop-blur-xl no-scrollbar">

        <div class="flex min-w-max gap-3">

          {families.map((family, i) => (
            <button
              data-family={family}
              class={`family-btn h-11 whitespace-nowrap rounded-full px-6 text-sm font-medium transition ${
                i === 0
                  ? "bg-white text-black"
                  : "border border-white/[0.08] bg-white/3 hover:bg-white hover:text-black"
              }`}
            >
              {family}
            </button>
          ))}

        </div>

      </div>

    </div>

    <!-- GRID -->
    <div
      id="catalogGrid"
      class="grid grid-cols-2 gap-4 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3 xl:grid-cols-4"
    >

      {products.map((item) => (

        <article
          class="product-card group relative cursor-pointer overflow-hidden rounded-4xl border border-white/[0.06] bg-white/[0.025] transition duration-500 hover:-translate-y-1 hover:border-white/12 hover:bg-white/[0.045]"
          data-family={item.family}
          data-name={item.name.toLowerCase()}
          data-product={JSON.stringify(item)}
        >

          <!-- IMAGE -->
          <div class="relative aspect-square overflow-hidden bg-linear-to-br from-[#111111] via-black to-black">

            <!-- soft glow -->
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.06),transparent_55%)]"></div>

            <div class="absolute left-1/2 top-[46%] h-32 w-32 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/6 blur-3xl sm:h-48 sm:w-48"></div>

            <div class="absolute bottom-5 left-1/2 h-5 w-24 -translate-x-1/2 rounded-full bg-black/70 blur-xl sm:w-32"></div>

            <img
              src={item.image}
              alt={item.name}
              loading="lazy"
              class="relative z-10 mx-auto mt-6 h-[78%] w-auto object-contain drop-shadow-[0_30px_35px_rgba(0,0,0,.55)] transition duration-700 group-hover:-translate-y-1 group-hover:scale-105"
            />

            {item.tag && (
              <span class="absolute left-3 top-3 z-20 rounded-full bg-white px-3 py-1 text-[10px] font-semibold text-black shadow-xl sm:text-xs">
                {item.tag}
              </span>
            )}

          </div>

          <!-- CONTENT -->
          <div class="p-4 sm:p-6">

            <p class="mb-2 text-[10px] uppercase tracking-[0.25em] text-white/30 sm:text-[11px]">
              {item.family}
            </p>

            <h3 class="line-clamp-2 text-sm font-semibold leading-snug sm:text-xl">
              {item.name}
            </h3>

            <p class="mt-1 line-clamp-1 text-xs text-white/45 sm:text-sm">
              {item.type}
            </p>

            <button
              class="mt-5 flex h-10 w-full items-center justify-center gap-2 rounded-full bg-white text-sm font-medium text-black transition hover:scale-[1.02] sm:mt-6 sm:h-11"
            >
              Ver producto
              <ArrowUpRight size={15} />
            </button>

          </div>

        </article>

      ))}

    </div>

  </div>

  <!-- MODAL -->
  <div
    id="productModal"
    class="fixed inset-0 z-999 hidden items-end justify-center overflow-y-auto bg-black/75 p-2 backdrop-blur-md sm:p-4 md:items-center"
  >

    <div
      id="modalBox"
      class="relative flex max-h-[92vh] w-full max-w-md flex-col overflow-hidden rounded-[2.5rem] border border-white/[0.08] bg-black text-white shadow-2xl"
    >

      <div class="overflow-y-auto">

        <!-- IMAGE -->
        <div class="relative overflow-hidden bg-[#0b0b0b]">

          <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.06),transparent_55%)]"></div>

          <img
            id="modalImage"
            src=""
            alt=""
            class="relative z-10 h-56 w-full object-contain sm:h-72"
          />

        </div>

        <!-- CONTENT -->
        <div class="relative p-5 sm:p-8">

          <button
            id="closeModal"
            class="absolute right-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/[0.05] transition hover:bg-white hover:text-black"
          >
            <X size={18} />
          </button>

          <p
            id="modalFamily"
            class="mb-3 text-xs uppercase tracking-[0.35em] text-white/30"
          ></p>

          <h3
            id="modalTitle"
            class="text-3xl font-bold leading-tight sm:text-4xl"
          ></h3>

          <div class="mt-4 inline-flex items-center gap-2 rounded-full border border-white/[0.08] bg-white/3 px-4 py-2 text-sm text-white/70">
            <Layers3 size={15} />
            <span id="modalType"></span>
          </div>

          <!-- DESC -->
          <div class="mt-6 rounded-4xl border border-white/[0.08] bg-white/3 p-5">

            <div class="mb-3 flex items-center gap-2 text-sm font-semibold">
              <Package size={16} />
              Descripción
            </div>

            <p
              id="modalDesc"
              class="text-sm leading-relaxed text-white/70"
            ></p>

          </div>

          <!-- EXTRA -->
          <div
            id="extraWrap"
            class="mt-4 hidden rounded-4xl border border-white/[0.08] bg-white/3 p-5"
          >

            <div class="mb-3 flex items-center gap-2 text-sm font-semibold">
              <ShieldCheck size={16} />
              Información Extra
            </div>

            <p
              id="modalExtra"
              class="text-sm leading-relaxed text-white/70"
            ></p>

          </div>

          <!-- BENEFITS -->
          <div class="mt-4 grid grid-cols-2 gap-3">

            <div class="rounded-[1.5rem] border border-white/[0.08] bg-white/3 p-4 text-sm">

              <div class="mb-2 flex items-center gap-2 font-semibold">
                <Star size={15} />
                Calidad
              </div>

              Profesional

            </div>

            <div class="rounded-[1.5rem] border border-white/[0.08] bg-white/3 p-4 text-sm">

              <div class="mb-2 flex items-center gap-2 font-semibold">
                <Sparkles size={15} />
                Línea
              </div>

              Premium

            </div>

          </div>

          <!-- CLOSE -->
          <div class="mt-6">

            <button
              id="closeBottom"
              class="h-12 w-full rounded-full border border-white/[0.08] transition hover:bg-white hover:text-black"
            >
              Cerrar
            </button>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {

  const buttons = document.querySelectorAll(".family-btn");
  const cards = document.querySelectorAll(".product-card");
  const input = document.getElementById("searchInput");
  const modal = document.getElementById("productModal");

  let currentFamily = "Todos";

  function filterProducts() {

    const term =
      input?.value.toLowerCase().trim() || "";

    cards.forEach((card) => {

      const family =
        (card.dataset.family || "").toLowerCase();

      const name =
        (card.dataset.name || "").toLowerCase();

      const raw = card.dataset.product;

      let desc = "";
      let type = "";
      let extra = "";

      if (raw) {

        const data = JSON.parse(raw);

        desc =
          (data.description || "").toLowerCase();

        type =
          (data.type || "").toLowerCase();

        extra =
          (data.extra || "").toLowerCase();

      }

      const familyMatch =
        currentFamily === "Todos" ||
        card.dataset.family === currentFamily;

      const searchMatch =
        name.includes(term) ||
        family.includes(term) ||
        desc.includes(term) ||
        type.includes(term) ||
        extra.includes(term);

      card.style.display =
        familyMatch && searchMatch
          ? "block"
          : "none";

    });

  }

  buttons.forEach((btn) => {

    btn.addEventListener("click", () => {

      currentFamily =
        btn.dataset.family || "Todos";

      buttons.forEach((b) =>
        b.classList.remove(
          "bg-white",
          "text-black"
        )
      );

      btn.classList.add(
        "bg-white",
        "text-black"
      );

      filterProducts();

    });

  });

  input?.addEventListener(
    "input",
    filterProducts
  );

  const title =
    document.getElementById("modalTitle");

  const familyText =
    document.getElementById("modalFamily");

  const type =
    document.getElementById("modalType");

  const desc =
    document.getElementById("modalDesc");

  const extra =
    document.getElementById("modalExtra");

  const extraWrap =
    document.getElementById("extraWrap");

  const image =
    document.getElementById("modalImage");

  cards.forEach((card) => {

    card.addEventListener("click", () => {

      const raw = card.dataset.product;

      if (!raw) return;

      const data = JSON.parse(raw);

      title.textContent =
        data.name || "";

      familyText.textContent =
        data.family || "";

      type.textContent =
        data.type || "";

      desc.textContent =
        data.description || "";

      if (data.extra?.trim()) {

        extra.textContent =
          data.extra;

        extraWrap.classList.remove("hidden");

      } else {

        extraWrap.classList.add("hidden");

      }

      image.src =
        data.image || "";

      image.alt =
        data.name || "";

      modal.classList.remove("hidden");
      modal.classList.add("flex");

      document.body.style.overflow =
        "hidden";

    });

  });

  function closeModal() {

    modal.classList.add("hidden");

    modal.classList.remove("flex");

    document.body.style.overflow = "";

  }

  document.getElementById("closeModal")
    ?.addEventListener("click", closeModal);

  document.getElementById("closeBottom")
    ?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (e) => {

    if (e.target === modal)
      closeModal();

  });

  document.addEventListener("keydown", (e) => {

    if (e.key === "Escape")
      closeModal();

  });

});
</script>