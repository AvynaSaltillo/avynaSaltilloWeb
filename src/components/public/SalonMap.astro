---
// src/components/public/SalonMap.astro

import {
  MapPin,
  Search,
  Eye,
  Star,
  Sparkles
} from "lucide-react";

import { 
  FaInstagram,
  FaWhatsapp,
 } from "react-icons/fa";

import { salons } from "../../data/salons.js";

import Mapbox3DMap from "./MapBox3DMap.jsx";
---

<script define:vars={{ salons }}>
  window.AVYNA_SALONS = salons;
</script>

<section
  class="relative bg-black px-4 sm:px-6 py-12 sm:py-15 overflow-hidden text-white"
>
  <!-- BG -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="top-0 left-0 absolute bg-white/6 blur-3xl rounded-full w-96 h-96"
    >
    </div>

    <div
      class="right-0 bottom-0 absolute bg-zinc-300/6 blur-3xl rounded-full w-md h-112"
    >
    </div>

    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,.05),transparent_35%)]"
    >
    </div>
  </div>

  <div class="z-10 relative mx-auto max-w-7xl">
    <!-- HEADER -->
    <div class="mx-auto max-w-4xl text-center">
      <div
        class="inline-flex items-center gap-2 bg-white/5 backdrop-blur-xl px-5 py-2 border border-white/10 rounded-full text-sm reveal"
      >
        <MapPin size={16} />

        Encuentra AVYNA cerca de ti
      </div>

      <h2
        class="mt-6 font-medium text-[2.6rem] sm:text-5xl md:text-6xl tracking-tight delay-1 reveal"
      >
        Salones autorizados

        <span class="block text-gray-400">
          en tu zona
        </span>
      </h2>

      <p
        class="mx-auto mt-3 max-w-2xl text-[15px] text-white/60 sm:text-lg leading-relaxed delay-2 reveal"
      >
        Descubre salones autorizados y espacios seleccionados oficialmente
        por AVYNA para una experiencia profesional.
      </p>
    </div>

    <!-- SEARCH -->
    <div class="mx-auto mt-8 max-w-4xl delay-3 reveal">
      <div
        class="bg-white/4 backdrop-blur-2xl p-3 border border-white/10 rounded-[2rem]"
      >
        <div class="flex md:flex-row flex-col md:items-center gap-3">
          <!-- INPUT -->
          <div class="relative flex-1">
            <Search
              size={18}
              className="top-1/2 left-5 absolute text-white/35 -translate-y-1/2 pointer-events-none"
            />

            <input
              id="salonSearch"
              type="text"
              placeholder="Buscar colonia, calle o salón..."
              class="bg-black/30 pr-5 pl-12 border border-white/10 focus:border-white/25 rounded-full outline-none w-full h-13 sm:h-14 text-white placeholder:text-white/30 transition"
            />
          </div>

          <!-- BUTTON -->
          <button
            id="nearMeBtn"
            type="button"
            class="inline-flex justify-center items-center gap-2 bg-white/6 hover:bg-white px-6 border border-white/10 rounded-full h-13 sm:h-14 font-medium hover:text-black text-sm transition shrink-0"
          >
            <MapPin size={16} />

            Cerca de mí
          </button>
        </div>
      </div>
    </div>

    <!-- GRID -->
    <div
  class="items-stretch gap-6 lg:gap-8 grid lg:grid-cols-[1.08fr_.92fr] mt-10 sm:mt-12"
>
      <!-- MAP -->
      <div
  class="reveal-left bg-white/4 backdrop-blur-2xl p-4 border border-white/10 rounded-4xl h-full"
>
        <div
  class="border border-white/10 rounded-[1.7rem] h-full overflow-hidden"
>
          <div class="h-[758px]">
            <Mapbox3DMap salons={salons as any} client:only="react" />
          </div>
        </div>
      </div>

      <!-- RIGHT SIDE -->
     <div
  class="flex flex-col space-y-4 h-full"
>
        <!-- LIST WRAPPER -->
        <div class="relative">
          <!-- LIST -->
          <div
            id="salonList"
            class="space-y-4 pt-2 pr-2 md:pr-6 pb-2 pl-2 w-full max-h-[720px] overflow-x-visible overflow-y-scroll"
          >
           {
  [...salons]
    .sort((a, b) => {
      if (a.featured && !b.featured) return -1;
      if (!a.featured && b.featured) return 1;

      if (a.level === "select" && b.level !== "select") return -1;
      if (a.level !== "select" && b.level === "select") return 1;

      return (b.stockLevel || 0) - (a.stockLevel || 0);
    })
    .map((salon, i) => (
                <div
                  class={`
                    salon-card
                    delay-${(i % 4) + 1}

                    group

                    relative

                    cursor-pointer

                    rounded-[2rem]

                    border
                    border-white/10

                    bg-white/[0.04]

                    p-3.5
                    sm:p-4

                    backdrop-blur-2xl

                    transition-all
                    duration-500

                    hover:border-white/20
                    hover:bg-white/[0.055]
                  `}
                  data-search={`${salon.name} ${salon.address} ${salon.colony || ""}`.toLowerCase()}
                  data-id={salon.id}
                >
                  <!-- glow -->
                  <div
                    class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,.06),transparent_45%)] opacity-0 group-hover:opacity-100 transition-opacity duration-500"
                  >
                  </div>

                  <div class="z-10 relative">
                    <!-- TOP -->
                    <div
                      class="flex sm:flex-row flex-col gap-3 sm:gap-4"
                    >
                      <!-- IMAGE -->
                      <div class="shrink-0">
                        <img
                          src={salon.image || "/images/salon-placeholder.jpg"}
                          alt={salon.name}
                          class="border border-white/10 rounded-full w-full sm:w-22 h-40 sm:h-22 object-cover"
                        />
                      </div>

                      <!-- INFO -->
                      <div class="flex-1 min-w-0">
                        <!-- BADGE -->
                        {
                          salon.level === "select" ? (
                            <div
                              class="inline-flex items-center gap-2 bg-purple-700/10 px-3 py-1 border border-purple-400/20 rounded-full text-[10px] text-purple-400 sm:text-[11px]"
                            >
                              <Sparkles size={11} />

                              AVYNA Select
                            </div>
                          ) : (
                            <div
                              class="inline-flex items-center gap-2 bg-white/5 px-3 py-1 border border-white/10 rounded-full text-[10px] text-white/55 sm:text-[11px]"
                            >
                              <Star size={11} />

                              AVYNA Partner
                            </div>
                          )
                        }

                        <!-- NAME -->
                        <h3
                          class="mt-3 font-medium text-[1rem] sm:text-[1.05rem] leading-tight"
                        >
                          {salon.name}
                        </h3>

                        <!-- ADDRESS -->
                        <p
                          class="mt-1.5 text-[12px] text-white/58 sm:text-[13px] leading-relaxed"
                        >
                          {salon.address},
                          {salon.colony ? ` ${salon.colony},` : ""}
                          {salon.city}
                        </p>

                        <!-- services -->
                        {
                          (salon.services?.length ?? 0) > 0 && (
                            <div class="flex flex-wrap gap-2 mt-4">
                              {
                                salon.services?.map((item) => (
                                  <span
                                    class="bg-white/5 px-3 py-1 rounded-full text-[10px] text-white/48 sm:text-[11px]"
                                  >
                                    {item}
                                  </span>
                                ))
                              }
                            </div>
                          )
                        }

                        <!-- HORARIO -->
                        <p
                          class="mt-4 text-[12px] text-white/30 sm:text-[13px] leading-relaxed"
                        >
                          {salon.horario}
                        </p>
                      </div>
                    </div>

                    <!-- BUTTONS -->
                    <div
                      class="flex flex-wrap gap-2 mt-4 sm:mt-5"
                    >
                      <!-- VER MAPA -->
                      <button
                        class="inline-flex items-center gap-1.5 bg-white px-3 rounded-full h-9 sm:h-10 font-semibold text-[12px] text-black sm:text-sm transition"
                        onclick={`window.focusSalon(${salon.id})`}
                      >
                        <Eye size={15} />

                        Ver en mapa
                      </button>

                      <!-- MAPS -->
                      {
                        salon.mapsUrl && (
                          <a
                            href={salon.mapsUrl}
                            target="_blank"
                            class="inline-flex items-center gap-1.5 hover:bg-white px-3 border border-white/10 rounded-full h-9 sm:h-10 text-[12px] hover:text-black sm:text-sm transition"
                          >
                            <MapPin size={15} />

                            Abrir Maps
                          </a>
                        )
                      }

                      <!-- WHATSAPP -->
                      {
                        salon.phone && (
                          <button
  type="button"
  onclick={`
    const phone='${String(salon.phone).replace(/\D/g, "")}';

    const text='${encodeURIComponent(
      `Hola, encontré ${salon.name} en AVYNA Saltillo y me gustaría recibir información sobre sus servicios.`
    )}';

    const isMobile =
      /Android|iPhone|iPad|iPod/i.test(
        navigator.userAgent
      );

    const url = isMobile
      ? 'whatsapp://send?phone=' + phone + '&text=' + text
      : 'https://web.whatsapp.com/send?phone=' + phone + '&text=' + text;

    window.open(url, '_blank');
  `}
  class="inline-flex items-center gap-1.5 hover:bg-white px-3 border border-white/10 rounded-full h-9 sm:h-10 text-[12px] hover:text-black sm:text-sm transition hover:cursor-pointer"
>
  <FaWhatsapp size={15} />

  Contactar
</button>
                        )
                      }

                      <!-- INSTAGRAM -->
                      {
                        salon.instagram && (
                          <a
                            href={salon.instagram}
                            target="_blank"
                            class="inline-flex items-center gap-1.5 hover:bg-white px-3 border border-white/10 rounded-full h-9 sm:h-10 text-[12px] hover:text-black sm:text-sm transition"
                          >
                            <FaInstagram size={15} />

                            Instagram
                          </a>
                        )
                      }
                    </div>
                  </div>
                </div>
              ))
            }
          </div>

          <!-- FADE -->
          <div
            id="listFade"
            class="right-4 bottom-0 left-0 absolute bg-linear-to-t from-black via-black/70 to-transparent opacity-100 h-14 transition duration-300 pointer-events-none"
          >
          </div>
        </div>

        <!-- LINE -->
        <div class="bg-white/20 h-px"></div>

        <!-- NOTE -->
        <div
          class="bg-white/4 backdrop-blur-xl p-4 sm:p-5 border border-white/10 rounded-4xl delay-4"
        >
          <p class="text-white/35 text-xs uppercase tracking-[0.28em]">
            Selección AVYNA
          </p>

          <p class="mt-3 text-white/60 text-sm leading-relaxed">
            Los salones destacados mantienen inventario AVYNA, conocimiento
            básico de diagnóstico capilar y estándares seleccionados por
            nuestro equipo.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  window.addEventListener("load", () => {
    const input = document.getElementById("salonSearch");

    const cards = [...document.querySelectorAll(".salon-card")];

    const list = document.getElementById("salonList");

    const fade = document.getElementById("listFade");

    const nearBtn = document.getElementById("nearMeBtn");

    /* SEARCH */

    input?.addEventListener("input", () => {
      const term = input.value.toLowerCase().trim();

      let firstVisible = null;

      cards.forEach((card) => {
        const text = card.dataset.search || "";

        const match = text.includes(term);

        card.style.display = match ? "block" : "none";

        if (match && !firstVisible) {
          firstVisible = card;
        }
      });

      if (firstVisible && term) {
        const id = Number(firstVisible.dataset.id);

        if (window.highlightSalon) {
          window.highlightSalon(id);
        }
      }

      setTimeout(updateFade, 50);
    });

    /* CARD CLICK */

    cards.forEach((card) => {
      card.addEventListener("click", (e) => {
        if (e.target.closest("button") || e.target.closest("a")) return;

        const id = Number(card.dataset.id);

        if (window.highlightSalon) {
          window.highlightSalon(id);
        }
      });
    });

    /* CERCA DE MI */

    nearBtn?.addEventListener("click", () => {
      if (!navigator.geolocation) return;

      nearBtn.innerHTML = "Buscando...";

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const userLat = pos.coords.latitude;

          const userLng = pos.coords.longitude;

          let nearest = null;

          let best = Infinity;

          cards.forEach((card) => {
            const id = Number(card.dataset.id);

            const salon = window.AVYNA_SALONS?.find((s) => s.id === id);

            if (!salon) return;

            const dist = Math.hypot(
              salon.lat - userLat,
              salon.lng - userLng,
            );

            if (dist < best) {
              best = dist;

              nearest = salon;
            }
          });

          if (nearest) {
            window.focusSalon(nearest.id);
          }

          nearBtn.innerHTML = "Cerca de mí";
        },

        () => {
          nearBtn.innerHTML = "Cerca de mí";
        },
      );
    });

    /* FADE */

    function updateFade() {
      if (!list || !fade) return;

      const hasMore =
        list.scrollTop + list.clientHeight < list.scrollHeight - 8;

      fade.style.opacity = hasMore ? "1" : "0";
    }

    updateFade();

    list?.addEventListener("scroll", updateFade);

    window.addEventListener("resize", updateFade);
  });
</script>