---
// src/components/public/SalonMap.astro

import { MapPin, Search, Navigation, Phone, Star } from "lucide-react";

import { salons } from "../../data/salons.js";

import Mapbox3DMap from "./MapBox3DMap.jsx";
---

<script define:vars={{ salons }}>
  window.AVYNA_SALONS = salons;
</script>

<section class="relative bg-black px-6 py-15 overflow-hidden text-white">
  <!-- BG -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="top-0 left-0 absolute bg-white/6 blur-3xl rounded-full w-96 h-96"
    >
    </div>
    <div
      class="right-0 bottom-0 absolute bg-zinc-300/6 blur-3xl rounded-full w-md h-112"
    >
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,.05),transparent_35%)]"
    >
    </div>
  </div>

  <div class="z-10 relative mx-auto max-w-7xl">
    <!-- HEADER -->
    <div class="mx-auto max-w-4xl text-center">
      <div
        class="inline-flex items-center gap-2 bg-white/5 backdrop-blur-xl px-5 py-2 border border-white/10 rounded-full text-sm reveal"
      >
        <MapPin size={16} />
        Encuentra AVYNA cerca de ti
      </div>

      <h2
        class="mt-6 font-medium text-4xl md:text-6xl tracking-tight delay-1 reveal"
      >
        Salones autorizados
        <span class="block text-gray-400"> en tu zona </span>
      </h2>

      <p
        class="mx-auto mt-3 max-w-2xl text-white/60 text-lg leading-relaxed delay-2 reveal"
      >
        Busca por colonia, calle o nombre del salón y descubre dónde comprar
        productos AVYNA.
      </p>
    </div>

    <!-- SEARCH -->
    <div class="mx-auto mt-8 max-w-4xl delay-3 reveal">
      <div
        class="bg-white/4 backdrop-blur-2xl p-3 border border-white/10 rounded-4xl"
      >
        <div class="flex md:flex-row flex-col md:items-center gap-3">
          <!-- INPUT -->
          <div class="relative flex-1">
            <Search
              size={18}
              className="top-1/2 left-5 absolute text-white/35 -translate-y-1/2 pointer-events-none"
            />

            <input
              id="salonSearch"
              type="text"
              placeholder="Buscar colonia, calle o salón..."
              class="bg-black/30 pr-5 pl-12 border border-white/10 focus:border-white/25 rounded-full outline-none w-full h-14 text-white placeholder:text-white/30 transition"
            />
          </div>

          <!-- BUTTON -->
          <button
            id="nearMeBtn"
            type="button"
            class="inline-flex justify-center items-center gap-2 bg-white/6 hover:bg-white px-6 border border-white/10 rounded-full h-14 font-medium hover:text-black text-sm transition shrink-0"
          >
            <MapPin size={16} />
            Cerca de mí
          </button>
        </div>
      </div>
    </div>

    <!-- GRID -->
    <div class="gap-8 grid lg:grid-cols-[1.05fr_.95fr] mt-12">
      <!-- MAP -->
      <div
        class="reveal-left bg-white/4 backdrop-blur-2xl p-4 border border-white/10 rounded-4xl"
      >
        <div class="border border-white/10 rounded-[1.7rem] overflow-hidden">
          <Mapbox3DMap salons={salons as any} client:only="react" />
        </div>
      </div>

      <!-- RIGHT SIDE -->
      <div class="space-y-4">
        <!-- LIST WRAPPER -->
        <div class="relative">
          <!-- LIST -->
          <div
            id="salonList"
            class="space-y-3 pt-2 pr-6 pb-2 pl-2 w-full max-h-138 overflow-x-visible overflow-y-scroll"
          >
            {
              salons.map((salon, i) => (
                <div
                  class={`salon-card delay-${(i % 4) + 1} hover-lift cursor-pointer rounded-4xl border border-white/10 bg-white/4 p-3 backdrop-blur-2xl transition`}
                  data-search={`${salon.name} ${salon.address} ${salon.colony || ""}`.toLowerCase()}
                  data-id={salon.id}
                >
                  <div class="min-w-0">
                    {salon.featured && (
                      <div class="inline-flex items-center gap-2 bg-white/5 px-3 py-1 rounded-full text-[11px] text-white/55">
                        <Star size={11} />
                        Recomendado
                      </div>
                    )}

                    <h3 class="mt-2.5 font-medium text-base">{salon.name}</h3>

                    <p class="mt-0.5 text-[13px] text-white/65">
                      {salon.address}, {salon.colony ? `${salon.colony}, ` : ""}
                      {salon.city}
                    </p>

                    <p class="mt-3.5 text-[14px] text-white/30 leading-tight">
                      {salon.horario}
                    </p>
                  </div>

                  <div class="flex flex-wrap gap-2 mt-3">
                    <button
                      class="inline-flex items-center gap-2 bg-white px-4 rounded-full h-9 font-semibold text-black text-sm"
                      onclick={`window.focusSalon(${salon.id})`}
                    >
                      <Navigation size={15} />
                      Ver mapa
                    </button>

                    {salon.phone && (
                      <a
                        href={`https://wa.me/${salon.phone}`}
                        target="_blank"
                        class="inline-flex items-center gap-2 px-4 border border-white/10 rounded-full h-9 text-sm"
                      >
                        <Phone size={15} />
                        Contactar
                      </a>
                    )}
                  </div>
                </div>
              ))
            }
          </div>

          <!-- FADE SOLO SI HAY MÁS -->
          <div
            id="listFade"
            class="right-4 bottom-0 left-0 absolute bg-linear-to-t from-black via-black/70 to-transparent opacity-100 h-14 transition duration-300 pointer-events-none"
          >
          </div>
        </div>

        <!-- LINEA DELGADA -->
        <div class="bg-white/20 h-px"></div>

        <!-- NOTE -->
        <div
          class="bg-white/4 backdrop-blur-xl p-5 border border-white/10 rounded-4xl delay-4"
        >
          <p class="text-white/35 text-xs uppercase tracking-[0.28em]">
            Recomendación
          </p>

          <p class="mt-3 text-white/60 text-sm leading-relaxed">
            Para mejores resultados visita un salón autorizado. Un estilista
            puede evaluar tu cabello y sugerir la mejor rutina AVYNA.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  window.addEventListener("load", () => {
    const input = document.getElementById("salonSearch");
    const cards = [...document.querySelectorAll(".salon-card")];
    const list = document.getElementById("salonList");
    const fade = document.getElementById("listFade");
    const nearBtn = document.getElementById("nearMeBtn");

    /* ======================= */
    /* SEARCH */
    /* ======================= */

    input?.addEventListener("input", () => {
      const term = input.value.toLowerCase().trim();

      let firstVisible = null;

      cards.forEach((card) => {
        const text = card.dataset.search || "";

        const match = text.includes(term);

        card.style.display = match ? "block" : "none";

        if (match && !firstVisible) {
          firstVisible = card;
        }
      });

      if (firstVisible && term) {
        const id = Number(firstVisible.dataset.id);

        if (window.highlightSalon) {
          window.highlightSalon(id);
        }
      }

      setTimeout(updateFade, 50);
    });

    /* ======================= */
    /* CARD CLICK */
    /* ======================= */

    cards.forEach((card) => {
      card.addEventListener("click", (e) => {
        if (e.target.closest("button") || e.target.closest("a")) return;

        const id = Number(card.dataset.id);

        if (window.highlightSalon) {
          window.highlightSalon(id);
        }
      });
    });

    /* ======================= */
    /* CERCA DE MI */
    /* ======================= */

    nearBtn?.addEventListener("click", () => {
      if (!navigator.geolocation) return;

      nearBtn.innerHTML = "Buscando...";

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const userLat = pos.coords.latitude;

          const userLng = pos.coords.longitude;

          let nearest = null;
          let best = Infinity;

          cards.forEach((card) => {
            const id = Number(card.dataset.id);

            const salon = window.AVYNA_SALONS?.find((s) => s.id === id);

            if (!salon) return;

            const dist = Math.hypot(salon.lat - userLat, salon.lng - userLng);

            if (dist < best) {
              best = dist;
              nearest = salon;
            }
          });

          if (nearest) {
            window.focusSalon(nearest.id);
          }

          nearBtn.innerHTML = "Cerca de mí";
        },
        () => {
          nearBtn.innerHTML = "Cerca de mí";
        },
      );
    });

    /* ======================= */
    /* FADE */
    /* ======================= */

    function updateFade() {
      if (!list || !fade) return;

      const hasMore =
        list.scrollTop + list.clientHeight < list.scrollHeight - 8;

      fade.style.opacity = hasMore ? "1" : "0";
    }

    updateFade();

    list?.addEventListener("scroll", updateFade);

    window.addEventListener("resize", updateFade);
  });
</script>
