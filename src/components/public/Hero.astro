---
import {
  ArrowRight,
  Sparkles,
  BadgeCheck,
  ShieldCheck,
  Gem,
  Sparkle,
} from "lucide-react";
---

<link rel="preconnect" href="https://fonts.googleapis.com" />

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>

<section class="relative bg-black overflow-hidden text-white">
  <!-- LEFT CINEMATIC OVERLAY -->
  <div
    class="absolute inset-0 bg-[linear-gradient(to_right,rgba(0,0,0,.56),rgba(0,0,0,.25),transparent)]"
  >
  </div>

  <!-- BOTTOM OVERLAY -->
  <div
    class="absolute inset-0 bg-[linear-gradient(to_top,rgba(0,0,0,.72),transparent_40%)]"
  >
  </div>

  <!-- PREMIUM GLOW -->
  <div
    class="top-[10%] left-[-10%] absolute bg-white/20 blur-[140px] rounded-full w-[420px] h-[420px]"
  >
  </div>
  <!-- CONTENT -->
  <div class="z-10 relative"></div>
  <!-- CONTENT -->
  <div
    class="z-10 relative items-center gap-14 lg:gap-6 grid lg:grid-cols-[1.05fr_.95fr] mx-auto px-6 pt-20 max-w-7xl"
  >
    <!-- LEFT -->
    <div class="z-20 relative">
      <!-- BADGE -->
      <div
        class="inline-flex items-center gap-2 bg-white/3 backdrop-blur-2xl mt-5 lg:-mt-20 px-5 py-2.5 border border-white/10 rounded-full text-white/80 text-sm"
      >
        <Sparkles size={18} />
        Cabello más sano desde la primera rutina
      </div>

      <!-- TITLE -->
      <h1
        class="mt-8 max-w-3xl font-normal text-[4rem] md:text-[5.6rem] leading-[0.9] tracking-[-0.07em]"
        style="
    
      'Clash Display',
      'Satoshi',
      'Plus Jakarta Sans',
      sans-serif;
  "
      >
        El cabello

        <span class="xs:block text-white"> que sueñas, </span>

        <span
          class="bg-clip-text bg-linear-to-r from-red-200 via-white to-red-200 font-light text-transparent"
        >
          empieza hoy.
        </span>
      </h1>

      <!-- DESCRIPTION -->
      <p
        class="mt-8 max-w-xl text-[1.05rem] text-white/48 md:text-[1.18rem] leading-[1.8]"
        style="
    
      'Plus Jakarta Sans',
      'Inter',
      sans-serif;
  "
      >
        Rutinas inteligentes, brillo espectacular y reparación visible. Descubre
        productos profesionales AVYNA diseñados para elevar tu imagen desde la
        primera aplicación.
      </p>

      <!-- CTA -->
      <div class="flex sm:flex-row flex-col gap-4 mt-10">
        <a
          href="/diagnostico"
          class="inline-flex justify-center items-center gap-2 bg-[#B12D0B] hover:bg-[#c63a15] shadow-[0_10px_40px_rgba(177,45,11,.35)] px-8 rounded-2xl h-14 font-semibold text-white transition-all duration-300"
        >
          Hacer diagnóstico
          <ArrowRight size={18} />
        </a>

        <a
          href="/catalogo"
          class="inline-flex justify-center items-center bg-white/3 hover:bg-white/6 backdrop-blur-xl px-8 border border-white/10 hover:border-white/20 rounded-2xl h-14 font-medium transition-all duration-300"
        >
          Explorar catálogo
        </a>
      </div>

      <!-- TRUST -->
      <div class="flex flex-wrap gap-6 mt-8 text-white/45 text-sm">
        <div class="flex items-center gap-2">
          <BadgeCheck size={18} />
          Uso profesional
        </div>

        <div class="flex items-center gap-2">
          <BadgeCheck size={18} />
          Resultados visibles
        </div>

        <div class="flex items-center gap-2">
          <BadgeCheck size={18} />
          Calidad premium
        </div>
      </div>

      <!-- MOBILE IMAGE -->
      <div class="lg:hidden block relative">
        <div
          class="absolute inset-0 bg-[radial-gradient(circle,rgba(177,45,11,.20),transparent_70%)] blur-3xl"
        >
        </div>

        <img
          src="/images/avyna/hero-model.png"
          class="z-10 relative opacity-[0.98] mx-auto w-full h-[34rem] object-bottom object-contain pointer-events-none select-none"
          style="
            mask-image:
              radial-gradient(
                ellipse at center,
                rgba(0,0,0,1) 48%,
                rgba(0,0,0,.96) 68%,
                rgba(0,0,0,.45) 84%,
    transparent 100%
              );

            -webkit-mask-image:
              radial-gradient(
                ellipse at center,
                rgba(0,0,0,1) 48%,
                rgba(0,0,0,.96) 68%,
                rgba(0,0,0,.45) 84%,
                transparent 100%
              );
          "
          alt="AVYNA Beauty"
        />
      </div>
    </div>

    <!-- RIGHT -->
    <div
      class="hidden relative lg:flex justify-center items-center min-h-170 overflow-hidden"
    >
      <!-- LEFT FADE -->
      <div
        class="left-0 z-20 absolute inset-y-0 bg-linear-to-r from-black via-black/10 to-transparent w-37.5 pointer-events-none"
      >
      </div>

      <!-- RIGHT FADE -->
      <div
        class="right-0 z-20 absolute inset-y-0 bg-linear-to-l from-black via-black/70 to-transparent w-30"
      >
      </div>

      <!-- TOP FADE -->
      <div
        class="top-0 z-20 absolute inset-x-0 bg-linear-to-b from-black via-black/88 to-transparent h-[50px] pointer-events-none"
      >
      </div>

      <!-- BOTTOM FADE -->
      <div
        class="bottom-0 z-20 absolute inset-x-0 bg-linear-to-t from-black via-black/30 to-transparent h-17.5 pointer-events-none"
      >
      </div>

      <!-- IMAGE -->
      <img
        src="/images/avyna/hero-model.png"
        class="-right-1 -bottom-20 z-10 absolute opacity-[1] w-auto max-w-none h-205 object-bottom object-contain rotate-4 scale-x-[-1] pointer-events-none select-none"
        style="
  filter:
    drop-shadow(0 0 18px rgba(120,20,0,.10));

  mask-image:
    linear-gradient(
      to bottom,

      transparent 0%,
      rgba(0,0,0,.55) 10%,
      rgba(0,0,0,.96) 18%,
      rgba(0,0,0,1) 60%,
      rgba(0,0,0,.82) 82%,
      rgba(0,0,0,.35) 92%,
      transparent 100%
    ),

    linear-gradient(
      to left,

      transparent 0%,
      rgba(0,0,0,.12) 8%,
      rgba(0,0,0,.72) 18%,
      rgba(0,0,0,1) 38%
    );

  mask-composite: intersect;

  -webkit-mask-image:
    linear-gradient(
      to bottom,

      transparent 0%,
      rgba(0,0,0,.55) 10%,
      rgba(0,0,0,.96) 18%,
      rgba(0,0,0,1) 60%,
      rgba(0,0,0,.82) 82%,
      rgba(0,0,0,.35) 92%,
      transparent 100%
    ),

    linear-gradient(
      to left,

      transparent 0%,
      rgba(0,0,0,.12) 8%,
      rgba(0,0,0,.72) 18%,
      rgba(0,0,0,1) 38%
    );

  -webkit-mask-composite: source-in;
"
        alt="AVYNA Beauty"
      />
    </div>
  </div>

  <!-- PREMIUM STATS -->
  <div
    class="z-20 relative gap-5 grid grid-cols-1 md:grid-cols-3 mx-auto px-10 pb-10 max-w-7xl"
  >
    <!-- CARD 1 -->
    <div
      class="group relative place-content-center-safe bg-white/2 hover:bg-white/3 backdrop-blur-xl p-5 border border-white/8 hover:border-white/15 rounded-4xl overflow-hidden transition-all duration-300"
    >
      <div
        class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
      >
      </div>

      <div class="z-10 relative flex items-center gap-5">
        <div
          class="flex justify-center items-center bg-white/4 border border-white/10 rounded-2xl w-16 h-16 shrink-0"
        >
          <Sparkle size={26} />
        </div>

        <div class="flex-1">
          <h3 class="font-semibold text-3xl tracking-tight">+30k</h3>

          <p class="mt-1 text-white/50 text-sm leading-relaxed">
            Cabellos transformados con rutinas AVYNA.
          </p>
        </div>
      </div>
    </div>

    <!-- CARD 2 -->
    <div
      class="group relative place-content-center-safe bg-white/2 hover:bg-white/3 backdrop-blur-xl p-5 border border-white/8 hover:border-white/15 rounded-4xl overflow-hidden transition-all duration-300"
    >
      <div
        class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
      >
      </div>

      <div class="z-10 relative flex items-center gap-5">
        <div
