      class="group relative place-content-center-safe bg-white/2 hover:bg-white/3 backdrop-blur-xl p-5 border border-white/8 hover:border-white/15 rounded-4xl overflow-hidden transition-all duration-300"
    >
      <div class="z-10 relative flex items-center gap-5">
        <div
          class="flex justify-center items-center bg-white/4 border border-white/10 rounded-2xl w-16 h-16 shrink-0"
        >
          <ShieldCheck size={26} />
        </div>

        <div class="flex-1">
          <h3 class="font-semibold text-3xl tracking-tight">Cruelty Free</h3>

          <p class="mt-1 text-white/50 text-sm leading-relaxed">
            Sin pruebas animales y cuidado responsable.
          </p>
        </div>
      </div>
    </div>
