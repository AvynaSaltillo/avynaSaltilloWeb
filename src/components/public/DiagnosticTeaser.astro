---
// src/components/public/DiagnosticTeaser.astro

import { Sparkles, ArrowRight, ShieldCheck } from "lucide-react";
---

<section
  id="diagnostico"
  class="relative bg-black px-6 py-20 md:py-15 overflow-hidden text-white"
>
  <!-- BG -->
  <div class="absolute inset-0">
    <div
      class="top-0 left-1/2 absolute bg-white/4 blur-3xl rounded-full w-[500px] h-[500px] -translate-x-1/2"
    >
    </div>

    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,.08),transparent_40%)]"
    >
    </div>
  </div>

  <div class="z-10 relative mx-auto max-w-7xl">
    <div class="items-center gap-16 lg:gap-24 grid lg:grid-cols-[.9fr_1.1fr]">
      <!-- LEFT -->
      <div>
        <div
          class="inline-flex items-center gap-2 bg-white/4 backdrop-blur-xl px-5 py-2 border border-white/10 rounded-full text-white/75 text-sm"
        >
          <Sparkles size={15} />
          Diagnóstico Inteligente AVYNA
        </div>

        <h2
          class="mt-7 max-w-3xl font-semibold text-5xl md:text-7xl leading-[0.9]"
        >
          Descubre la rutina ideal para tu cabello.
        </h2>

        <p
          class="mt-7 max-w-2xl text-white/60 text-base md:text-xl leading-relaxed"
        >
          Analizamos historial químico, hidratación, frizz, calor y estructura
          capilar para recomendar una rutina AVYNA personalizada.
        </p>

        <!-- BENEFITS -->
        <div class="space-y-4 mt-9">
          <div class="flex items-center gap-3 text-white/75">
            <ShieldCheck size={18} className="opacity-70" />
            Diagnóstico visual inteligente
          </div>

          <div class="flex items-center gap-3 text-white/75">
            <ShieldCheck size={18} className="opacity-70" />
            Rutina personalizada según tu perfil
          </div>

          <div class="flex items-center gap-3 text-white/75">
            <ShieldCheck size={18} className="opacity-70" />
            Recomendaciones profesionales AVYNA
          </div>
        </div>

        <!-- CTA -->
        <div class="mt-10">
          <a
            href="/diagnostico"
            class="inline-flex justify-center items-center gap-2 bg-white px-8 rounded-full h-14 font-semibold text-black hover:scale-[1.02] transition animate-pulse duration-300"
          >
            Comenzar diagnóstico
            <ArrowRight size={18} />
          </a>
        </div>
      </div>

      <!-- RIGHT -->
      <div class="relative">
        <!-- glow -->
        <div
          class="top-1/2 left-1/2 absolute bg-white/6 blur-3xl rounded-full w-[420px] h-[420px] -translate-x-1/2 -translate-y-1/2"
        >
        </div>

        <!-- DESKTOP -->
        <div
          class="relative bg-white/3 shadow-[0_30px_80px_rgba(0,0,0,.55)] backdrop-blur-2xl border border-white/10 rounded-[2.8rem] overflow-hidden scale-[1.03]"
        >
          <!-- top bar -->
          <div
            class="flex items-center gap-2 px-5 py-4 border-white/10 border-b"
          >
            <div class="bg-white/30 rounded-full w-2.5 h-2.5"></div>
            <div class="bg-white/20 rounded-full w-2.5 h-2.5"></div>
            <div class="bg-white/10 rounded-full w-2.5 h-2.5"></div>
          </div>

          <img
            src="/images/DiagnosticTeaser.png"
            alt="Diagnóstico AVYNA Desktop"
            class="w-full object-cover"
          />
        </div>

        <!-- MOBILE FLOAT -->
        <div
          class="-right-2 md:-right-6 -bottom-15 absolute bg-black shadow-[0_25px_60px_rgba(0,0,0,.65)] backdrop-blur-2xl border border-white/10 rounded-4xl w-[160px] sm:w-[190px] md:w-[220px] overflow-hidden"
        >
          <!-- notch -->
          <div
            class="top-3 left-1/2 z-20 absolute bg-black/35 rounded-full w-10 h-3 -translate-x-1/2"
          >
          </div>

          <img
            src="/images/DiagnosticTeaser-mobile.png"
            alt="Diagnóstico AVYNA Mobile"
            class="w-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
