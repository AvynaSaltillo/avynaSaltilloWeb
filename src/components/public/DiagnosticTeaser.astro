---
// src/components/public/DiagnosticTeaser.astro

import {
  Sparkles,
  ArrowRight,
  ShieldCheck
} from "lucide-react";
---

<section
  id="diagnostico"
  class="relative overflow-hidden bg-black px-6 py-24 text-white md:py-32"
>

  <!-- BG -->
  <div class="absolute inset-0">

    <div
      class="
        absolute
        left-1/2
        top-0
        h-[500px]
        w-[500px]
        -translate-x-1/2
        rounded-full
        bg-white/[0.04]
        blur-3xl
      "
    ></div>

    <div
      class="
        absolute
        inset-0
        bg-[radial-gradient(circle_at_top,rgba(255,255,255,.08),transparent_40%)]
      "
    ></div>

  </div>

  <div class="relative z-10 mx-auto max-w-7xl">

    <div
      class="
        grid
        items-center
        gap-16
        lg:grid-cols-[.9fr_1.1fr]
        lg:gap-24
      "
    >

      <!-- LEFT -->
      <div>

        <div
          class="
            inline-flex
            items-center
            gap-2
            rounded-full
            border
            border-white/10
            bg-white/[0.04]
            px-5
            py-2
            text-sm
            text-white/75
            backdrop-blur-xl
          "
        >
          <Sparkles size={15} />
          Diagnóstico Inteligente AVYNA
        </div>

        <h2
          class="
            mt-7
            max-w-3xl
            text-5xl
            font-bold
            leading-[0.9]
            tracking-[-0.05em]
            md:text-7xl
          "
        >
          Descubre la rutina ideal para tu cabello.
        </h2>

        <p
          class="
            mt-7
            max-w-2xl
            text-base
            leading-relaxed
            text-white/60
            md:text-xl
          "
        >
          Analizamos historial químico, hidratación,
          frizz, calor y estructura capilar para
          recomendar una rutina AVYNA personalizada.
        </p>

        <!-- BENEFITS -->
        <div class="mt-9 space-y-4">

          <div class="flex items-center gap-3 text-white/75">
            <ShieldCheck size={18} className="opacity-70" />
            Diagnóstico visual inteligente
          </div>

          <div class="flex items-center gap-3 text-white/75">
            <ShieldCheck size={18} className="opacity-70" />
            Rutina personalizada según tu perfil
          </div>

          <div class="flex items-center gap-3 text-white/75">
            <ShieldCheck size={18} className="opacity-70" />
            Recomendaciones profesionales AVYNA
          </div>

        </div>

        <!-- CTA -->
        <div class="mt-10">

          <a
            href="/diagnostico"
            class="
              inline-flex
              h-14
              items-center
              justify-center
              gap-2
              rounded-full
              bg-white
              px-8
              font-semibold
              text-black
              transition
              duration-300
              hover:scale-[1.02]
            "
          >
            Comenzar diagnóstico
            <ArrowRight size={18} />
          </a>

        </div>

      </div>

      <!-- RIGHT -->
      <div class="relative">

        <!-- glow -->
        <div
          class="
            absolute
            left-1/2
            top-1/2
            h-[420px]
            w-[420px]
            -translate-x-1/2
            -translate-y-1/2
            rounded-full
            bg-white/[0.06]
            blur-3xl
          "
        ></div>

        <!-- DESKTOP -->
        <div
          class="
            relative
            overflow-hidden
            rounded-[2.8rem]
            border
            border-white/10
            bg-white/[0.03]
            shadow-[0_30px_80px_rgba(0,0,0,.55)]
            backdrop-blur-2xl
            scale-[1.03]
          "
        >

          <!-- top bar -->
          <div
            class="
              flex
              items-center
              gap-2
              border-b
              border-white/10
              px-5
              py-4
            "
          >

            <div class="h-2.5 w-2.5 rounded-full bg-white/30"></div>
            <div class="h-2.5 w-2.5 rounded-full bg-white/20"></div>
            <div class="h-2.5 w-2.5 rounded-full bg-white/10"></div>

          </div>

          <img
            src="/images/DiagnosticTeaser.png"
            alt="Diagnóstico AVYNA Desktop"
            class="
              w-full
              object-cover
            "
          />

        </div>

        <!-- MOBILE FLOAT -->
        <div
          class="
            absolute
            -bottom-8
            -right-2
            w-[160px]
            overflow-hidden
            rounded-[2rem]
            border
            border-white/10
            bg-black
            shadow-[0_25px_60px_rgba(0,0,0,.65)]
            backdrop-blur-2xl

            sm:w-[190px]
            md:-right-6
            md:w-[220px]
          "
        >

          <!-- notch -->
          <div
            class="
              absolute
              left-1/2
              top-3
              z-20
              h-5
              w-24
              -translate-x-1/2
              rounded-full
              bg-black
            "
          ></div>

          <img
            src="/images/DiagnosticTeaser-mobile.png"
            alt="Diagnóstico AVYNA Mobile"
            class="
              w-full
              object-cover
            "
          />

        </div>

      </div>

    </div>

  </div>

</section>