---
// src/components/public/PublicBanner.astro

const {
  image = "/images/avyna/avyna-banner.gif",
  title = "Cabello espectacular.",
  subtitle = "Resultados visibles desde la primera rutina.",
} = Astro.props;
---

<section class="relative bg-black overflow-hidden">
  <!-- WRAPPER -->
  <div
    class="relative min-h-[420px] sm:min-h-[520px] md:min-h-[620px] lg:min-h-[720px] overflow-hidden"
  >
    <!-- IMAGE -->
    <img
      src={image}
      alt={title}
      loading="lazy"
      class="absolute inset-0 w-full h-full object-[center_28%] object-cover"
    />

    <!-- LEFT CINEMATIC OVERLAY -->
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,rgba(0,0,0,.86),rgba(0,0,0,.45),transparent)]"
    >
    </div>

    <!-- BOTTOM OVERLAY -->
    <div
      class="absolute inset-0 bg-[linear-gradient(to_top,rgba(0,0,0,.72),transparent_40%)]"
    >
    </div>

    <!-- PREMIUM GLOW -->
    <div
      class="top-[10%] left-[-10%] absolute bg-white/20 blur-[140px] rounded-full w-[420px] h-[420px]"
    >
    </div>

    <!-- DESKTOP CONTENT -->
    <div class="hidden z-10 absolute inset-0 lg:flex items-end">
      <div class="mx-auto px-4 pb-10 w-full max-w-7xl">
        <div class="max-w-2xl">
          <h2
            class="font-normal text-white text-6xl leading-none tracking-[-0.045em]"
          >
            {title}
          </h2>

          <p class="mt-6 max-w-xl text-white/70 text-lg leading-relaxed">
            {subtitle}
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- MOBILE CONTENT -->
  <div class="lg:hidden z-20 relative bg-black px-6 py-8">
    <div class="mx-auto max-w-xl">
      <h2
        class="font-semibold text-white text-4xl leading-[0.98] tracking-[-0.06em]"
      >
        {title}
      </h2>

      <p class="mt-4 text-white/65 text-base leading-relaxed">
        {subtitle}
      </p>
    </div>
  </div>
</section>
