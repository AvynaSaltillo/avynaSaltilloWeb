---
// src/components/public/PublicBanner.astro

const {
  image = "/images/avyna/avyna-banner.gif",
  title = "Cabello espectacular.",
  subtitle = "Resultados visibles desde la primera rutina."
} = Astro.props;
---

<section class="relative overflow-hidden bg-black">

  <div class="w-full px-0"></div>

    <div class="relative overflow-hidden rounded-none  border border-white/10 bg-white/[0.03]">

      <!-- IMAGE -->
      <div
  class="
    relative
    min-h-[420px]
    overflow-hidden

    sm:min-h-[500px]
    md:min-h-[460px]
    lg:min-h-[520px]
  "
>

        <img
          src={image}
          alt={title}
          loading="lazy"
          class="h-full w-full object-cover object-[center_28%]"
        />

        <!-- overlays -->
        <div class="absolute inset-0 bg-linear-to-r from-black/70 via-black/20 to-black/30"></div>

        <div class="absolute inset-0 bg-linear-to-t from-black/50 to-transparent"></div>

        <!-- content -->
        <div class="absolute inset-0 flex items-end pb-8 md:pb-0">

          <div
  class="
   max-w-[85%]
p-5

sm:max-w-md
sm:p-8

md:max-w-2xl
md:p-12
  "
>

            <h2 class="mt-4 text-3xl font-bold leading-[1.05] sm:text-4xl md:text-5xl">
              {title}
            </h2>

            <p class="mt-4 max-w-xl max-w-md text-sm leading-relaxed text-white/70 sm:text-base md:max-w-xl md:text-lg">
              {subtitle}
            </p>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>