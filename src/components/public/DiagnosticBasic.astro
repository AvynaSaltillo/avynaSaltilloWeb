---
// src/components/Diagnostic.astro

import { products } from "../../data/products";
import { questions } from "../../data/diagnostic";
import { Sparkles, Users, User, ShieldCheck } from "lucide-react";

const productsJSON = JSON.stringify(products);
const questionsJSON = JSON.stringify(questions);
---

<section
  id="diagnostico"
  class="relative bg-black px-6 py-24 overflow-hidden text-white"
>
  <!-- BG -->
  <div class="absolute inset-0">
    <div
      class="top-0 -left-40 absolute bg-white/5 blur-3xl rounded-full w-96 h-96"
    >
    </div>
    <div
      class="-right-40 bottom-0 absolute bg-white/5 blur-3xl rounded-full w-96 h-96"
    >
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.08),transparent_45%)]"
    >
    </div>
  </div>

  <div class="z-10 relative mx-auto max-w-7xl">
    <!-- HEADER -->
    <div class="text-center">
      <div
        class="inline-flex items-center gap-2 bg-white/5 backdrop-blur-xl mb-6 px-5 py-2 border border-white/10 rounded-full text-sm"
      >
        <Sparkles size={15} />
        Diagnóstico Inteligente AVYNA
      </div>

      <h2
        class="mx-auto max-w-5xl font-normal text-5xl md:text-5xl leading-[0.92] tracking-[-0.06em]"
      >
        Descubre la rutina ideal para
        <span class="block text-zinc-500"> tu cabello </span>
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-white/60 text-lg leading-relaxed">
        Diagnóstico profesional basado en estructura capilar, historial químico
        y necesidades reales.
      </p>
    </div>

    <!-- APP -->
    <div
      id="diagApp"
      class="bg-white/3 shadow-2xl backdrop-blur-2xl mt-10 p-5 md:p-10 border border-white/10 rounded-4xl"
    >
    </div>
  </div>
</section>

<style is:global>
  /* ===============================
   MODE SELECTOR
================================ */

  .mode-btn {
    height: 58px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;

    font-weight: 700;
    font-size: 0.96rem;

    color: rgba(255, 255, 255, 0.68);
    background: transparent;

    transition:
      background 0.22s ease,
      color 0.22s ease,
      transform 0.22s ease,
      box-shadow 0.22s ease;
  }

  /* hover oscuro, no blanco */
  .mode-btn:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-1px);
  }

  /* activo */
  .activeMode {
    background: #fff !important;
    color: #000 !important;
    box-shadow: 0 10px 26px rgba(255, 255, 255, 0.12);
  }

  /* íconos dentro de botón */
  .mode-btn svg {
    width: 17px;
    height: 17px;
    opacity: 0.9;
  }

  /* cuando activo */
  .activeMode svg {
    color: #000;
    opacity: 1;
  }

  /* ===============================
   OPTION CARDS
================================ */

  .optionCard {
    position: relative;
    min-height: 100px;
    padding: 10px 22px;

    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.06);

    background:
      radial-gradient(
        circle at 85% 70%,
        rgba(255, 255, 255, 0.03),
        transparent 30%
      ),
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.018),
        rgba(255, 255, 255, 0.008)
      );

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 10px;

    text-align: left;
    cursor: pointer;

    transition:
      transform 0.22s ease,
      background 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
  }

  /* hover sutil */
  .optionCard:hover {
    transform: translateY(-2px);

    background:
      radial-gradient(
        circle at 85% 70%,
        rgba(255, 255, 255, 0.045),
        transparent 32%
      ),
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.026),
        rgba(255, 255, 255, 0.012)
      );
  }

  /* activo */
  .optionActive {
    border-color: rgba(255, 255, 255, 0.92);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.85),
      0 14px 34px rgba(0, 0, 0, 0.28);
  }

  /* sin hover exagerado cuando activo */
  .optionActive:hover {
    transform: none;
  }

  /* icon + title row */
  .optionHead {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* SOLO ICONO */
  .optionIcon {
    width: 25px;
    height: 25px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: rgba(255, 255, 255, 0.92);
    flex-shrink: 0;
  }

  /* svg */
  .optionIcon svg {
    width: 25px;
    height: 25px;
    stroke: currentColor;
  }

  /* title */
  .optionTitle {
    font-size: 1.42rem;
    line-height: 1;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: #fff;
  }

  /* subtitle */
  .optionMeta {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.42);
    margin-left: 32px;
  }

  /* seleccionado */
  .optionActive .optionMeta {
    color: rgba(255, 255, 255, 0.72);
  }

  .optionActive::after {
    content: "✓";
    position: absolute;
    top: 12px;
    right: 12px;

    width: 35px;
    height: 35px;
    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #fff;
    color: #000;
    font-size: 0.82rem;
    font-weight: 900;
  }

  /* disabled */
  .optionCard:disabled,
  .optionCard[disabled] {
    opacity: 0.3;
    pointer-events: none;
    filter: grayscale(1);
  }

  /* mobile */
  @media (max-width: 640px) {
    .optionCard {
      min-height: 118px;
      padding: 18px 18px;
      border-radius: 22px;
    }

    .optionTitle {
      font-size: 1.18rem;
    }

    .optionMeta {
      font-size: 0.92rem;
      margin-left: 30px;
    }

    .optionCheck {
      width: 30px;
      height: 30px;
      top: 12px;
      right: 12px;
    }
  }

  /* ===============================
   VARIANT BUTTONS
================================ */

  .variantBtn {
    min-width: 68px;
    height: 38px;
    padding: 0 14px;

    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);

    background: rgba(255, 255, 255, 0.025);
    color: rgba(255, 255, 255, 0.75);

    font-size: 0.8rem;
    font-weight: 700;

    transition: 0.22s ease;
  }

  .variantBtn:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
  }

  .variantActive {
    background: #fff;
    color: #000;
    border-color: #fff;
  }

  /* ===============================
   RESULT CARD
================================ */

  .resultCard {
    overflow: hidden;
    border-radius: 26px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.025);
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      background 0.3s ease;
  }

  .resultCard:hover {
    transform: translateY(-4px);

    border-color: rgba(255, 255, 255, 0.16);

    background: rgba(255, 255, 255, 0.04);
  }

  /* ===============================
   MOBILE
================================ */

  @media (max-width: 640px) {
    .mode-btn {
      height: 52px;
      font-size: 0.88rem;
    }

    .optionCard {
      min-height: 95px;
      padding: 14px;
      border-radius: 20px;
    }

    .optionCard .text-xl {
      font-size: 0.94rem !important;
    }

    .optionCard .text-sm {
      font-size: 0.76rem !important;
    }
  }
</style>

<script
  is:inline
  define:vars={{
    productsJSON,
    questionsJSON,
  }}
>
  const products = JSON.parse(productsJSON);
  const questions = JSON.parse(questionsJSON);

  const app = document.getElementById("diagApp");

  let mode = "client";
  let step = 0;
  let answers = {};

  function slug(t = "") {
    return t
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "");
  }

  function currentSteps() {
    return (questions[mode] || []).filter((q) => {
      /* ======================
         NO CONDICIONAL
      ====================== */

      if (!q.conditional) {
        return true;
      }

      /* ======================
         SOLO NO LACIO
      ====================== */

      if (q.conditional === "non_lacio") {
        const hair = answers.hairType?.[0];

        return hair && hair !== "lacio";
      }

      return true;
    });
  }

  function progress() {
    const steps = currentSteps();

    const total = steps.length;

    let completed = 0;

    steps.forEach((q, index) => {
      const selected = answers[q.id] || [];

      if (selected.length > 0) {
        completed++;
      }
    });

    return Math.min(100, (completed / total) * 100);
  }

  function render() {
    const q = currentSteps()[step];

    if (!q) {
      renderResults();
      return;
    }

    const selected = answers[q.id] || [];

    app.innerHTML = `
    <div class="mb-8">

      <div class="flex justify-between items-center mb-3 text-white/45 text-sm">
        <span>Paso ${step + 1} de ${currentSteps().length}</span>
        <span>${Math.round(progress())}%</span>
      </div>

      <div class="bg-white/5 rounded-full h-2 overflow-hidden">
        <div
          class="bg-[linear-gradient(to_right,#fff,rgba(255,255,255,.72))] shadow-[0_0_18px_rgba(255,255,255,.18)] h-full transition-all duration-500"
          style="width:${progress()}%"
        ></div>
      </div>

    </div>

    <div class="gap-10 grid lg:grid-cols-[1.1fr_.9fr]">

      <!-- LEFT -->
      <div>

        <h3 class="font-medium text-3xl md:text-5xl leading-tight">
          ${q.title}
        </h3>

        <p class="mt-4 text-white/50">
          ${
            q.multi
              ? `Selecciona mínimo 1 y máximo ${q.max || 2}`
              : `Selecciona una opción`
          }
        </p>

        <div class="gap-4 grid sm:grid-cols-2 mt-8">

${q.options
  .map((opt) => {
    const active = selected.includes(opt.value);

    const isChemical = q.id === "chemical";

    const hasOtherChem = selected.some((v) => v !== "virgen");

    const disableVirgin = isChemical && opt.value === "virgen" && hasOtherChem;

    const disableOthers =
      isChemical && opt.value !== "virgen" && selected.includes("virgen");

    const disabled = disableVirgin || disableOthers;

    return `
<button
  type="button"
  data-value="${opt.value}"
  ${disabled ? "disabled" : ""}
  class="
    optionCard
    ${active ? "optionActive" : ""}
    ${disabled ? "optionDisabled" : ""}
  "
>

  <div class="optionGlow"></div>

  <div class="optionTop">
    ${
      active
        ? `
      <div class="optionCheck">
      </div>
      `
        : ``
    }

  </div>

  <div class="optionBody">

    <h4 class="font-normal tracking-[0.1em] optionTitle">
      ${opt.label}
    </h4>

    <p class="opacity-35 optionSub">
      ${
        disabled
          ? "No disponible"
          : active
            ? "Seleccionado"
            : "Toca para elegir"
      }
    </p>

  </div>

</button>
`;
  })
  .join("")}

        </div>

        <div class="flex flex-wrap gap-3 mt-8">

          ${
            step > 0
              ? `
            <button
              id="backBtn"
              class="hover:bg-white px-6 border border-white/10 rounded-2xl h-12 hover:text-black transition"
            >
              ← Anterior
            </button>
            `
              : ""
          }

          <button
            id="nextBtn"
            class="bg-white px-7 rounded-2xl h-12 font-semibold text-black hover:scale-[1.02] transition"
          >
            ${
              step === currentSteps().length - 1
                ? "Ver diagnóstico ✨"
                : "Continuar →"
            }
          </button>

        </div>

      </div>

      <!-- RIGHT -->
      <div class="bg-white/[0.05] p-6 border border-white/10 rounded-4xl">
  <p class="font-semibold text-white/80 text-sm">
    Perfil detectado
  </p>
<div class="bg-black/40 mt-3 p-5 border border-white/10 rounded-2xl">



  <div class="flex flex-wrap gap-2 mt-1">

    ${
      Object.values(answers).flat().length
        ? Object.entries(answers)

            .flatMap(([questionId, values]) => {
              const question = currentSteps().find((q) => q.id === questionId);

              if (!question) return [];

              return values.map((value) => {
                const option = question.options.find(
                  (opt) => opt.value === value,
                );

                const cleanTitle = question.title
                  .replace("¿", "")
                  .replace("?", "")
                  .replace("...", "")
                  .trim();

                return `${cleanTitle}: ${option?.label || value}`;
              });
            })

            .map(
              (label) => `

          <span
            class="inline-flex items-center bg-white/4 backdrop-blur-xl px-3.5 py-1.5 border border-white/10 rounded-full font-medium text-white/75 text-xs tracking-wide"
          >
            ${label}
          </span>

        `,
            )

            .join("")
        : `
        <span class="text-white/35 text-sm">
          Sin respuestas aún
        </span>
      `
    }

  </div>

</div>

      </div>

    </div>
  `;

    document.querySelectorAll(".optionCard").forEach((btn) => {
      btn.onclick = () => {
        const val = btn.dataset.value;

        /* =========================
       MULTI OPCIONES
    ========================= */

        if (q.multi) {
          if (!answers[q.id]) {
            answers[q.id] = [];
          }

          let arr = [...answers[q.id]];

          const isChemical = q.id === "chemical";

          const isVirgin = val === "virgen";

          const selected = arr.includes(val);

          /* toggle off */
          if (selected) {
            arr = arr.filter((x) => x !== val);
          } else {
            /* =========================
           HISTORIAL QUIMICO LOGICA
        ========================= */

            if (isChemical) {
              // si selecciona "sin procesos"
              if (isVirgin) {
                arr = ["virgen"];
              } else {
                // quitar virgen
                arr = arr.filter((x) => x !== "virgen");

                if (arr.length < (q.max || 2)) {
                  arr.push(val);
                }
              }
            } else {
              if (arr.length < (q.max || 2)) {
                arr.push(val);
              }
            }
          }

          answers[q.id] = arr;
        } else {
          /* =========================
       SINGLE
    ========================= */
          answers[q.id] = [val];
        }

        render();
      };
    });

    document.getElementById("backBtn")?.addEventListener("click", () => {
      if (step > 0) {
        step--;
        render();
      }
    });

    document.getElementById("nextBtn")?.addEventListener("click", () => {
      const current = currentSteps()[step];

      if (!current) {
        try {
          renderResults();
        } catch (err) {
          console.error(err);
        }
        return;
      }

      const selectedNow = answers[current.id] || [];

      const count = selectedNow.length;

      if (current.multi && count < 1) {
        alert("Selecciona al menos una opción.");

        return;
      }

      if (!current.multi && count !== 1) {
        alert("Selecciona una opción.");

        return;
      }

      step++;

      if (step >= currentSteps().length) {
        renderResults();
        return;
      }

      render();
    });
  }

  /* =========================
   LOGICA NUEVA REAL
========================= */

  function has(val) {
    const all = Object.values(answers).flat().map(slug);
    return all.includes(slug(val));
  }

  function pick(text) {
    return products.find((p) => slug(p.name).includes(slug(text)));
  }

  function add(list, item) {
    if (!item) return;
    if (list.find((x) => x.id === item.id)) return;
    list.push(item);
  }

  function buildRecommendations() {
    const all = Object.values(answers).flat().map(slug);

    const has = (v) => all.includes(slug(v));

    const usesHeat = !has("sincalor");

    const rec = [];

    const pick = (text) => {
      const search = slug(text).replace(/[-\s]/g, "");

      const allMatches = products.filter((p) => {
        const name = slug(p.name).replace(/[-\s]/g, "");

        return name.includes(search);
      });

      /* cliente final = chico */
      if (mode === "client") {
        return (
          allMatches.find((p) =>
            /250ml|200ml|150ml|125ml|100ml|80g|52g/i.test(p.name),
          ) || allMatches[0]
        );
      }

      /* salón = grande */
      return (
        allMatches.find((p) => /500ml|1000ml|750ml|500g/i.test(p.name)) ||
        allMatches[0]
      );
    };

    const add = (item, custom = "") => {
      if (!item) return;
      if (rec.find((x) => x.id === item.id)) return;

      rec.push({
        ...item,
        extra: custom || item.extra || "",
      });
    };

    /* ======================
   PERFIL CAPILAR
====================== */

    const wantsStraight = has("quiero_lacio");

    const keepShape = has("mantener_forma");

    const texturedHair = has("rizado") || has("ondulado") || has("afro");

    const hasAlaciado = has("alaciado");

    const hasTinte = has("tinte");

    const hasColor = has("diseno_color");

    const hasBleach = has("decoloracion_global");

    /* ======================
   FINALE-X
====================== */

    if (usesHeat && !keepShape && (wantsStraight || hasAlaciado)) {
      add(
        pick("Finale-X"),
        "Ayuda a mantener un acabado más lacio y controlado.",
      );
    }
    /* ======================
   CURLY
====================== */

    if (texturedHair && keepShape && !wantsStraight) {
      add(
        pick("Xtyling Curly"),
        "Ayuda a definir y mantener la forma natural.",
      );
    }

    /* ======================
   GOJI
====================== */

    if (hasTinte || hasColor || (hasAlaciado && !keepShape)) {
      add(
        pick("Shampoo Di Goji"),
        "Protección para cabello procesado químicamente.",
      );

      add(pick("Maschera Di Goji"), "Ayuda a mantener brillo y suavidad.");
    }

    /* ======================
   IALURONICO
====================== */

    if (hasBleach || has("quiebre") || has("elastico") || has("meta_reparar")) {
      add(pick("Shampoo Ialuronico"), "Reconstrucción e hidratación profunda.");

      add(
        pick("Maschera Ialuronico"),
        "Apoyo intensivo para fibra sensibilizada.",
      );
    }

    /* ======================
   HIDRATACION BASE
====================== */

    if (texturedHair && keepShape && !hasBleach && !wantsStraight) {
      add(pick("Shampoo Di Argan"));

      add(pick("Maschera Di Argan"));
    }

    /* ======================
   DEFAULT
====================== */

    if (rec.length < 2) {
      add(pick("Shampoo Di Argan"));

      add(pick("Maschera Di Argan"));
    }
    /* ======================
     CRECIMIENTO
  ====================== */

    if (has("caida") || has("meta_crecer")) {
      if (hasAlaciado) {
        add(pick("Lozione Abbondanza"));
      } else {
        add(pick("Shampoo Abbondanza"), "Usar 2 veces por semana.");
      }
    }

    /* ======================
     FRIZZ
  ====================== */

    if (has("meta_frizz")) {
      if (keepShape && texturedHair) {
        add(pick("Fluido Di Argan"));
      } else if (has("sincalor")) {
        add(pick("Fluido Di Argan"));
      } else {
        add(pick("Liss Di Lino"));
      }
    }

    /* ======================
     RIZOS
  ====================== */

    if (!wantsStraight && (has("meta_rizos") || (texturedHair && keepShape))) {
      add(pick("Xtyling Curly"));
    }

    /* ======================
   CALOR
====================== */

    if (usesHeat) {
      add(pick("Liquid Silk"));

      if (has("decoloracion_global") || has("quiebre")) {
        add(pick("Finale Ialuronico"));
      }
    } else {
      /* ======================
   REPARACION SIN CALOR
====================== */
      if (has("decoloracion_global") || has("quiebre")) {
        add(pick("Refill Ialuronico"));
      }
    }

    /* ======================
     ELASTICIDAD
  ====================== */

    if (has("elastico")) {
      add(pick("Pozione Booster"));
    }

    if (has("quiebre")) {
      add(pick("Refill Ialuronico"));
    }

    /* ======================
     LARGO
  ====================== */

    if (has("largo") || has("xlargo")) {
      add(pick("Bifasico"));
    }

    /* ======================
     LAVADO
  ====================== */

    if (has("lavadodiario")) {
      rec.forEach((x) => {
        if (x.type?.toLowerCase().includes("shampoo")) {
          x.extra = "Uso frecuente / apto para rutina constante.";
        }
      });
    }

    if (has("lavado1x")) {
      add(pick("Maschera"));
    }

    /* ======================
     MIN 4
  ====================== */

    const backup = [
      pick("Bifasico"),
      pick("Fluido"),
      pick("Ricostruttore"),
      pick("Pozione 10"),
    ];

    backup.forEach((x) => {
      if (rec.length < 4) add(x);
    });

    return rec.slice(0, 8);
  }

  function buildDiagnosisText() {
    const all = Object.values(answers).flat().map(slug);

    const has = (v) => all.includes(slug(v));

    const usesHeat = !has("sincalor");

    let health = 100;

    let damage = 0;
    let hydration = 100;
    let frizz = 0;
    let heatRisk = 0;
    let scalp = 100;

    const priorities = [];
    const reasons = [];
    const tips = [];
    const notes = [];

    if (has("decoloracion_global")) {
      damage += 28;
      hydration -= 20;
      frizz += 12;
      health -= 22;
      notes.push("procesos decolorantes previos");
    }

    if (has("tinte")) {
      damage += 10;
      hydration -= 6;
      health -= 8;
      notes.push("cabello procesado con color");
    }

    if (has("quiebre")) {
      damage += 22;
      hydration -= 10;
      health -= 18;
      notes.push("quiebre visible");
    }

    if (has("reseco")) {
      hydration -= 35;
      frizz += 15;
      notes.push("resequedad marcada");
    }

    if (has("frizz")) {
      frizz += 18;
      health -= 6;
      notes.push("cutícula abierta y frizz");
    }

    if (has("caloralto")) {
      heatRisk += 40;
      damage += 14;
      hydration -= 10;
      health -= 18;
    } else if (has("calormedio")) {
      heatRisk += 24;
      damage += 8;
      hydration -= 5;
      health -= 10;
    } else if (has("calorbajo")) {
      heatRisk += 10;
      damage += 3;
      health -= 3;
    }

    if (has("caida")) {
      scalp -= 14;
      health -= 10;
      notes.push("debilidad capilar");
    }

    if (
      !has("quiero_lacio") &&
      (has("rizado") || has("ondulado") || has("afro"))
    ) {
      hydration -= 4;
      frizz += 5;
      priorities.push("Definir forma natural");
    }

    damage = Math.min(100, damage);
    hydration = Math.max(0, hydration);
    frizz = Math.min(100, frizz);
    heatRisk = Math.min(100, heatRisk);
    scalp = Math.max(0, scalp);

    if (damage > 55) {
      priorities.push("Reconstruir fibra interna");
      reasons.push("Se detecta desgaste estructural");
      tips.push("Usa mascarilla 2 veces por semana");
    }

    if (hydration < 55) {
      priorities.push("Recuperar hidratación");
      reasons.push("El cabello necesita nutrición profunda");
      tips.push("Aplica leave-in en medios y puntas");
    }

    if (frizz > 45) {
      priorities.push("Controlar frizz");
      reasons.push("La cutícula necesita sellado");
      tips.push("Evita secado agresivo con toalla");
    }

    if (heatRisk > 40) {
      priorities.push("Proteger del calor");
      reasons.push("El uso térmico acelera daño acumulado");
      tips.push("Siempre usa protector térmico");
    }

    if (scalp < 70) {
      priorities.push("Fortalecer raíz");
      reasons.push("Señales de debilitamiento capilar");
      tips.push("Masajea cuero cabelludo 3 min diarios con Abbondanza ");
    }

    if (!usesHeat) {
      heatRisk = 0;
    }

    /* ======================
   NORMALIZAR
====================== */

    damage = Math.max(0, Math.min(100, damage));

    hydration = Math.max(0, Math.min(100, hydration));

    frizz = Math.max(0, Math.min(100, frizz));

    heatRisk = Math.max(0, Math.min(100, heatRisk));

    scalp = Math.max(0, Math.min(100, scalp));

    health = Math.round(
      (100 - damage) * 0.4 +
        hydration * 0.3 +
        (100 - frizz) * 0.15 +
        scalp * 0.15,
    );

    health = Math.max(35, Math.min(100, health));

    const finalPriorities = [...new Set(priorities)];

    const finalReasons = [...new Set(reasons)];

    const finalTips = [...new Set(tips)];

    if (!finalPriorities.length) {
      finalPriorities.push(
        "Mantener hidratación equilibrada",
        "Preservar brillo natural",
        "Prevenir daño futuro",
      );
    }

    if (!finalReasons.length) {
      finalReasons.push(
        "Tu cabello muestra buena condición general",
        "La rutina propuesta ayuda a conservar resultados",
        "La prevención mantiene salud capilar a largo plazo",
      );
    }

    if (!finalTips.length) {
      if (usesHeat) {
        finalTips.push("Usa protector térmico antes de calor");
      }

      finalTips.push(
        "Recorta puntas regularmente",
        "Aplica mascarilla semanalmente",
      );
    }

    health = Math.round(health);

    damage = Math.round(damage);

    hydration = Math.round(hydration);

    frizz = Math.round(frizz);

    heatRisk = Math.round(heatRisk);

    scalp = Math.round(scalp);

    return {
      summary: notes.length
        ? "Detectamos " + notes.slice(0, 3).join(", ") + "."
        : "Detectamos una base capilar saludable con mantenimiento recomendado.",

      health,
      damage,
      hydration,
      frizz,
      heatRisk,

      priorities: finalPriorities.slice(0, 4),
      reasons: finalReasons.slice(0, 4),
      tips: finalTips.slice(0, 3),
    };
  }

  function scoreColor(num, reverse = false) {
    let value = reverse ? 100 - num : num;

    if (value >= 75) {
      return "text-emerald-300";
    }

    if (value >= 50) {
      return "text-yellow-300";
    }

    return "text-rose-300";
  }

