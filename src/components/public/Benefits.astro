---
// src/components/public/Benefits.astro

import {
  Sparkles,
  ShieldCheck,
  Droplets,
  ScanSearch,
  ArrowRight,
  Star,
  BadgeCheck,
} from "lucide-react";
---

<section class="relative bg-black px-6 py-15 pt-15 overflow-hidden text-white">
  <!-- BACKGROUND -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="top-0 left-0 absolute bg-white/5 blur-3xl rounded-full w-96 h-96 glow-pulse"
    >
    </div>

    <div
      class="right-0 bottom-0 absolute bg-zinc-300/5 blur-3xl rounded-full w-md h-112"
    >
    </div>

    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,.05),transparent_35%)]"
    >
    </div>
  </div>

  <div class="z-10 relative mx-auto max-w-7xl">
    <!-- HEADER -->
    <div class="mx-auto max-w-4xl text-center">
      <div
        class="inline-flex items-center gap-2 bg-white/5 backdrop-blur-xl px-5 py-2 border border-white/10 rounded-full text-sm reveal"
      >
        <Sparkles size={16} />
        ¿Por qué elegir AVYNA?
      </div>

      <h2
        class="mt-6 font-medium text-4xl md:text-6xl tracking-tight delay-1 reveal"
      >
        Resultados visibles,
        <span class="block text-gray-400"> experiencia profesional </span>
      </h2>

      <p
        class="mx-auto mt-6 max-w-2xl text-white/50 text-lg leading-relaxed delay-2 reveal"
      >
        Cada línea AVYNA está diseñada para resolver necesidades reales:
        reparar, nutrir, proteger color, controlar frizz y elevar el brillo.
      </p>
    </div>
    <!-- BENEFITS -->
    <div class="space-y-10 mt-20">
      <!-- BLOCK 1 -->
      <div
        class="group relative bg-white/3 p-8 md:p-12 border border-white/10 rounded-[3rem] overflow-hidden"
      >
        <!-- glow -->
        <div
          class="top-0 right-0 absolute bg-white/5 blur-3xl rounded-full w-72 h-72"
        >
        </div>

        <div class="items-center gap-12 grid lg:grid-cols-2">
          <!-- LEFT -->
          <div>
            <div
              class="inline-flex items-center gap-2 bg-white/5 px-4 py-2 border border-white/10 rounded-full text-white/45 text-xs uppercase tracking-[0.25em]"
            >
              <Droplets size={14} />
              Hidratación profunda
            </div>

            <h3 class="mt-6 font-semibold text-4xl md:text-5xl leading-tight">
              Brillo, suavidad
              <span class="block text-zinc-400"> y nutrición visible </span>
            </h3>

            <p class="mt-6 max-w-xl text-white/60 text-lg leading-relaxed">
              Fórmulas enfocadas en elasticidad, hidratación y control de frizz
              para transformar la apariencia del cabello desde las primeras
              aplicaciones.
            </p>

            <div
              class="inline-flex items-center gap-2 bg-white/5 mt-8 px-4 py-2 border border-white/10 rounded-full text-white/70 text-sm"
            >
              <BadgeCheck size={15} />
              Ideal para resequedad y opacidad
            </div>
          </div>

          <!-- RIGHT -->
          <div class="relative flex justify-center items-center">
            <div class="absolute bg-white/10 blur-3xl rounded-full w-72 h-72">
            </div>

            <img
              src="/images/products/argan/argan-shampoo-1000ml.png"
              alt="AVYNA Hidratación"
              class="z-10 relative drop-shadow-[0_30px_60px_rgba(0,0,0,.55)] h-104ect-contain group-hover:scale-105 transition duration-700"
            />
          </div>
        </div>
      </div>

      <!-- BLOCK 2 -->
      <div
        class="group relative bg-white/3 p-8 md:p-12 border border-white/10 rounded-[3rem] overflow-hidden"
      >
        <!-- glow -->
        <div
          class="bottom-0 left-0 absolute bg-white/5 blur-3xl rounded-full w-72 h-72"
        >
        </div>

        <div class="items-center gap-12 grid lg:grid-cols-2">
          <!-- IMAGE -->
          <div
            class="relative flex justify-center items-center order-2 lg:order-1"
          >
            <div class="absolute bg-white/10 blur-3xl rounded-full w-72 h-72">
            </div>

            <img
              src="/images/products/ialuronico/ialu-ricostruttore.png"
              alt="AVYNA Repair"
              class="z-10 relative drop-shadow-[0_30px_60px_rgba(0,0,0,.55)] h-112 object-contain group-hover:scale-105 transition duration-700"
            />
          </div>

          <!-- TEXT -->
          <div class="order-1 lg:order-2">
            <div
              class="inline-flex items-center gap-2 bg-white/5 px-4 py-2 border border-white/10 rounded-full text-white/45 text-xs uppercase tracking-[0.25em]"
            >
              <ShieldCheck size={14} />
              Reparación profesional
            </div>

            <h3 class="mt-6 font-semibold text-4xl md:text-5xl leading-tight">
              Recupera fuerza,
              <span class="block text-zinc-400"> estructura y brillo </span>
            </h3>

            <p class="mt-6 max-w-xl text-white/60 text-lg leading-relaxed">
              Líneas diseñadas para cabello procesado, maltratado o
              sensibilizado por calor, decoloración y procesos químicos.
            </p>

            <div
              class="inline-flex items-center gap-2 bg-white/5 mt-8 px-4 py-2 border border-white/10 rounded-full text-white/70 text-sm"
            >
              <BadgeCheck size={15} />
              Fortalece y mejora la hebra
            </div>
          </div>
        </div>
      </div>

      <!-- BLOCK 3 -->
      <div
        class="group relative bg-white/3 p-8 md:p-12 border border-white/10 rounded-[3rem] overflow-hidden"
      >
        <div
          class="top-0 right-0 absolute bg-white/5 blur-3xl rounded-full w-72 h-72"
        >
        </div>

        <div class="items-center gap-12 grid lg:grid-cols-2">
          <!-- LEFT -->
          <div>
            <div
              class="inline-flex items-center gap-2 bg-white/5 px-4 py-2 border border-white/10 rounded-full text-white/45 text-xs uppercase tracking-[0.25em]"
            >
              <ScanSearch size={14} />
              Diagnóstico inteligente AVYNA
            </div>

            <h3 class="mt-6 font-semibold text-4xl md:text-5xl leading-tight">
              Descubre tu
              <span class="block text-zinc-400"> rutina ideal AVYNA </span>
            </h3>

            <p class="mt-6 max-w-xl text-white/60 text-lg leading-relaxed">
              Nuestro diagnóstico inteligente analiza necesidades, hábitos y
              objetivos para recomendar una rutina personalizada.
            </p>

            <a
              href="/diagnostic"
              class="inline-flex items-center gap-2 bg-white mt-8 px-7 rounded-full h-13 font-semibold text-black hover:scale-105 transition duration-300"
            >
              Hacer diagnóstico
              <ArrowRight size={16} />
            </a>
          </div>

          <!-- RIGHT -->
          <div class="relative flex justify-center items-center">
            <div class="absolute bg-white/10 blur-3xl rounded-full w-72 h-72">
            </div>

            <img
              src="/images/avyna/products-float.png"
              alt="AVYNA Smart Care"
              class="z-10 relative drop-shadow-[0_30px_60px_rgba(0,0,0,.55)] h-96 object-contain group-hover:scale-105 transition duration-700"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- TRUST STRIP -->
    <div
      class="gap-5 grid md:grid-cols-3 bg-white/3 backdrop-blur-xl mt-14 p-6 border border-white/10 rounded-4xl"
    >
      <div class="bg-white/2 p-5 rounded-3xl delay-1 reveal hover-lift">
        <div class="flex items-center gap-2 text-white/35">
          <Star size={15} />
          Ingredientes premium
        </div>

        <h4 class="mt-3 font-normal text-lg">
          Hecho en Italia, calidad garantizada
        </h4>
      </div>

      <div class="bg-white/2 p-5 rounded-3xl delay-2 reveal hover-lift">
        <div class="flex items-center gap-2 text-white/35">
          <Star size={15} />
          Compra segura
        </div>

        <h4 class="mt-3 font-normal text-lg">Salones autorizados por AVYNA</h4>
      </div>

      <div class="bg-white/2 p-5 rounded-3xl delay-3 reveal hover-lift">
        <div class="flex items-center gap-2 text-white/35">
          <Star size={15} />
          Asesoría real
        </div>

        <h4 class="mt-3 font-normal text-lg">
          Diagnóstico IA + expertos AVYNA
        </h4>
      </div>
    </div>
  </div>
</section>
